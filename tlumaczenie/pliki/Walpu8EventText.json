    "dataList[id=tutorial_mainui_walpu8_02_desc_01].content": {
      "pl": "Tutaj widnieje czas trwania wydarzenia 8. Nocy Walpurgii. W trakcie wydarzenia tocz walki na Poziomach Łatwym i Trudnym, wykonuj misje i odbieraj nagrody za ukończone misje.",
      "kr_sha256": "418c117adef13d81e07b7bdeb4f2dcbaae49694dbb7a444ccf291eee80519175",
      "en_sha256": "bcd709c10f83b84f75810b440ec3192280b38c131b47b3a0ac1582e49875197a",
      "origin": "ai"
    },
    "dataList[id=tutorial_mainui_walpu8_02_title_01].content": {
      "pl": "Czas trwania wydarzenia",
