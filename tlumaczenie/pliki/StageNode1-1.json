    "dataList[id=10105].title": {
      "pl": "Yuri",
      "kr_sha256": "4b585bc5692d408917f254dbf33a8234c51116377697bd327ca904bd78243c7c",
      "en_sha256": "5af45e38fe555dd5985c04274c00012c3e9ff3360b91ae06ff90bc7183b78144"
    },
    "dataList[id=10106].desc": {
      "pl": "Gościem okazała się Fikserka imieniem Yuri, która niegdyś pracowała w Lobotomy Corporation. Patrzyła spokojnie, jak autobus pożera trupy, jakby znała ten widok, więc musiała sporo przejść. I właśnie ta Yuri, zerknąwszy na mapę, nagle zaczęła nerwowo spoglądać w stronę fotela kierowcy…",
      "kr_sha256": "bb7d7d7179d9b12eeee22550eee28db809d9079646a3e261c6af932d43f4e950",
      "en_sha256": "350ebf38af9ea46251f434978ff0499e355dc6f74cf7261864589d0ca6992d99"
    },
    "dataList[id=10106].place": {
