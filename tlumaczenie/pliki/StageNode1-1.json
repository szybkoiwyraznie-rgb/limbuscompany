    "dataList[id=10106].title": {
      "pl": "Mapa",
      "kr_sha256": "82c5fe62d75b8c38b81015f927f9c24bcff8ca9c33cd1b63490651ff1b81f7d6",
      "en_sha256": "be176b0015c424b78e9f343f8bc3014a7a701cc2eb9000b6acbc04d67dbecb8f"
    },
    "dataList[id=10107].desc": {
      "pl": "Może i dobrze, że wyszło to już teraz… ale odkryliśmy wstrząsającą prawdę: Charon nie ma za grosz orientacji w terenie. Yuri nie mogła na to patrzeć i zakasała rękawy, oznajmiając, że nauczy Charon czytać mapę, a Sinclair, który też nie mógł na to patrzeć, jakoś sam się przyłączył. Trochę przy tym hałasu… ale miło popatrzeć.",
      "kr_sha256": "e857f6eb3c6771a7bb7583b9aad688683361d909052539f34271f07f1b482c10",
      "en_sha256": "1abb4f68bcd2e87d614cdca52e50e8f820665f61ac05de4c939a55fb618782a7"
    },
