    "dataList[id=10105].desc": {
      "pl": "Kiedy autobus mniej więcej skończył “posiłek”, Vergilius oznajmił, że zaraz zjawi się gość. Ciekawe, kto dołączy do tej niezbyt przyjemnej podróży.",
      "kr_sha256": "50e0c822bb74905e596f1d02a563a7f7e6c0e545ee068f9da70ca05bd2319cc9",
      "en_sha256": "39f5add62a00f4e365d54b7eb233bb3ae46c1a0ab7cb002564fee8a965cd3d87"
