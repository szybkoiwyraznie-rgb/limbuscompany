{
  "entries": {
    "dataList[id=10101].desc": {
      "pl": "W autobusie panuje atmosfera niezręczna, a zarazem groźna. Dostałem wprawdzie stanowisko “Kierownika”, ale nie mam pojęcia, co powinienem tu robić. Postanowiłem zapytać siedzącego naprzeciwko Grzesznika z robaczą ręką, dokąd jedziemy.",
      "kr_sha256": "8214addbdcd8561b365064d6593214a84fc610fc7bbb061dc1a07f235078bc9a",
      "en_sha256": "a4ad0de09e8084790528ff17429f571c79c58069d1841f642b8788fcb2950580"
    },
    "dataList[id=10101].place": {
      "pl": "Na pokładzie Mephistophelesa",
      "kr_sha256": "4d8e8db7ecbd1beffeef4944954c037245114de4988e89d756d7350fe56ca305",
      "en_sha256": "5a4a4efef2ba3deecd38e4297ae0f5b713a4fb30b4020a1adaf80dd54791b334"
    },
    "dataList[id=10101].title": {
      "pl": "Brum-brum",
