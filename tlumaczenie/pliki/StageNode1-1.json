      "en_sha256": "e688b50887f49bd3b5f8522e67eb36ee58c54079b5aa4d1ab2cd1d1d166c4da5"
    },
    "dataList[id=10102].desc": {
      "pl": "Po prośbie, która brzmiała jak groźba - cofnij zegar - przeszedłem pod rząd kilka męczarni gorszych od śmierci. W autobusie zrobiło się cicho, choć wcale nie przyjemnie, więc i ja postanowiłem trzymać język za zębami. Gdybyśmy tylko tak spokojnie dojechali do Dystryktu 4…",
      "kr_sha256": "660aa76a54803496c35b5ec2bef9c24836ae05c7e8554b58f042c2a39590e9fc",
      "en_sha256": "baf79b61e8f41606f900db0a1e669105fd39bc9f90a077a558c3e4f498d60594"
    },
    "dataList[id=10102].place": {
