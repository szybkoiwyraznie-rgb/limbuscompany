      "en_sha256": "02844d4e0a143b55645bf196013066df647d1a32410dacf36d6946b1c5de27aa",
      "origin": "ai"
    },
    "dataList[id=push_notification_message_full_stamina_1_text].content": {
      "pl": "Nie ma w tym nic osobliwego. Przybyłem jedynie powiadomić, iż Enkefalina wypełniła się po brzegi… To wszystko z mej strony.",
      "kr_sha256": "93ee2904ebb5ca5bc6755d0b682d82163d0e55e1b39aa5caf902af1c73c30871",
