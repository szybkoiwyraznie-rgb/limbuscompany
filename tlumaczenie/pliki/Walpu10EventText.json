      "en_sha256": "afdee1eab0f609faad615defea7b96c598ebdef14c1d83fb3375e2eae5b5301b",
      "origin": "ai"
    },
    "dataList[id=tutorial_mainui_walpu10_03_desc_02].content": {
      "pl": "Ukończenie walki na poziomie Łatwym odblokowuje walkę na poziomie Trudnym. Na poziomie Trudnym obowiązują obecne Poziomy Tożsamości, Stopnie Synchronizacji Tożsamości i Stopnie Splotu Nici E.G.O.",
      "kr_sha256": "d8be413b31b42f908ba2bacfd5c6ecbb71d5c42c5adaaea8f53686c7e070fd10",
