      "en_sha256": "09e7bd1d01441a5a4c9d36621058f740597660d5d3f3fed26d33288541610384"
    },
    "dataList[id=11].content": {
      "pl": "Masz dziurę w brzuchu na wylot, a tu ani umrzeć, ani nic, tylko cię wskrzeszają. Przecież to jeszcze gorsze, nie?",
      "kr_sha256": "28c666a569bd13d86370c231f60ad2e62c65412ed72c2982d5d6680f7fd70886",
      "en_sha256": "b26077c00183ea963bcdaf1f84795a7cd2dbf88346c9930ddb3aa1c200e9e9f0"
    },
    "dataList[id=12].content": {
      "pl": "Albo nie, dziura w brzuchu to akurat fart. Umierasz w parę sekund…",
      "kr_sha256": "be787dadbc9903f7338687857ae1b7e0445a7ac611647102a1bbb6101195e06d",
      "en_sha256": "98f2c39d8a74147118362500b8571522aa082d488f54aad9e6694bf0505b7f0d"
    },
    "dataList[id=13].content": {
      "pl": "<Hę…? Zaraz…!>",
      "kr_sha256": "4ed8a8b12fb8825cc9548f288ea1ce85eb15800672bc9f1da3eddc5f2aba89d9",
      "en_sha256": "1e99c49488d039d91e24fa6ad2e14ce5c2d0e80737a992c51b90a9c7f9f085a6"
    },
    "dataList[id=14].content": {
      "pl": "Och.",
      "kr_sha256": "df2132c55e071020e61238c28e57da03164d821b974da358cb7f6b6d12170127",
      "en_sha256": "62991c199e7fec0ffbd83281fe8a6242e522309d690b4898d85b2dfd787d995a"
    },
    "dataList[id=15].content": {
      "pl": "Wtem twarda macka wystrzeliła ze ściany i w okamgnieniu przebiła Ayi brzuch.",
      "kr_sha256": "aba17cd95fb7824ea1b2290c037b5e5e40d00fe2abe8d9edff2c260123da251d",
      "en_sha256": "6e94ce71346c112a872436937c5879f9def915952ab1d732d4e7fa010070e438"
    },
    "dataList[id=16].content": {
      "pl": "Wszyscy, gotowość bojowa.",
      "kr_sha256": "0951026fae011210badbec244b5b1eece694ea262b0296793741cb3b54783674",
      "en_sha256": "c270b5534477fe68ed979c263d983c4892fc3d0fd03838414c8144ab609b9acf"
    },
    "dataList[id=17].content": {
      "pl": "…A nie mówiłam?",
      "kr_sha256": "85fafbdd7a6ebee585c1ba07cd3269bbb77218840fc07d82a4a03295a1cfeb8a",
      "en_sha256": "b4fcb2d4c17084847ed508160a99284831fb1d2169c008e302d04dc2667fa042"
    },
    "dataList[id=18].content": {
      "pl": "Ja zawsze… miałam… szczęście…",
      "kr_sha256": "befc6de29c83c87d3f3a06ac3915e7f1e3bdfef65ca7dbc10afe0c16cf89345b",
      "en_sha256": "a6b1ff513bd3ebf2b66045fe98dd3863c8d5cdd964a08e306567003536cb0fd3"
    },
    "dataList[id=19].content": {
      "pl": "Pani Ayo!!",
      "kr_sha256": "bb456b6773167a399542c789a729fa309e2dddbaee8f67fad4b7d4de3345a5ac",
      "en_sha256": "4a024c0197ba2aca929802cb996edf46d07985b73cb00b6c6125bcd6c0d0e305"
    },
    "dataList[id=1].content": {
      "pl": "<Ja tu zaraz umrę…>",
      "kr_sha256": "d4017746de6c412f64db3637f8b06bcbdb292ebd4bee1951cb5ca9be5a8e89af",
      "en_sha256": "544831df5aef0c774bbc04eb60403bd498fbf9e41046037c4692d9f85c4aaa1f"
    },
    "dataList[id=20].content": {
      "pl": "Już skonała.",
      "kr_sha256": "7c72741fe28c905968377a7342153e5312fcefd5e33c32945d7418525cf3e1c5",
      "en_sha256": "594cd79148eb07378c3d21b0a41995db5c3bbd11f5557a593a295fe8200b89ab"
    },
    "dataList[id=21].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404"
    },
    "dataList[id=22].content": {
      "pl": "S-spokojnie… W-właśnie w takiej chwili trzeba trzymać nerwy na wodzy, nie?",
      "kr_sha256": "14a1cbe5b11bd64f0da6dc9100952d52789f664f432b115535ea29efd74a1417",
      "en_sha256": "2743b70ced98bdf226074ced73f94028cce8345d0efd768237dfb57fe2027610"
    },
    "dataList[id=23].content": {
      "pl": "A-ale…",
      "kr_sha256": "807a89ce00f22ca6334e863117550039b35da9e674cdcfb192f4ff30e1a4319b",
      "en_sha256": "9d43dce4d04fa99b8535c63e42c824878669698892e1fb37a53f7a990292950c"
    },
    "dataList[id=24].content": {
      "pl": "To nie jest zwyczajna forma ataku. Najpewniej mamy do czynienia z Anomalią.",
      "kr_sha256": "a1fdb96d2ac051a060fdaa1f0fa9a6d561a8f5f85ae7478dda7f1e49fc0693c0",
      "en_sha256": "dfbb8856932bb8bbaf66c8497335b650536db179f0a46ca831fa17ac53e5b912"
    },
    "dataList[id=25].content": {
      "pl": "Kierowniku. Proszę o rozkazy.",
      "kr_sha256": "68f3fb09f8bc4da0d851166e8e2e882a4c39a44affed84180137774a11cdca15",
      "en_sha256": "3f599c7144455b96fe7818c0cb1efc282d08bb87945bf7335374878ece029a6f"
    },
    "dataList[id=26].content": {
      "pl": "Yuri ze łzami w oczach patrzyła to na zwłoki Ayi, to na Grzeszników. Żal mi jej było, ale…",
      "kr_sha256": "0683d275ba45f46d44296350c9e140fa78844c100de866cbd93f21cda01c6370",
      "en_sha256": "48206467b7a8c47ebe5ed5b4609d9997a058b186c36971db7118839df04d5bf8"
    },
    "dataList[id=27].content": {
      "pl": "<…Yuri, Hopkinsa i Ayi nie mogę wskrzesić.>",
      "kr_sha256": "5dbcb0c55aec9813f477b482b461f63c3b16d630deb1d6c5693b9c67edd4f573",
      "en_sha256": "281451a8c0148f66ddbed5cfe794e425a6541c29812f73e63e546234b0fdcc63"
    },
    "dataList[id=28].content": {
      "pl": "<Jeśli nie chcemy kolejnych ofiar, musimy natychmiast szykować się do walki.>",
      "kr_sha256": "4f5bcbdc720669471cfa694b95b5aae33d2e97b47c91fabf036cfd57423393fc",
      "en_sha256": "7f3669a9c70bc28fc02a20b8db6041bd7f4e76143b21aeaa491cd6b7c4db7e50"
    },
    "dataList[id=29].content": {
      "pl": "Mądra decyzja, Kierowniku.",
      "kr_sha256": "ce914f2e3779c386ed2a13cf70fbec25c467ff2aec774cf92d39442c5bb0c9b7",
      "en_sha256": "96cf13bae6526f0bae846eefc8ebb8c93eb1fe9d56147a26a5629203e24aac5c"
    },
    "dataList[id=2].content": {
      "pl": "Ten zegar jest naprawdę niesamowity~ Takiej technologii w życiu nie widziałam.",
      "kr_sha256": "329b055e73d45c5d94f7b750d01086a92c01fbed46cd3ca8c8d9ddd4f3f2f585",
      "en_sha256": "7118e6ac669db43ad77f26921c4a2b047b8bf5d69349dfe81a05459effeacfd1"
    },
    "dataList[id=30].content": {
      "pl": "To tykanie da się zrozumieć…?",
      "kr_sha256": "927c4e3ef1d097f2fe75fd400af838d39041e5fe5fdbd87aaab23c7504498b31",
      "en_sha256": "8891801aac070fa5ad91650af6b8ad01f51abb2edcf0485b6846ff9c35b88863"
    },
    "dataList[id=31].content": {
      "pl": "Outis przeszyła Hopkinsa piorunującym spojrzeniem, ale zaraz chyba przypomniała sobie, co ważniejsze, bo nabrała tchu i krzyknęła:",
      "kr_sha256": "31b228dd7d0ecd7a97b46ea5bf9492d7716f16d09dc935bd78d635b09b57a3f5",
      "en_sha256": "1e2d5e3a759ebd9954ef6d8f80e851432944a9dde0e2ec615a9ea376073c9203"
    },
    "dataList[id=32].content": {
      "pl": "…Rozkaz Kierownika, szeregowcy!",
      "kr_sha256": "dd305f08551b41c9e5804a865076254537eb93ceafc4de5e144434944bd99fb4",
      "en_sha256": "afb6528073d1ec516169fc1a06a30eda94dc0e8342c8ea3099f20f960d906886"
    },
    "dataList[id=33].content": {
      "pl": "Formujemy okrążenie. Cel: OPZ na wprost!",
      "kr_sha256": "be35329a4bce848766d231f7a59da0d5dbcf81b97108f150c3dda61f359bbba0",
      "en_sha256": "c5598723dc7c03ab9fd35e7b3c56dcaa4c0b8cf2a2770575aafbc323c43955df"
    },
    "dataList[id=34].content": {
      "pl": "…Dobrze.",
      "kr_sha256": "f6d7ce3b9d88cdc6f9dc336ac821aea94886282176aeb5b17de11461d4ca684e",
      "en_sha256": "118272bcc047f87ef5fd410c01b9d32dde3873a8199a7bf7697797ce90b42f30"
    },
    "dataList[id=35].content": {
      "pl": "Tylko… czy to coś w ogóle można nazwać “osobą”, to jest pytanie.",
      "kr_sha256": "1c9c91c8d29eb37b40667d2f1331a58ac0499ed74e76b070a81a3cbb02505d78",
      "en_sha256": "e57a495ccf211bdf5c1e9eb2664eabe4ae556c4dcfc493f000c3d8534dd4a247"
    },
    "dataList[id=36].content": {
      "pl": "Powoli sunące pnącza i cień wielokrotnie większy od człowieka.",
      "kr_sha256": "a728b8119d04d3f2f6a4c1f114bd188c2b2f17e2ada9fc50850893570d2e4dc3",
      "en_sha256": "7b0c6ff3a025c00568f0e995a975b3b0a9653837f5bcd020eaabf13ba9d35697"
    },
    "dataList[id=37].content": {
      "pl": "To coś… nadciągało, niosąc grozę zupełnie innego rzędu niż wszyscy dotychczasowi wrogowie.",
      "kr_sha256": "d9217f56189e1b575806497244d63bc5107b76cd0aab44f13c30fc442cb1e397",
      "en_sha256": "22ae454c7abef216e3887296bebea882fc1f47a2d27844c8cccd0502ce67b838"
    },
    "dataList[id=3].content": {
      "pl": "To już p-poziom Osobliwości… Jakie Skrzydło może za tym stać…",
      "kr_sha256": "1d6636aee04cb2d55d030111aa41286f57aaad6ef3d55f3767c5a2cc0f20d91b",
      "en_sha256": "30991d192a3bc9054501a50bfe02feea8bed2eb1443862c355b7ea9c05ea8273"
    },
    "dataList[id=4].content": {
      "pl": "Hopkins wpatrywał się w moją głowę z chciwością.",
      "kr_sha256": "6cea7a5dc4cfd6e897f9c9691260296b878b105f447f925c7041c20571ebb07e",
      "en_sha256": "38d68d9417108ed9517e2c8434d4621cfd1fb77bd1f9b43f2ac527c2844bc8ff"
    },
    "dataList[id=5].content": {
      "pl": "Próbowałem nie zwracać na to uwagi, ale kiedy znów zobaczyłem jego wypchane kieszenie…",
      "kr_sha256": "743ee974572f18007d416806b27bb056e1d82d94ad2e5ec618f4483b5220196d",
      "en_sha256": "873fe2022896fb0c1151ad3d88f3b283c04a5f13dfc37774f7ea9c5c2fd694b9"
    },
    "dataList[id=6].content": {
      "pl": "Dante? Czemu trzymasz się za głowę?",
      "kr_sha256": "c35502362ce20c5b0a44f01c420e2a1163199638fb68869ae35e6a974d6bc9e6",
      "en_sha256": "42d1a254022caaf1c634fd771610c15ddaa15991dfb00ba019fd0397dc50eaae"
    },
    "dataList[id=7].content": {
      "pl": "<N-nic takiego.>",
      "kr_sha256": "d0ab1c4579ca61dee9bf34e79c5e4f00ef65d7b02a5cc27cebf76c38125835fb",
      "en_sha256": "53aa16e61e08062b608709665b830d0579ce2ebd836bb06f9e43e7ad1da05b33"
    },
    "dataList[id=8].content": {
      "pl": "Panno Faust, czyż zegar Kierownika nie zdoła przywrócić im życia?",
      "kr_sha256": "4757ad31ba4c017e1c2b14626ef084f20f69263c73e37f4132ef9be3768e8451",
      "en_sha256": "4aca8c95fc8ffa6a9736c0dfce5b90bb2ccb8731b6be1b22e1c6662d81e99b40"
    },
    "dataList[id=9].content": {
      "pl": "Zegar działa tylko na Grzeszników.",
      "kr_sha256": "1e90cbd392af91429b9db0beabd46440a2b0364f2ed64a59c0fcd9e6474dfec9",
      "en_sha256": "1347c22943d3ee816b025ead8f9161d970201469894e98841f51a8ff27ba64cc"
    }
  }
