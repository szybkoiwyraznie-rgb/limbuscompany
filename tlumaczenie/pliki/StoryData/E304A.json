      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=11].content": {
      "pl": "<Mamy dać komuś danie do degustacji, a sami go nie spróbowaliście?!>",
      "kr_sha256": "6aa9150fb884b6f0d8a1b3e05874522f30a4998a84bd2bae890d98962850d64c",
      "en_sha256": "47cc709ce1b7232bcf3cb2675476c7c0f59dc1dd3b4e578c6fdf95494f5125de"
    },
    "dataList[id=12].content": {
      "pl": "Mmmm… Zegarowy gnojek pierwszy raz od dawna gada z sensem. Kto spróbuje?",
      "kr_sha256": "95128bb02f099581daed031d1aee4110bc21eddda8afd520734ed7fe53b89a23",
      "en_sha256": "275f3e3de5cccc7e6b6b609845cfe0704996ac25fe4114337e2cc861b1f0b230"
    },
    "dataList[id=13].content": {
      "pl": "Zapanował nastrój bardziej zdeterminowany niż przed walką.",
      "kr_sha256": "ed57577c9e1ccd8a6d2fe0fad3d93f8c2354e0f69bcec78d4edf1e062c80a09e",
      "en_sha256": "ecb11aaf51eb976dad66a68192f9a3f5e44fd2be17ad4a5291443a97d8f3e2b9"
    },
    "dataList[id=14].content": {
      "pl": "…Nie patrzcie tak na mnie…",
      "kr_sha256": "9a0c496f43cc385ec7f0c29a60724951c8e0353835d4b7977e364c07c7c7a131",
      "en_sha256": "b41dd6d6c69842460d57156a7db7801f1c327bcde75b810aa3301f840b63bd1f"
    },
    "dataList[id=15].content": {
      "pl": "Ja jedna! Poświęcę się, byle jeno naprawić wypaczenie świata…!",
      "kr_sha256": "8fae920ca9f1c0beded9cf9e085379066501077d66bd4b0c12b144b908879906",
      "en_sha256": "374f738e62037b5b8b1eff92a67c482c6667066c59597bacdbbfadbf911c1a36"
    },
    "dataList[id=16].content": {
      "pl": "Don Quixote zacisnęła z determinacją powieki.",
      "kr_sha256": "fa23b5600cccdfc0bb7bbd4638f5e088cab9f45b6733e6f6204c4009653d3449",
      "en_sha256": "cf4174121326d6b4f9a4a763e08a19cea5b1b9565dac2005327527db5c8340ff"
    },
    "dataList[id=17].content": {
      "pl": "Cholera! Szlag mnie trafi, niech ktoś to wreszcie zje!",
      "kr_sha256": "5f06d0b8a9302bf865d4142dfd7f6843fc4afce84285e86bd8e1cc141715a2be",
      "en_sha256": "d18102a390d583e414ebb83dec64991d6877f066c965f7d74601269a30b288e0"
    },
    "dataList[id=18].content": {
      "pl": "Heathcliff złapał danie ręką i wepchnął komuś do ust.",
      "kr_sha256": "ad345082e55e2b0e628c47ac61c2db4791c01dec00053f5d7086d2f0b272680f",
      "en_sha256": "e87e24ffd9f13203e141d273f1bd42644463727d1efc400933dc36992747be49"
    },
    "dataList[id=19].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=1].content": {
      "pl": "Cóż to ma znaczyć! Nawet nie skosztował, a liczba spadła!",
      "kr_sha256": "bd2d9f215fc381f1d1123d3a648d7ca7b824d3fc8d9c269350e7b06ca74fda7b",
      "en_sha256": "43fd63370d4752ea6c730af96c81b39bdf81012938d13d7e863da50508ddff40"
    },
    "dataList[id=20].content": {
      "pl": "Meursault, którego to nagle spotkało, zastygł bez najmniejszego ruchu.",
      "kr_sha256": "f71d180db408cd8fc7a91e2a0b851be250ea4565ac48c3e7cefeacd9e63acb4e",
      "en_sha256": "ee5e1f027f2358aa27f24319d26fc1a8afe78f711e441f53744fae90bea181f4"
    },
    "dataList[id=21].content": {
      "pl": "<Nie umarł na stojąco?>",
      "kr_sha256": "ca8b32b8c8ed2deb61c63f3173952f38962652417c7eeda390eeb627d3068493",
      "en_sha256": "0c93c7db2f9075b0a7319d18d802f9920793b590becea11b7cf9029a4b4b20bd"
    },
    "dataList[id=22].content": {
      "pl": "Tym razem jam naprawdę nic nie uczyniła. Gdyby imć Vergilius zechciał szukać winnych…",
      "kr_sha256": "1363cb1af004bafdf27447d7c8284ddf0e7bafb6981988482fc520d2c372e66e",
      "en_sha256": "f98be82105fe77668d805f2cb427d47973878655152e4f38dd541cdf08b152e7"
    },
    "dataList[id=23].content": {
      "pl": "Bardzo powoli Meursault odwrócił głowę w stronę Heathcliffa.",
      "kr_sha256": "f56d75055b75754cefaa172cf9281b45d6b1bd3dea720770a6e75728cc1849dc",
      "en_sha256": "4998b898fd07e61d7dfb5f155929612179c799cc378c7a12545185203dbe9b59"
    },
    "dataList[id=24].content": {
      "pl": "Ogół…",
      "kr_sha256": "ed60b07ffbe32911f2b60b971b6908f7ae9601a94f0cf95d4133ae241a403840",
      "en_sha256": "31b1e8c26cffda753277aca28cdffb39b338e93c0e7e79ba3022c2d2804ed2e7"
    },
    "dataList[id=25].content": {
      "pl": "C… co?",
      "kr_sha256": "f97635f2746b135e856a1a93a0fcb3c675a64f03a42ae96e33a30e5450a9eb72",
      "en_sha256": "d54c2a8d22825a1a49eae966d69a483687cf4dcc2b1cbe47e266af8890b96741"
    },
    "dataList[id=26].content": {
      "pl": "Ogółem źle przyprawione kurczak niedopieczony więc nie udało się zabić zapachu surowizny i stęchlizny sos za gęsty przez co brak głębi smaku kurczak porąbany zbyt nierówno więc nie pobudza apetytu.",
      "kr_sha256": "e8ff16bfd159223c6ab5408d2fabdb719c52940ad0a1d458ae71882cfe5a2cca",
      "en_sha256": "087db62bac75a5324aa72fb9486f0505cff11b4433bf14b2bef4ca5c689c7814"
    },
    "dataList[id=27].content": {
      "pl": "Co… odbiło mu? To już wszystko?",
      "kr_sha256": "bacab997c2cf449e1ab0095da8cabc52c9ba9d5081c681a24c9770ea7348c2fe",
      "en_sha256": "5a7cd09f187d3eebe99476f95e2a65e829d16611fc42a355c8cffcc53066c7a4"
    },
    "dataList[id=28].content": {
      "pl": "Nie.",
      "kr_sha256": "f05525bb2385ed4397718fde4e64cfb5e0cd4a6ecaaf74e5f1f5f23fdf63599f",
      "en_sha256": "bfd0b2bc7f155b17b1aea7aad8053aa09db23339527041996d6dee69aba415d4"
    },
    "dataList[id=29].content": {
      "pl": "To nie koniec.",
      "kr_sha256": "9c8e14497733bea5f34d2a79e5bd537c5c8cb301d49882f281a9d24a54478158",
      "en_sha256": "6f035f0e565a14b6dcd3467a237be216527dde688076ed2799f09df8c6873a6b"
    },
    "dataList[id=2].content": {
      "pl": "<Mówi, że od samego słuchania, co mówicie, odechciało mu się jeść, więc to nawet nie jest warte oceny…>",
      "kr_sha256": "0b38c7f3245ab283ad17afcb67f9d0c8487bb2c8dc531646eb4f96adf790361b",
      "en_sha256": "df86d597b3fab1b596a8efdadcfeb5d3184d3d9d3140189d809608c1905ad4b4"
    },
    "dataList[id=30].content": {
      "pl": "Przyprawy w kompletnym nieładzie, w ustach pobojowisko jak po zagładzie. Cukru brak, więc dorzucasz masła dwie i pół łyżki, a moje usta nie zniosą tej mieszanki.",
      "kr_sha256": "956176ae062c75dd059f4ded991049862d4cd9e4f113dd7fc9ddc8db83879088",
      "en_sha256": "9092ef7d728761702c212747c791254dbc495ab9e2da417dd30acbae276fcce5"
    },
    "dataList[id=31].content": {
      "pl": "W… w… wybaczcie…",
      "kr_sha256": "50738274e7dccfd11ff8ae104566da963c85f20f3b646f4f6db8e4a1734aabed",
      "en_sha256": "3452d9550a2dfbd1a49ee37cbcc26dd2db43dea74a87cf4d9f50134c8aab7eae"
    },
    "dataList[id=32].content": {
      "pl": "Yi Sang, czy to imię tak cię zobowiązuje? Dziwne danie dziwnie gotujesz, zęby mi tym rujnujesz, z ideałem się rozmijasz. Moja wypowiedź na tym się kończy. To cały Yi Sang.",
      "kr_sha256": "12afccd95e74aa6e8821655efa45c0861380521fe91b657a73315137d2dd2aec",
      "en_sha256": "49b58622bd912d49886171ebdc9a3c128df300a30f848d381bc9c7702da4d4a1"
    },
    "dataList[id=33].content": {
      "pl": "…Nie mam nic na swoje usprawiedliwienie.",
      "kr_sha256": "4711a34b752f2120db578c034a56cbcd2ee5069a419b80bd08da515ca193a391",
      "en_sha256": "3e48e3dfe4a2416bb0aed8c292af4761e0e0071d923c7d43e860c2db21c4cdba"
    },
    "dataList[id=34].content": {
      "pl": "Zaraz, czy on… czy coś go nie opętało?",
      "kr_sha256": "46a341c90cecbf8570b9eb703f45a4ed242d4b0cb43ac341a6182d18157573fb",
      "en_sha256": "5a99d05693fab374b1289e5bf8259c1745ce1af63f7e9924ef1b89639229a094"
    },
    "dataList[id=35].content": {
      "pl": "Zwykli ludzie im bardziej szczegółowo mówię, tym mniej pojmują sedno.",
      "kr_sha256": "bf638f12681574bc5b0a50ee3b61ed65c740c3592c6c42dfb0994b7ab8950522",
      "en_sha256": "40955e890ba79dafe00212771afa8ac2ec9b956733af5846f7f3a16160ea0357"
    },
    "dataList[id=36].content": {
      "pl": "Dlatego do tej pory nie zadawałem sobie trudu, by mówić długo.",
      "kr_sha256": "1c6ff6a9c75c1a7c36c9a588abf0b478e110a5c5372a8e8d5f838796a10c50fa",
      "en_sha256": "cd8ffd437ee91440fa93af845c532b2a09fe57fc62943a749958946e36314551"
    },
    "dataList[id=37].content": {
      "pl": "A ponadto…",
      "kr_sha256": "f098bf054ea052b125b48dab1684066445a5e2dec3bfde57bf2f29f9ea6aca09",
      "en_sha256": "a0c44e11328e0ae4486d6d1e25935d16677abc56cb270f236381c902377b2cfa"
    },
    "dataList[id=38].content": {
      "pl": "To może tym razem ugotuje Meursault!",
      "kr_sha256": "c848c5d6d1ff8ca68cbf04a9ee45d75721deb8ea66ab7c02dd68fb2545e30dd1",
      "en_sha256": "135b74c8d97053cc5285b3d6ddc5a7ddfd9405b71797ede20bf96a5542b226e5"
    },
    "dataList[id=39].content": {
      "pl": "Zanim przyszła jego kolej, Hong Lu szybko klasnął w dłonie i zmienił temat.",
      "kr_sha256": "484422992b944f41e05a260bb34758f598180a30fe0156c65ba2069626a44f99",
      "en_sha256": "2d101a525990666044b604a416e1c302205be13c5a65845ad8b48544c6060276"
    },
    "dataList[id=3].content": {
      "pl": "Czy to tłumaczenie nie jest za długie jak na tyle sylab, ile wydusił z siebie właściciel?",
      "kr_sha256": "48cbcb0f2a3f7d57b8db9dd63be209c46774bbf8846bc5e4489b60a1f5c6053e",
      "en_sha256": "87c184f07649d0e23a00e66d97dcdea9ea9735bc144fdae1506e3d6d25221a45"
    },
    "dataList[id=40].content": {
      "pl": "Pomożemy, czym tylko się da!",
      "kr_sha256": "225c888518e8e1c58d9b830195cff4c1e5aba11266e957382affc980d9d22b41",
      "en_sha256": "79d1dd4329d23c6feeeff904b715dfbbb22eadead3cf4df7c1e7993c90e4f179"
    },
    "dataList[id=41].content": {
      "pl": "…Nie przepadam za pomocnikami.",
      "kr_sha256": "e751247e3b13a7e45bd06a1c3b5373d3d2df83eb8a44c68f332c60cddfa535cd",
      "en_sha256": "cb4d322557894d9b308ddeb4f5156411ae61bcf05c4ed9be1e7abe69df2789c3"
    },
    "dataList[id=42].content": {
      "pl": "Bez obaw! Nie zawiedziemy cię!",
      "kr_sha256": "2848afc713e3d295fd70cd1cac6f9744a4fa4ace0f10718ab37da28b7da5d4a1",
      "en_sha256": "5f60df6bc1f7eb8b3016e4af26f5b78e87638ea0b835ac7eb1598c3a0993767f"
    },
    "dataList[id=43].content": {
      "pl": "Don Quixote zakasała rękawy i zawołała raźno.",
      "kr_sha256": "b023cd12eafd9d08e17d8ebe45663e362a169362c6e6f0097f639dc01d91554a",
      "en_sha256": "4967934e6fd680da230c67ea6ab2032030e12493f6ee6c1f8c34f8705a4c7602"
    },
    "dataList[id=44].content": {
      "pl": "Hm… Gotowanie nie jest moją specjalnością, ale skoro tego chcecie, chętnie spróbuję.",
      "kr_sha256": "8c4788740b2c169cc227b79e34a22f6863e400d93236b94ebdc5a78955c2f307",
      "en_sha256": "4517bfc9709b3ab3321d466c4678675aa25852ee98c354a8ae91a469aba5f0d3"
    },
    "dataList[id=45].content": {
      "pl": "<T-to może zobaczymy, jak idzie drużynie Ryōshū?>",
      "kr_sha256": "21476ce418063240f1d7e318bdc49c6fa658fcabe915bca34ff041182f532a78",
      "en_sha256": "55440ebdfef044e04a562679bf3adcd02ac11cbcc803807b650557eca33b9f11"
    },
    "dataList[id=46].content": {
      "pl": "Podczas gdy w drużynie Gregora trwał ten występ, w drużynie Ryōshū atmosfera zrobiła się wyjątkowo napięta.",
      "kr_sha256": "86306083a1e20bda49288c677639258a20b0ad07bee861673475b55dba662058",
      "en_sha256": "f49933ec5dea377ce105b06f22338256d1c53cf3b51a11b4b3fa89728aac2048"
    },
    "dataList[id=47].content": {
      "pl": "A-ale…",
      "kr_sha256": "9236901633374393768fd9c0c873e8cbf3a5e31ceb838fe8cfe79a28c859a31e",
      "en_sha256": "8bd0151f5abbf1dc57441d741c0486606ee377c739deb2111947d740649c0d83"
    },
    "dataList[id=48].content": {
      "pl": "Jak niby mam zrobić coś, co ma być słone, a zarazem mdłe, nie za słodkie, a jednak słodkie, niezbyt wysmażone, a za to lekko przypalone?!",
      "kr_sha256": "37194d9fe9aac9d5f24dc885126da4d2d9feb0f67fbddb27686dda8fd11ada70",
      "en_sha256": "7a31ca2bc21dd85a6741bab65ef35eba835f8ff1892efefa614181c244db0777"
    },
    "dataList[id=49].content": {
      "pl": "Sinclair wrzasnął i ze złością cisnął fartuch, który miał na sobie.",
      "kr_sha256": "a064c59588dad1ee1dd530ad69f917e6d5548f17c43169689bb9bb3cae15e07b",
      "en_sha256": "8d914e6499c1e55f0eb3877c4972ba5a8b8811da6d717cf3bef15c948a92610b"
    },
    "dataList[id=4].content": {
      "pl": "Słusznie! Niechaj to odwoła!!",
      "kr_sha256": "c2ee172671993411d500db9b86977ae36cd5f6b9c40b863e6d214f1c44d44215",
      "en_sha256": "7ab46de90ea877140b414fd56a962901d7e33f3ba8f8e8b76fb32b29d3278eeb"
    },
    "dataList[id=50].content": {
      "pl": "Nie dam rady! Chyba rzeczywiście, jak mówiła pani Ishmael, łatwiej byłoby wygrać z panem Heathcliffem na rękę!",
      "kr_sha256": "1a9f046a6e5f2ca1f3f630029636a75ebcf60188dc0d2457de5a51d9e3ad02e7",
      "en_sha256": "7db66ebae0756ae30e6c834095de88a131475f0c49491b3a0d9c9ae6b804a878"
    },
    "dataList[id=51].content": {
      "pl": "T-to był tylko żart…",
      "kr_sha256": "727118223252255e6ca14896877984dafc4a3ca2f2c7061a4cc1ad14c39e1850",
      "en_sha256": "8ef4bf93cfef2b2511bca7a2bb36d49eb27db9181526fe17c81529ae2c43dc85"
    },
    "dataList[id=52].content": {
      "pl": "Gdyby to obliczyć statystycznie, jest to równie absurdalne, jak to, że pan Sinclair urośnie w tydzień o ponad 5 cm…",
      "kr_sha256": "858e229ced4795c78ba589411f8f328bdc1793f386513c02fa22f484f87f8cee",
      "en_sha256": "a73158db69ab3a12b86d22ee37e60071963dd3ff87fed3572dab8bda1cb51082"
    },
    "dataList[id=53].content": {
      "pl": "Proszę być cicho! Wszyscy jesteście tacy sami!!!",
      "kr_sha256": "f8fb9fcd99d81ac3808deb6bc3150bccef2fcc5127d1d7e17351b4889a6ca9ce",
      "en_sha256": "97f3f2dfdda43a9030ae13d6f88731e0d8522c0db4270fb0598da94407b9913e"
    },
    "dataList[id=54].content": {
      "pl": "Skomlisz po tak drobnych uwagach? Słabe i żałosne.",
      "kr_sha256": "fd51b11e9c2a9cf3b06b12eea3c9eb1515e493e474887cdaa170732a88847932",
      "en_sha256": "e31faebe3ec53e43118c5a2ea1d6af80bb0474de06fd3889eca43eb21c90b0a8"
    },
    "dataList[id=55].content": {
      "pl": "Skoro jest pani taka pewna siebie… może pani Outis sama spróbuje?",
      "kr_sha256": "d05a7f7239805e4716c3dd25d43236f36c0632a97fdd43f4d8339af4ab18b05a",
      "en_sha256": "34c99d714f4e027c595277e18d9fb66ae783cf22a0fcceb5bdecd2239f68da37"
    },
    "dataList[id=56].content": {
      "pl": "Jak na tak śmiałe słowa Sinclair mocno zacisnął oczy.",
      "kr_sha256": "d9e4296cc2d7bd924e07eea9496b91e44d45545157a9ce41f2e20515b0838ae5",
      "en_sha256": "6a7938b075d4c931d4f68d9ed81d49164e9207a241a848868b22e136152ce1f6"
    },
    "dataList[id=57].content": {
      "pl": "…Trudno.",
      "kr_sha256": "955363a3c456b89cb1aa8c7f7ac92c736188482ed28d7850c529317a96b77931",
      "en_sha256": "87a7bcb3d48d4923d84debc01bbf951efbb8eaab3a387ed0be2d900f61ae1f3a"
    },
    "dataList[id=58].content": {
      "pl": "Odstąpić, maruderzy. Koniec końców sama muszę się tym zająć.",
      "kr_sha256": "e7b8bae034622c48a7a573429012becd2a018ea6c2bf2159a5b42d1e84d1758b",
      "en_sha256": "aeefa0e060df04e92af3df26b65e7053737f3fb25e2a9de6c81db3ef30322896"
    },
    "dataList[id=59].content": {
      "pl": "Nie wiedzieć kiedy kucharska czapka, którą nosił Gregor, przeszła na Meursaulta.",
