{
  "entries": {
    "dataList[id=0].content": {
      "pl": "Ooo…? Hej, wszyscy! Pójdźcież tu i spójrzcie!",
      "kr_sha256": "184132cd0105b00592de397060cb18fc27dd1a8cac18202195d8e26f7fe223c1",
      "en_sha256": "9da9c92bd60bc8b49170432303208c93e89a8fc7ed10538c00ea111b19a55d72"
    },
    "dataList[id=10].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=11].content": {
      "pl": "Cóż… Skoro mam jeszcze w gratisie robić za przewodniczkę: to ukryta atrakcja tutejszych zaułków, o tak.",
      "kr_sha256": "57ab57c661f506d17cf285d8de7fcc480070e5f56d93b09025b1c3ae345c5464",
      "en_sha256": "09b302971d60c135c3c040a214138ab54b2b0198a6e78002e72c2cacc09b45ee"
    },
    "dataList[id=12].content": {
      "pl": "Ostatni przystanek hazardzistów.",
      "kr_sha256": "c63d54cc5c94108728fe3e6480917d1429d78e698e08f5a95a5a7778cd5af52b",
      "en_sha256": "aac98fe3357e75e40d327ef43cc13e4a11b2c428b2eaf37c3b5ed44b8df33014"
    },
    "dataList[id=13].content": {
      "pl": "A także trampolina, z której gang Tingtang wybił się na handlu używanymi autami.",
      "kr_sha256": "524a37c7005f79102d2500c45adcde5c0a066d54eb3054741185727242981067",
      "en_sha256": "ac26b03efca05fd334eb4c058efeb16594ef42ea49b77934f49f747a10105c4d"
    },
    "dataList[id=14].content": {
      "pl": "Rodia, podobno często bywałaś w takich miejscach? Nie masz nic do dodania? Coś mi się zdaje, że wyszłaby z tego ciekawa historia.",
      "kr_sha256": "de40fed9eec8b4a84262ccee1426a6b0bf8e5df81d035c2db8105d05805de9de",
      "en_sha256": "f459fa9ab8bd40b66a3e52824f707c42793f575c7d0d5785536ff0f168d4ff51"
    },
    "dataList[id=15].content": {
      "pl": "Aaa~ nie wiem, nie wiem. Nie pamiętam. Postanowiłam zapomnieć o przeszłości i patrzeć tylko przed siebie.",
      "kr_sha256": "3427ea13cbf23b2c59368a7a92815c56c69523a3e71f099f593270bc213f2069",
      "en_sha256": "1cfd45a113b79f2504197f0cc24411afcab8c66f571a526bb5a061295bee2f22"
    },
    "dataList[id=16].content": {
      "pl": "…I pewnie bym się tego trzymała, gdyby nie tacy natręci. Hmf.",
      "kr_sha256": "0eb897ba647829813d6df636bcbc85cef3e9e0d003b11a957f6e84c7fd26c771",
      "en_sha256": "1e1df368a74ba1cd551ab0b6d0874a42dfad09a590de0aedac448bbdf563fb22"
    },
    "dataList[id=17].content": {
      "pl": "Dzieciaczki! A wiecie wy, że łazicie po naszym terenie?",
      "kr_sha256": "e0d4e6a21f82f6549704461f7c5d7935089d8775a7b82c8850aa61b25a2a411f",
      "en_sha256": "c8ae655c3de76a403feddc678b9d23d3378de184d5faaa5cfeccbe9eaa1faaec"
    },
    "dataList[id=18].content": {
      "pl": "A może przyszliście sprzedać auto?",
      "kr_sha256": "7ad8532b0cd4b6c190bb11edbffad9d1efba87310dde51a8fae2838ce4cdbe20",
      "en_sha256": "3404f95d55656809101854f5f84b8349ee988d022a9f65016025efd791ef0771"
    },
    "dataList[id=19].content": {
      "pl": "Nie! My jeździmy autobusem!",
      "kr_sha256": "a1b7e9a299e4d8ef5181b1788302375d07d25e9b6c83ff44fb712468a8ba9f79",
      "en_sha256": "91d81956fe2fbdad16c1a950f726746ce35e0706dbe2643306c7a1d5ca005c32"
    },
    "dataList[id=1].content": {
      "pl": "…Co to wszystko jest?",
      "kr_sha256": "5ee749b694294285c77f2db62a6ab460405bacd060c1f07a3e35980dc1c506cb",
      "en_sha256": "4f484d30f504805503651c29fac64e223ba4ecc5ee1ebfe7a075f2bf167bb9f8"
    },
    "dataList[id=20].content": {
      "pl": "Organami to nie my handlujemy… Hmm, ale za oczy w tak rzadkim kolorze to by sporo dali…",
      "kr_sha256": "5b790a4cf6a4054e18b16e2398426c43bb8c24ab88c69bf4300842371316b1d8",
      "en_sha256": "c05bd8446c266f227762dd63afdb7981c75b3b19f2788ce58528c60b1dcc6283"
    },
    "dataList[id=21].content": {
      "pl": "A zatem trafiliśmy we właściwe miejsce! Przyszliśmy po twego wodza!",
      "kr_sha256": "6e7a36198e716702dd849250ff3a886658a78e1693db120001734f9e50855184",
      "en_sha256": "4107504df33ceafa1c9f612960f107eec7076ce1fa879e8d299a97605179be08"
    },
    "dataList[id=22].content": {
      "pl": "A skąd żeście tacy, że tak śmiało sobie poczynacie?",
      "kr_sha256": "17768f5da27c577923a36259376c83643763f716f3e3cc6d74c216389d2189e7",
      "en_sha256": "bdc728e69cc6964cdb02dcfcd994b435512c49de86af65bbce289236b9e266e9"
    },
    "dataList[id=23].content": {
      "pl": "Jesteśmy z Limbu…!",
      "kr_sha256": "d2983f1c583649d1f08289b323a54f5c99e245fb9dd7a882e95ca14a11f2ae71",
      "en_sha256": "e38144ef98ff6ad684e27d614c6ba532278c9f28b75face754372de3f99c3489"
    },
    "dataList[id=24].content": {
      "pl": "Ekhm…",
      "kr_sha256": "88d122f3eba2884b7843b2fb8211a909e3e4f21db9162cfac9ba9cbdb006c7d0",
      "en_sha256": "84046f1d2be4df1687746f93c3bba89939b34e1599b39765c9da07358c921f4f"
    },
    "dataList[id=25].content": {
      "pl": "Zapadła chwila niezręcznej ciszy.",
      "kr_sha256": "a00766af7dbe8616b71f2a8e7fc32eac9d77c9d3d1893c514c82893fc3bf3d28",
      "en_sha256": "bacbc3bcc37fc3391a75060aa6d345aada965b5be3952b4e3ac51467c5ccbd48"
    },
    "dataList[id=26].content": {
      "pl": "Pytam, skąd jesteście! Czemu nie kończysz?!",
      "kr_sha256": "d81b7af535d8846177938da50cfbefeac7f5187b8f6de7a26f08b4b9c934d218",
      "en_sha256": "101c3d11a03d6fca8dee8840220a168df7095dad40ddc269479030ddc720cfe1"
    },
    "dataList[id=2].content": {
      "pl": "Auta piętrzą się niczym wieże.",
      "kr_sha256": "1ca4c68ba1df58f1f4fd3e63f9ec9f23963efc583a45c3681e47f17cb0c4c186",
      "en_sha256": "835d560c834983a7bf3af08b2160794b0166571e3dcf7ee8c5fd987d96b81aac"
    },
    "dataList[id=3].content": {
      "pl": "Ponuro.",
      "kr_sha256": "79d4f6df629bc07efe9735ec03290c49d178f597a221fd6418d758807812dad3",
      "en_sha256": "64f3c5e552caca82dc2d7104f2dad645dea51bb5fa0ee271febff30ec691996c"
    },
    "dataList[id=4].content": {
      "pl": "Konstrukcje, które z daleka brałem za wieże, z bliska okazały się stosami samochodów, ułożonych jeden na drugim.",
      "kr_sha256": "724c9cd7b227bef968097a80baca38c1d90935de63bd15275f90c4ffd82668b5",
      "en_sha256": "e0fd254caa16f5299dc30fbb19b6f30b241baa351c6d47ed588e01abec2d0da1"
    },
    "dataList[id=5].content": {
      "pl": "Czemu tu jest aż tyle samochodów…?",
      "kr_sha256": "cd1ee91cf6ec5324cdb5f181d098345b4e0113ad01c864388999f725202bcebe",
      "en_sha256": "b578ba9969da9ad48a05ef0a772ca4d20d413d6d870d400be04f3da744a9640d"
    },
    "dataList[id=6].content": {
      "pl": "Och, na niektórych napisano listy! Pewnikiem od rodzin!",
      "kr_sha256": "a640b31fb61c5f538b2f69a04958c69c1cda897499a3ce1c401b075d9161415a",
      "en_sha256": "856b9f8741ffeedd28e34db5e8c19910f4d77f14a6b118872536ed27ddd5dcbd"
    },
    "dataList[id=7].content": {
      "pl": "Tu… napisano “Tęsknię”. Ci ludzie… pewnie niedługo po nie wrócą…?",
      "kr_sha256": "1480ad11e9ffac577a4bd2c31fd1f499e68e7c54f5d97399b4e567cceaa5fb1f",
      "en_sha256": "23443a9c45d89cec606b68d4ac0eed63eae03cc2d3f7bfb54c760f466a8c0dec"
    },
    "dataList[id=8].content": {
      "pl": "Akurat.",
      "kr_sha256": "ac89109aac3c6899bf8680ae5dc2365edc078fd60d3731b8420108047cf862f7",
      "en_sha256": "85d92a9f2d5f04e7bd6e2eaeb98df0459cdc9c969b6d62b439fd7f345565d60a"
    },
    "dataList[id=9].content": {
      "pl": "Nawet jeśli wrócili z kasyna, to raczej nie w takim stanie, żeby cało i zdrowo paść w ramiona rodziny~",
      "kr_sha256": "9081ae8e14abe36ac30e999ed7f818897fa908fbe81ecb42c2156d3547a088f1",
      "en_sha256": "011d41deb582178aa5a5503d10660cc93ce5d1e8fc8600bc3fcc3b9081243871"
    }
  }
