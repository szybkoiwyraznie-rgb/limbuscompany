{
  "entries": {
    "dataList[id=0].content": {
      "pl": "W końcu Guido runął z ciężkim łoskotem.",
      "kr_sha256": "746c90087c247369c7a7acdfc6dedb7b034f0c6f85665debbe2c35767d74146a",
      "en_sha256": "dbd31626dd02b375898a79478b41f9026fde6f07bc2a404082a7102447a1cb35"
    },
    "dataList[id=10].content": {
      "pl": "Sposób, by go otrzeźwić, jest prostszy, niźli się zdaje!",
      "kr_sha256": "4fc1019930d42953a7015e46f1192aa1f33ac4eca83a5e2e06f1b8fc9889704d",
      "en_sha256": "428191005562e5a4956253b026ffbfa16ee52353793278565e13f43c9336f74d"
    },
    "dataList[id=11].content": {
      "pl": "Wtem Don Quixote rzuciła się na Sinclaira i powaliła go na ziemię.",
      "kr_sha256": "884a9824aaef8719a37886d248f5672e563094d448b538f28f561fb095795362",
      "en_sha256": "6de93bcd0889a996c609f951d75d286aa1383559f68f80b9a50e9b36f73f56dd"
    },
    "dataList[id=12].content": {
      "pl": "A potem…",
      "kr_sha256": "4d0f12556d76169b0ce5924587756eecd0545762433e284828695c9acbf39e90",
      "en_sha256": "5fa1b60944e2fadffd54d40865b2fa0a4e46f293accd930091220929bd6101d5"
    },
    "dataList[id=13].content": {
      "pl": "I zaczęła okładać pięściami twarz leżącego.",
      "kr_sha256": "f75012c61a0912f349d80b19a5c567234840e1505f210913592e53a3ce17e3c4",
      "en_sha256": "168223fdc1bd5325fcc02837f179f295f83b07351a248dc05c25508871a8c8d8"
    },
    "dataList[id=14].content": {
      "pl": "Jeden cios to nie był koniec.",
      "kr_sha256": "46d6d6479eca92aa948d6beb9ccec0e3ffed1c15371440c1b8d54edff01b0598",
      "en_sha256": "427081c5ac64e3d2fe043a268f7700b60ac245ee235d4c1f40654aa559c45d7d"
    },
    "dataList[id=15].content": {
      "pl": "C-czy… nie powinniśmy ich rozdzielić?",
      "kr_sha256": "4408e73cf87ef213a6afc5bc1cc8cece267b7abd51e8820f23e85a5997817a88",
      "en_sha256": "4f7461c58529fc138c46949d3cecab28124acc674cb5c628d5d936e62bb09e57"
    },
    "dataList[id=16].content": {
      "pl": "Zostaw. Szczenięce przepychanki.",
      "kr_sha256": "794aa76b11c6b9ee58f6e4ff3bbccd618760267daedd6fab4422783fa2903b16",
      "en_sha256": "3b03b27567eca5172cf5287f57e71d80a644daab2a04d60753a9090e905fc75c"
    },
    "dataList[id=17].content": {
      "pl": "Wzbiła się dzika chmura kurzu…",
      "kr_sha256": "0ef3c28413c5d2b3a88d11e06503468afbb6247aaa4b387a24371e946febca49",
      "en_sha256": "d5e559ab623b7e09541d83de6b6f20c8fda3ef032ae2cdc4e2188c7d54b48f53"
    },
    "dataList[id=18].content": {
      "pl": "aż w końcu pięści Don Quixote znieruchomiały.",
      "kr_sha256": "8059cb9e190bb96cf504e32e91fd07b8d3bd7e6e356e0d761117bd6ff571e5c4",
      "en_sha256": "52ed79a8d40d21d7075a9e71a50df19469649c54bc05a2a8891d10c2f30b389e"
    },
    "dataList[id=19].content": {
      "pl": "I jakże, wróciłeś do zmysłów?",
      "kr_sha256": "bc80259e16141597a0a3020389581f510c82731c9ce36529323bc5f2130b76b3",
      "en_sha256": "3d9931750c71ef84303d2aacf7a43408230340049c8fb5bd80329d0c503252ed"
    },
    "dataList[id=1].content": {
      "pl": "Naszły mnie wątpliwości, czy naprawdę wyzionął ducha, ale nie mieliśmy już siły, żeby ściągać mu hełm i sprawdzać, czy oddycha.",
      "kr_sha256": "05273df420a24761a7e985f6a530cabce69da3f134e2f20f6be99a12c0b537af",
      "en_sha256": "7585a2858251004d05b225bbdbd6619fda1cded69a04a1711be30dd3b8153616"
    },
    "dataList[id=20].content": {
      "pl": "Ugh, ukh…",
      "kr_sha256": "0cc9bcc1d2ef4ab41d9208cec6d3d1134bb19f7acaea8d5f27a4ca2e6b1b0f53",
      "en_sha256": "9affab04a7b1d276f6db30db2d380d36e2d7469b765d2a2a578cbadc8bc59d7f"
    },
    "dataList[id=21].content": {
      "pl": "Wybacz. I mnie nieraz, gdy uniesienie owładnie ciałem, ponosiło jak konia, co zerwał się z uzdy.",
      "kr_sha256": "6ae7a570304b1c2efa2c001d7825c80acea752c122d1be9e2a37233002933263",
      "en_sha256": "d591803c242e61216c42d6da9cb9a552041c4976e886d1b57fa3555658830e19"
    },
    "dataList[id=22].content": {
      "pl": "Wtedy moi dawni druhowie tłukli mnie tak długo, aż oprzytomniałam.",
      "kr_sha256": "415dbddad805fed5ac4bb3d2d0c4b6def9592c17a18e2933378ea8a171d5d8bf",
      "en_sha256": "005805316c54dd8eaa09eb26b30440d5b6fe8bb73b00a62356bc202046cb8d63"
    },
    "dataList[id=23].content": {
      "pl": "Bywa, zdaje się, że jeno w ten sposób można wrócić do zmysłów.",
      "kr_sha256": "8a57b4c0403329c19b73ef5535f2b99d0c2e564952196d041176b0257424f74f",
      "en_sha256": "970bd92aa3dd5c9e53f8f3778279cc4ae105f2e689e119838174cedb3596a4e0"
    },
    "dataList[id=24].content": {
      "pl": "Aha, czyli z panem Vergiliusem też się przyjaźnisz, tak?",
      "kr_sha256": "bdbee7dd270c806be901bf60c2d62e6e226f9718db1758de7740d5cdb2b48827",
      "en_sha256": "45837c4c38e90e7713a8beb943ffb214a5314ccaff26dc49d0d085a739c2c082"
    },
    "dataList[id=25].content": {
      "pl": "Pfff…",
      "kr_sha256": "30450cb28d7f48ce8b6db3ac552f3c2f6fa7d37cbdba5b8451001f966b338937",
      "en_sha256": "93632c806022300c4277da48b2274fc8b9bd32b1619af12c525ab975c35661af"
    },
    "dataList[id=26].content": {
      "pl": "T-to jest…!",
      "kr_sha256": "7d7313e7f425e407fd3d9f5bc631862892f4c5426e948fd2a7a55de910995576",
      "en_sha256": "4e6c92b35ac6c19ff5b344a0dba387608eaf9c764dc781d87c8a43061acb4f06"
    },
    "dataList[id=27].content": {
      "pl": "Chlip… Chlip…",
      "kr_sha256": "29559ae58ba5bac861428f29f96dd15b55da801b6c4992047e9dd2401586560b",
      "en_sha256": "bf48113f1406e538bafff5fae34123be3f3d3bd4bfc0c73da76d19c09d080de7"
    },
    "dataList[id=28].content": {
      "pl": "Po zakrwawionej, posiniaczonej twarzy Sinclaira spływały kropla po kropli łzy.",
      "kr_sha256": "2eab911b920728dac5597dc2dca9ab0360a204b356c145e31efdbf5241d425d9",
      "en_sha256": "a1726e7740c555e5a34c0f206a89b5555b67fd6fba1d2bbf7f16cb0b6a60b113"
    },
    "dataList[id=29].content": {
      "pl": "Nie daruję jej…",
      "kr_sha256": "fcea1fc895f820e14cea7c6720b389764129931954dcf8234f851e95c1b65c3e",
      "en_sha256": "46fc7028bf2490f64c097d029879a1628dd5f0850e1a70a5a3f6302c5a639e48"
    },
    "dataList[id=2].content": {
      "pl": "Sinclair raz po raz dźgał włócznią zwłoki martwego już Inkwizytora.",
      "kr_sha256": "3a7432fb9b195982a94d3f1fe0778162489249b72985ce00111f14d373ac3508",
      "en_sha256": "6c8e64350cbcc42489fe1ea242f00f137ce5fd0762b8570923d08c001bc84c0e"
    },
    "dataList[id=30].content": {
      "pl": "Pójdę do domu… i tej suce… wbiję kołek…! A potem…",
      "kr_sha256": "c26765ca8648150fc2725658d2f82ce90d6720255654e20c56c3f3a442b3eb24",
      "en_sha256": "78f9dc97b2e3dc61f52ab1fc1095e4dbc97a220b56796d91764e02c78ff946d0"
    },
    "dataList[id=31].content": {
      "pl": "Reszta utonęła w szlochu i nie dało się zrozumieć słów.",
      "kr_sha256": "bcb9d16e8934da5f0e569bb493312f19727e1cd13e89c6d34da5d08361727b41",
      "en_sha256": "c457772bd5b029fb9936f82315e25f060da4b6f5ad2e3b40ed9bb168b6bf4fda"
    },
    "dataList[id=32].content": {
      "pl": "Sinclair długo jeszcze trząsł się od płaczu, aż w końcu chyba trochę się uspokoił; zakrył twarz dłonią i zaczął cicho mówić.",
      "kr_sha256": "92fd6eeb918627ffe5e7e75f3035f49351129d3cb82bbe5db5515550905e0b75",
      "en_sha256": "646176c80d5b1f53c9b061df619458ca64e41d527185a9a6b26bda021181c146"
    },
    "dataList[id=33].content": {
      "pl": "Ja… z dnia na dzień straciłem wszystko…",
      "kr_sha256": "28f9431ec16428602d53992c3e0f16261a511303bd9ec8192f97eebb111c402d",
      "en_sha256": "f89321a5cc37cbc7bc0cf7e468e93e43d97ceac38acad63199cb4e413acc2917"
    },
    "dataList[id=34].content": {
      "pl": "Wtedy… oni jeszcze nie występowali pod nazwą “Nagel und Hammer” i nie chodzili otwarcie takimi tłumami.",
      "kr_sha256": "16b4248ddaea07b7dc2f35c8938ff023ff2ff349ae838514c0b242e1c1423ec7",
      "en_sha256": "2c33a06e683363a29e4729b8c1d987faace1ad50578a6057f10b913fc65b03cd"
    },
    "dataList[id=35].content": {
      "pl": "Ale w którymś momencie…",
      "kr_sha256": "ac42413d76b75217f6299bc6afe3ac2a2d781f6290b625bdf558f1524e50dc9e",
      "en_sha256": "295cec9eb7f56a94335b0064ad70f910b41b4911326ac791a84da34414164110"
    },
    "dataList[id=36].content": {
      "pl": "do miasteczka zaczęli przybywać jeden po drugim ludzie, którzy nazywali siebie Młotami…",
      "kr_sha256": "5c542b4cb5a3c5dfe29f65ab28abef42f0c092c619ab8f6857cac263b6905119",
      "en_sha256": "f1ff31f331afe22e9446eb509e43949b97ff81499ea827f399dbff90ef7cead6"
    },
    "dataList[id=37].content": {
      "pl": "Ykh, ugh…",
      "kr_sha256": "f914e469f39f54a749d1effb3510d8db6ab35c4eb2e02b38329309bdd5c1a522",
      "en_sha256": "cdaf2d8d791fe7c7725db37331b8a0fb267226ac52553f602d47ad78aa46caba"
    },
    "dataList[id=38].content": {
      "pl": "Dobra, Młody. Wystarczy, już dobrze…",
      "kr_sha256": "c523736260cbcd43bf1f15f78b150384c41283c1896281abea55db0d6e95c360",
      "en_sha256": "ca6b296dd476a4810ed84d195a051afbc8cbe776d3b578bc89301fe73f19429d"
    },
    "dataList[id=39].content": {
      "pl": "Tylko Rodion w milczeniu poklepywała go po plecach.",
      "kr_sha256": "eda61a77738387e632c85ec62fcbdcf963b240fc0c3ce237f550ed3fb4ff4de9",
      "en_sha256": "b7105472e24db0d3b0e4eb54fcb63d2d2f7def08f1b75e51cc75330eb228ccc2"
    },
    "dataList[id=3].content": {
      "pl": "Trup był tak zmasakrowany, że trudno było rozpoznać kształt; wokół walała się krew i narządy rozgniecione na miazgę.",
      "kr_sha256": "121cb936d84e197f140973eef5004a6fae5d151e5f9600f7b2d55975b775bc9b",
      "en_sha256": "225e1dec51af72859689d51e05083c03d58d852b4af4457530ed83389c5b670e"
    },
    "dataList[id=40].content": {
      "pl": "Do dziś czasem myślę…",
      "kr_sha256": "1fe51da221df27385457ed0482eda6018c0b012149b775442c038d77f509944c",
      "en_sha256": "70a1f91b0e74fc42185af7b7fc2a4b81244aa10726ea3eead75fdc7f9786ae40"
    },
    "dataList[id=41].content": {
      "pl": "że może jeszcze się nie obudziłem ze złego snu…",
      "kr_sha256": "03730867ddc88be126b9e2e6e0b6ee0b33668732593f128b63451f853babdde4",
      "en_sha256": "72273ae061a998c903a9e092e007ba0fade1f87697e965567de213d4a5fe141b"
    },
    "dataList[id=42].content": {
      "pl": "Każdego ranka, kiedy się budzę, zanim otworzę oczy… zawsze…",
      "kr_sha256": "a73d5f494bedc8ec86b158f3ba284516459883167175183c42e283d3b0923a49",
      "en_sha256": "139ad9db2fa4f2d8e2f60606e59f3308089bdbdced667c6f7c4f8be225f40431"
    },
    "dataList[id=43].content": {
      "pl": "myślę, że może tym razem… zobaczę znajomy sufit naszego domu.",
      "kr_sha256": "4f2f6b050177a25b931d3e4f3a11108171874b47a406f61bada8c50d2e969c99",
      "en_sha256": "fa1af286a1c53631dd06f8f760e6b0d79f05e688a0cb8122f9e8fe6c00d77f77"
    },
    "dataList[id=44].content": {
      "pl": "Na tym skończył i płakał dalej, długo, bez końca.",
      "kr_sha256": "9a4057da6a15b61028595a3b3a4f9c0eb616241b29982fc012bb0b05eeb49575",
      "en_sha256": "8ed5d0d339cb8379926ef004524594a235bbbb2d703e9db54e416480bcbe62ee"
    },
    "dataList[id=45].content": {
      "pl": "Nie było żadnego powodu, żeby na niego nie zaczekać.",
      "kr_sha256": "989ec0ec043b68a7fad55b749c387b528ceb4e9accc899f960b4323106b45219",
      "en_sha256": "510e8e6606091b548d767a45cba4539a7bb035c21bdf0e94e25ae39ec7c2f313"
    },
    "dataList[id=4].content": {
      "pl": "Sinclair… uspokój się.",
      "kr_sha256": "fb46897107810fa52b06b04b6764505c78fcac094642ba141a2d5a4ef8795e37",
      "en_sha256": "8730493ebc6702396d66ef380c940d41ed7943b84b9c618ef7c8f991d822d64f"
    },
    "dataList[id=5].content": {
      "pl": "Zdawało się, że poza trupem przed sobą nic nie widzi i nie słyszy.",
      "kr_sha256": "aab6b1ab83b546c75da826f8656183c50aa4b96b500084f14d68536cc7ac44ab",
      "en_sha256": "fccaa639e51f96fcbda769767dd4024450bf65776ea6cc1d92bcd85f3a9efdcd"
    },
    "dataList[id=6].content": {
      "pl": "Słychać było tylko, jak co jakiś czas dyszy z wściekłości, a z tym dyszeniem mieszał się cichy szloch.",
      "kr_sha256": "f6d518e989a47f8474c73255eebe930a2fbc7e3e8b340bb022b15b82419126aa",
      "en_sha256": "a852abac389cdebab903d96aed69cc767eb4ac43b60c39aac34487dd551b57d2"
    },
    "dataList[id=7].content": {
      "pl": "Ja… wszystkich… pozabijam…",
      "kr_sha256": "81248dcd7bae0f71fcd175ad89c6e47d757816a5fd971a6e8aa41497c62767b0",
      "en_sha256": "1cb37887ef0fcb43a7f40765bf1b0eb28fdf263a4b8717ff967d3a678c19f626"
    },
    "dataList[id=8].content": {
      "pl": "Wiedzieliśmy, że trzeba go powstrzymać, ale nikt nie kwapił się, by podejść.",
      "kr_sha256": "c0395e622f2849f8f3b9c61879627584dc123c0a314dbd3c925258a7a1db22a5",
      "en_sha256": "a5a398d60d1ca3ceb778424c52f239e4cb3b3eca415d21f536443e17c65dc27d"
    },
    "dataList[id=9].content": {
      "pl": "Bo było widać, że jest zupełnie zaślepiony.",
      "kr_sha256": "caccb65bb74a375e6916648ab67a78b670ddb01b4df8ff6ddbe4e262726977cf",
      "en_sha256": "6f88c3838f399a96af5e49df762441893b936f1c9814862a299ab5d06ed39e52"
    }
  }
}
