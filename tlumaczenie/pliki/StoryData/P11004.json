{
  "entries": {
    "dataList[id=0].content": {
      "pl": "Mam to zrobić… ja?",
      "kr_sha256": "bbad0e5719d127fbcf129cc49350ff4f6ba2b3ab96c75639ddb2821223d97296",
      "en_sha256": "6c350958b31421a0271fc3d491eacfd82b327a5e5c0271bf44aa047c9e078970"
    },
    "dataList[id=10].content": {
      "pl": "Jasne, łeb wybuchnie.",
      "kr_sha256": "32803c616d775e3c7833b8b4b0d6162ea5da49a534fbb23a1205ab1d0b1a4af6",
      "en_sha256": "d74611a5c36e53e5cdb24a4d55b94bdd3ff80f1460e5c0a78f82c3684f264de9"
    },
    "dataList[id=11].content": {
      "pl": "No właśnie! - mówi dziecko niemal ze złością, ale pozostałe kręcą głowami i mówią zgodnym chórem:",
      "kr_sha256": "6019b87043a6f09c0479fa9dc4b71321e41703e53b5435eb689c46d48247f9e3",
      "en_sha256": "20f12c4e5f81429f7c4a4f6cde059f60ef7db990734cfffebab6bd1d2f64f74c"
    },
    "dataList[id=12].content": {
      "pl": "…Nam wszystkim kiedyś wybuchł.",
      "kr_sha256": "18a2c3ac9f49183e0bb7463529315408708ee0ad26bdb629857be8bcbbc433ff",
      "en_sha256": "4c393f482e97494f3919a7fbd3c768e25172a96f0273e5164020a26eccf33352"
    },
    "dataList[id=13].content": {
      "pl": "Słysząc to, dziecko westchnęło.",
      "kr_sha256": "0afd30d1ae7d14aa2e181df92275a904d184a9012297a5c8323273eeca6783a2",
      "en_sha256": "01ebfb5fde4524b375fd0eb06b05b248a884f509b40c069e6e3c3ab700c5d384"
    },
    "dataList[id=14].content": {
      "pl": "I… zrozumiało, że nie ma wyjścia.",
      "kr_sha256": "2af510baf841efb3efa4957495bff1a8984451cb83c4879011c40d27dcc27db3",
      "en_sha256": "6f8d4ea6e6695ee0156d012343f6ee0d67cfd8914dbd3123b9aff8d9bff346d6"
    },
    "dataList[id=15].content": {
      "pl": "Dziecko ostrożnie zwróciło się do tego, którego nazywano szefem:",
      "kr_sha256": "78c8e353a9f8ff7eca1816f8ebffac32476e867d2e63148573085deb7072c1fa",
      "en_sha256": "5228bc00703eedb65189378fabade39336be821eddc85c25786a26055ef0e404"
    },
    "dataList[id=16].content": {
      "pl": "S-szefie… może z-zrobimy imprezę z pi… piniatą-",
      "kr_sha256": "dfc4a95c70470d41b8968c4b3802dd8643bb6914a40f478c56ff1017fd97ff96",
      "en_sha256": "d737979cb54167931cc5f5af027e3bafdaecb8170beb638ea19c4d91347ff3a5"
    },
    "dataList[id=17].content": {
      "pl": "Nie zdążyło dokończyć.",
      "kr_sha256": "825d38f0cfa1b2e3f082ca335a1c1003045d4589f161d34b1412f2ae2c83f160",
      "en_sha256": "8ad17ba539f2c62b9aba46e2d36d185a1a72e68abf622252d23aa5c0a73182b7"
    },
    "dataList[id=18].content": {
      "pl": "Szaka.",
      "kr_sha256": "55d4f4521ef925b0c9bdb9ade6b2f53ab6fee268ff74d3d36e6a69fc1b7b5fc7",
      "en_sha256": "2af9742dfb555b30ccc89804c59276bc57117fe644520912ca595e1eee9c4039"
    },
    "dataList[id=19].content": {
      "pl": "Z głowy dziecka, które wypowiedziało słowo “piniata”, trysnęła fontanna krwi.",
      "kr_sha256": "74191e01e989088e7f7d0da1ca2d2e291328550c374a5ab2841563018cbe5fdd",
      "en_sha256": "c7a94925b6d3f567403bac3633d069c50f3b4ed8402a6f2ddf9b8d1ff4129dab"
    },
    "dataList[id=1].content": {
      "pl": "Źrenice dziecka zadrżały gwałtownie. Skóra pobladła, a elegancko wypielęgnowany wąsik zafalował.",
      "kr_sha256": "17899d8e3af0573a785d5b76647deca4e48ee4f12bdbd74c982e5c72f90bf2df",
      "en_sha256": "6626f7ffda0abd3ac5c6a184f5cd10f45bf5656543408b83d5e7fefb3ab075fa"
    },
    "dataList[id=20].content": {
      "pl": "Hm. Dobra robota, nowy.",
      "kr_sha256": "517a5429f5b92f968b8406089866eda6e299911bcd643da7ae7b50bb474cac8e",
      "en_sha256": "8085da2bc81aedd28fe6dda4dcd24572bcb6b17c04b598cb0311dd01c41c1d17"
    },
    "dataList[id=21].content": {
      "pl": "No, wreszcie szef… wszedł w tryb szefa.",
      "kr_sha256": "ea60e00bc4c1735c67af30cedb4c4f42f315b4955027fa9137f0d228ce044512",
      "en_sha256": "521d3fdef57528eceb05361146f9399763ffb68f52a209914f137b9e40cdd4fb"
    },
    "dataList[id=22].content": {
      "pl": "Szepczące między sobą dzieci z zadowoleniem patrzyły na leżącego i drapały się po głowach.",
      "kr_sha256": "01be2eff591478db89122ecf4bfa9139093c7cb21064600538b2b32150a94d7d",
      "en_sha256": "888cd70277b49287be0338c0ef74c6a4c8df5662eca8b200292fd9120f907199"
    },
    "dataList[id=23].content": {
      "pl": "Pewnie… każdemu przypomniały się dawne czasy.",
      "kr_sha256": "e5ec09063ed4467d5a3a8e9e1de8e8075dcc9531e56b9772ca3504d32f133f91",
      "en_sha256": "b340cab5525cb005305953752cb506ef3acb3feb5249921923fdf83bc0b7202f"
    },
    "dataList[id=2].content": {
      "pl": "Szef… się niepokoi. Trzeba mu poprawić humor, co, nowy?",
      "kr_sha256": "27b5308b52229e2806722f4d6f945feb3ebaf1cd6745ce3173987c47dc84b945",
      "en_sha256": "0896f3daa461949327ea96b657fab6e4d831d01e378a678f190732c70a0af91b"
    },
    "dataList[id=3].content": {
      "pl": "Inne dziecko łagodnym głosem uspokajało tamto.",
      "kr_sha256": "2fca3f03ade3a1b8c7eb38cd1da09c0eb9474bc8d105b1de131f3ceed563f0fd",
      "en_sha256": "ab2081b49db8f529d543cd8377e8cf103e9826961bf5f55720fbd03d707c5f1f"
    },
    "dataList[id=4].content": {
      "pl": "Wszystkie pozostałe dzieci patrzyły na to, które nazywano szefem, a które trzymało w dłoniach marakasy i trzęsło się jak osika.",
      "kr_sha256": "7324d12e3647840ff76c8dc7dd9c60670b64ab13d5b66d44a426b685cc622642",
      "en_sha256": "21a79f5c9ff87ad5c9308cc9868a3b27faeba975dc3874b202107eaf27794f6d"
    },
    "dataList[id=5].content": {
      "pl": "Słuchaj, nowy… to jest taki… rytuał przejścia.",
      "kr_sha256": "e4c47b585167abd342b6076bf1f07bb168a25fc73af74d96e37a63b72e9b594a",
      "en_sha256": "b6f7ec5a8c9106b096d27c6ceea4c7df8ed77476f618587c0b6d183c080c93e5"
    },
    "dataList[id=6].content": {
      "pl": "No właśnie. Dopiero jak raz… przez to przejdziesz, możesz się nazwać prawdziwym wodzirejem mariachi.",
      "kr_sha256": "70e0e6c0155bcf33f3f24af60a1acd44deadd47bc0c9f94b221e0f0d40e2a408",
      "en_sha256": "ca5fcb73078bd26f0682e9e25889ea9246dd5648e91c16ae8a42bbe2251eeafa"
    },
    "dataList[id=7].content": {
      "pl": "Twarz wskazanego dziecka zrobiła się już nie blada, ale niemal ołowiana.",
      "kr_sha256": "6ee867cd3cd6a892a14a91cc1ceb10ce17a0b144bd2d2fd1d2e47f7206856d6c",
      "en_sha256": "463bda24dcc5f96656c5808436c2cf8beea3e0346d688fff70d6b0a58a0e8af1"
    },
    "dataList[id=8].content": {
      "pl": "Ale… słyszałem. Jak się to powie szefowi Sinclairowi…",
      "kr_sha256": "82b2b1b3bf5310a5c9cbe830e0498071085438aaa00332017396cb5a668e283b",
      "en_sha256": "9394d4b4bfba151f1fc5f0e0f05f6b013ec532496cc457eb357cdb32c35d345a"
    },
    "dataList[id=9].content": {
      "pl": "No, łeb ci wybuchnie.",
      "kr_sha256": "d3248cb1e65106e963ce937e4dc0f545150b5ebe6a21b1f6fafa03705edbc546",
      "en_sha256": "2a79e008cdbc26d6a2dc7dc7407997310b4bf07779d7e5d8d2d9818fdddb7a40"
    }
  }
}
