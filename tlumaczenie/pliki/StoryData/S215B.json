    },
    "dataList[id=4].content": {
      "pl": "A ty co tak łypiesz? Zabierzesz no te gały? Ślepia jak u kundla…",
      "kr_sha256": "dc15943eceb5fd438d9f41cf8f1411a8e9ce244a2c2bbe0d5f8736a1553ce44c",
