{
  "entries": {
    "dataList[id=0].content": {
      "pl": "Zeszliśmy jeszcze jedno piętro niżej.",
      "kr_sha256": "130e027c161c112a38250fb830afd8f68c0fc2412885123ceaaa76a2d127431c",
      "en_sha256": "baf7017f35d69d547d5e007f0a82ecfbb17d8328de60d0cd0b1f7b12d502bd1c"
    },
    "dataList[id=10].content": {
      "pl": "Tak czy owak, na każdym piętrze jest co najmniej jeden główny przeciwnik.",
      "kr_sha256": "7c90c8f5954e15298942e98acb2d28628a4f19f34d5296913e664941d676538a",
      "en_sha256": "15e3839ccabde9064f6181e156b30d415ca0f098ab7894780d228e8e5aa78ed2"
    },
    "dataList[id=11].content": {
      "pl": "Nie ma głupszej rzeczy niż iść naprzód z wrogiem za plecami. Trzeba więc będzie oczyścić każde piętro z jego Anomalii…",
      "kr_sha256": "506c91d23e1b7534e7625ed3355da910a666d4905dc41fa6a8a08ea8758159e1",
      "en_sha256": "a7c4713072666682f7fc321df2483433835293152d1a78b22b94ad970f0cab72"
    },
    "dataList[id=12].content": {
      "pl": "Odebrała pani Faust słowa z ust.",
      "kr_sha256": "87d4948d7c8333d43c3dd34d6c73269037d02428bdc76c3b5e697e87b151b1b5",
      "en_sha256": "5fff8cfb51ad1ecc326d8bfb1eb68a3ad8768defa9fb3758dcab4f34e4d61d45"
    },
    "dataList[id=13].content": {
      "pl": "Czyż przekazać zamiar, nim padnie słowo, nie jest stanem idealnym?",
      "kr_sha256": "924d9170ed10205911b653bb6f633f7617f327ed0768d50129f68810483ff799",
      "en_sha256": "5feca9a86c47b9527d5dd4f370254dccb1d72cd3242674c21cc4610b87e284ec"
    },
    "dataList[id=14].content": {
      "pl": "…Dante, czas spojrzeć na gwiazdę.",
      "kr_sha256": "660cd53e279d6f8b00463ed72a9f67ea5dcdf5d72f37ed26f4e64f8c2d335a76",
      "en_sha256": "bb0babbb2f90cd7519cc6adccf0ac1687322e2462769aa6010a0ca0886f41ae1"
    },
    "dataList[id=15].content": {
      "pl": "<Coś za wygodnie się mną posługujecie…>",
      "kr_sha256": "dacab010b2bfffb0395b32ec2501c2b604e877cba73e76b88c2bccfc287366fd",
      "en_sha256": "adfc7e27c74ff74a4fa3435a15b2e9df407c40df33e2255017e274449b945a29"
    },
    "dataList[id=1].content": {
      "pl": "Nie sądziłam, że jeszcze tu wrócę.",
      "kr_sha256": "aa2369ec61414354aeaadef44e62d00790bd17cf451bece5bd236b852e0500fc",
      "en_sha256": "fbc2df48e9c2fbcf56c1715a10b18ca962b755c91f853ccacfc0d1b17581ee50"
    },
    "dataList[id=2].content": {
      "pl": "Filie Lobotomy zwykle mają po kilka pięter.",
      "kr_sha256": "43a70d452bd929e06be3ad4384dd1f658f6e2a93e2cdce6d12a7ed1a38855bec",
      "en_sha256": "7d14c54e497aa6312c0cc9088b79645c3c64170572b60cd55f84f841e9eb9b35"
    },
    "dataList[id=3].content": {
      "pl": "A na każdym piętrze powinna rządzić jakaś Anomalia.",
      "kr_sha256": "ddccafb1179a5ce01f7bde5f2fa4bdfd2acebe7aaa1c6f4d1911807a9970087e",
      "en_sha256": "270e556cae743f11d2b1e5c47742eda24d76c0c44d4711b0573cfb169c2ab2fd"
    },
    "dataList[id=4].content": {
      "pl": "Hę?! Czyli będzie więcej czegoś takiego jak tamto?",
      "kr_sha256": "b917b50312591ed0289ad1da333ecacb9a9d2d781d1c0a1a8affbe4ad17bbad0",
      "en_sha256": "db865726c5fc6309697f731e4c70f0b8a326e18f6fe3ed99fc6579ac41c74329"
    },
    "dataList[id=5].content": {
      "pl": "Skąd ty w ogóle… masz takie informacje? O tym, na co trafimy?",
      "kr_sha256": "42f97215d5020222efd1fede68331faf6e4d67530b6b7fad6e37bc6ac143098c",
      "en_sha256": "2c92eed1da1d6fe3ca231a55ba1b4d6bff6b1879e3da9c0e9086e6c863e5f60a"
    },
    "dataList[id=6].content": {
      "pl": "Faust wie wszystko.",
      "kr_sha256": "13e66e7b0756b5cb7b609f4c17fd68b78b600f5f0a20bdace4126f9edbc86361",
      "en_sha256": "b3764405925b786f34b8313fa67749436d0a2a0b50c8b09c9ca87c7dedb3e86c"
    },
    "dataList[id=7].content": {
      "pl": "Na szkoleniu mówili, że zespół Before robi wcześniej rozpoznanie.",
      "kr_sha256": "1fbe47beaf0bc5a2ca547b28a869d051deeffde98abb49ceb118f929ab6664e0",
      "en_sha256": "55c0e870ea8c8db3c4ce887b5a4b09db87ec46ccdbc8fdf0465c281db05e9b79"
    },
    "dataList[id=8].content": {
      "pl": "…Czyli wiesz to tylko dlatego, że masz swoje dojścia.",
      "kr_sha256": "5dfcf4648c057fd7eb45d3e6075559c4f758fcb896f0bb22b2c7883d0d553da2",
      "en_sha256": "f93c3f69120136dd2686d0bb086fa062b22ce17c8e56b118ee3743770ed16893"
    },
    "dataList[id=9].content": {
      "pl": "Faust nie powiedziała nic nieprawdziwego.",
      "kr_sha256": "5f6feb08209ede337802759a1a296b21e5518e279a8838eaa92361f6b2dafd62",
      "en_sha256": "fe9e8474a205efaf2436c0b88d3855d8768d6f991c28b838b97f3dcabccd9991"
    }
  }
}
