{
  "entries": {
    "dataList[id=0].content": {
      "pl": "Dziecko otaczało wielu ludzi w grubych, ciężkich zbrojach.",
      "kr_sha256": "0eaa7222d00706c85363f52e0af8e521c179e8a1a93b77b58db1a84704e6c94f",
      "en_sha256": "d0f420182ad62a8add65e95394185dabc8470c221861fe8037d6fe2e9cadabc9"
    },
    "dataList[id=10].content": {
      "pl": "A Wielki Młot…",
      "kr_sha256": "fc864063794756660cf577b801e17d845ad076cc5abecefd2cf3141aebe00045",
      "en_sha256": "a4d00486936c87ee2d843ea829321857392d49b8ec32b562c28b4a3f23dc4a22"
    },
    "dataList[id=11].content": {
      "pl": "Ja mam obowiązek sprawdzić wszystko do końca. Tak rozkazała Dzierżąca.",
      "kr_sha256": "a8a3853901bb2c2888a3a7ee20023a0da279eb4404c7170168396a9d0114c41f",
      "en_sha256": "d9d04e0b91135a1c7992ac90e62ae2ebd815eececf5316395a01f0e3ddfad0e4"
    },
    "dataList[id=12].content": {
      "pl": "Jeśli tak życzy sobie Dzierżąca.",
      "kr_sha256": "fd5c49107ec5d5181342e453f47a740114c16de296e48bb7de56f66c57cd4ce7",
      "en_sha256": "4f3809674c140d548cdab9e39ad23bc116564db7758273d2792546adf83fe6b0"
    },
    "dataList[id=13].content": {
      "pl": "Brzęk, brzęk.",
      "kr_sha256": "646261ff442ab503f631e97f83307661afec4c32401cb899387afaffa8529cd5",
      "en_sha256": "b51bb90b98b846f842286e241b2b1ba0a08f0e83c247d820db08828a571f733f"
    },
    "dataList[id=14].content": {
      "pl": "Pozostali odeszli i na korytarzu, który zmienił się w grządkę trupów, zostało tylko dziecko.",
      "kr_sha256": "865bb5fafaee3dd135c02ad14f4d9e6d675c2fedb5cdb77e72639de220429c8c",
      "en_sha256": "5c682e201b3f3d86cbb75c5da1ed5863834c579bad71ebcae8a281295241a1f9"
    },
    "dataList[id=15].content": {
      "pl": "Uff…",
      "kr_sha256": "771f35799c1662e8aebbdcad72eb8dae76afd87996d06c21c02752532f06871a",
      "en_sha256": "4c2e786f4279ccbf992f49c751beadee425e6722655d1b0ec0dedb0838b73f2f"
    },
    "dataList[id=16].content": {
      "pl": "Dziecko z grzechotem zdejmuje maskę.",
      "kr_sha256": "2180aa754ede1b15ecd8c3316546a69dd2db63d895a74d90dc71d14e345448c4",
      "en_sha256": "6789b060dc2c68929a48d80bb4c17eac6d8d5061f766622e447e4fa045943da0"
    },
    "dataList[id=17].content": {
      "pl": "Wtedy ukazało się to, co dotąd skrywało.",
      "kr_sha256": "5e928bc50ad617d4bb2f29ef5425e700ca5bb9b9e2b9539148c0daa503ecb9c5",
      "en_sha256": "a8f075d5b076d486059599a37783578407f71d98964b5a275a2ca0534dad2baf"
    },
    "dataList[id=18].content": {
      "pl": "Niewielkie urządzenie zakrywające usta i zielone rurki, groteskowo powbijane tu i ówdzie w skórę.",
      "kr_sha256": "fc278ab7ebc5efd9e5041bdc810435790e3ddd3ac6cdb33dd4ab555aeddf8f57",
      "en_sha256": "bb59731b1a1ec9f8431995a7189d945305416fa2c33b165782553424344507fc"
    },
    "dataList[id=19].content": {
      "pl": "No tak, to chyba sprzęt z K Corp.",
      "kr_sha256": "bed87b2c53d7284b779b6195e0ea99730677addd0ede279cb8a9d87920cffed9",
      "en_sha256": "3eba6970186380fb7c240497c9d5ce25755915e63d3342be8d996f5418d1fc0c"
    },
    "dataList[id=1].content": {
      "pl": "Każdy trzymał w jednej ręce gruby gwóźdź, a w drugiej młot tak ogromny, że aż człowiek się zastanawiał, czy da się go utrzymać jedną dłonią.",
      "kr_sha256": "53534ba75ae96bc1227146dd743a31a0b54f9d83582efd1ab4fcdd7e78a66975",
      "en_sha256": "5f6215d0033eea29d315e5b4d0922f32a75c22b5b7369d4265fc8482c990129d"
    },
    "dataList[id=20].content": {
      "pl": "Wiara… się wyczerpuje.",
      "kr_sha256": "d0344d193f61ea423d25108e1f143b71c90b411e1cdbc978bebbbe8e3a7b4107",
      "en_sha256": "4a3a89c81bd59c1586abe65c473b976cfc871971a8aba65980e07c5526c7d44c"
    },
    "dataList[id=21].content": {
      "pl": "Głos dziecka drży teraz znacznie mocniej. Ale nie ze strachu ani z przerażenia.",
      "kr_sha256": "a736c336714915a64b1659607335ac409fdf167b7f87af2cb1d6961922cc1686",
      "en_sha256": "6c8a0feab5f53fe5316f932bc61e131a5e02d06aac5950eb3c440f5fe347fa2a"
    },
    "dataList[id=22].content": {
      "pl": "To raczej wzbieranie, jakby coś uwięzionego szamotało się, chcąc wydostać się na powierzchnię.",
      "kr_sha256": "3b1dac6e397a2a5bd00ff57ea2eaa9a8a54c83c5089dd6bb0e936c9f49b5d09f",
      "en_sha256": "eef0e2acac225bc4873f42669cb2cf01aa710f440589d2aaeec3548ff3e359d9"
    },
    "dataList[id=23].content": {
      "pl": "Ugh!",
      "kr_sha256": "67882a619683b39e22fbf87c8d618188c9e7bcb5e6bcfa848a65849bb0d03f3e",
      "en_sha256": "3feb30875508ceead0ee8269376f719e911f8e1cce76db1f84bd0a0f338e95be"
    },
    "dataList[id=24].content": {
      "pl": "Szybko jednak drżenie ustaje.",
      "kr_sha256": "9ec0746e64108268c32b03a04d8bf7f8c1a37471e09917651fc5c550cb96338a",
      "en_sha256": "faa994597ac1a7f882b1fd1116508862817cae73d5ed2ab26f890a096939dce7"
    },
    "dataList[id=25].content": {
      "pl": "Pewnie dlatego, że dziecko pomajstrowało przy urządzeniu na ustach. Płyn z rurek w jednej chwili został wessany.",
      "kr_sha256": "96142f4544927dc908e2bd867dae3c443b2be85a9e664d9e6d035ebf1573d630",
      "en_sha256": "4a08d1919a81930207305f29c2e3f1e34f98071ee936734bcb002fdcf6c2ae32"
    },
    "dataList[id=26].content": {
      "pl": "Jestem… czystością…",
      "kr_sha256": "b907784532739a80611438267bf8ecdbb6bf4e42b535292a5c1d9e03ed13c79f",
      "en_sha256": "c3041c6fb7289b0fe4b78921dd08abb66198dd0c044babfc9e325993edb431cc"
    },
    "dataList[id=27].content": {
      "pl": "Brzęk, brzęk.",
      "kr_sha256": "646261ff442ab503f631e97f83307661afec4c32401cb899387afaffa8529cd5",
      "en_sha256": "b51bb90b98b846f842286e241b2b1ba0a08f0e83c247d820db08828a571f733f"
    },
    "dataList[id=28].content": {
      "pl": "Młotem… wiernym… Dzierżącej…",
      "kr_sha256": "dbeb4f87b45fc7c6920058052269f8971519c09ef4d7bf059b9bc868483cd183",
      "en_sha256": "4c49a3e3a415e1b3e394cb2d027c4a5c070d1ea8c6981f1c28948794b07eab15"
    },
    "dataList[id=29].content": {
      "pl": "Dziecko znów założyło maskę.",
      "kr_sha256": "379175da35c09fc6244730f3283d781b6ae1e06cbbffc4e270aee0a8e829b928",
      "en_sha256": "2c996ad3565a0d64fc2a2b3329a8a109f0bf7852f55ad39acbc7ec626ec4ad9b"
    },
    "dataList[id=2].content": {
      "pl": "O Wielki Młocie.",
      "kr_sha256": "f8b5694ea841c1f912a201c4f717847e901f200cc36032a1aa61a20baf6870e5",
      "en_sha256": "0662470bd243790181e65a45d75f0b7c267ada09c028ed339e85c81917111960"
    },
    "dataList[id=30].content": {
      "pl": "I mamrocząc tak, odeszło gdzieś przed siebie.",
      "kr_sha256": "664ae6413b5688c2d815685ecf44af44ceb75b08592b8a99ad0f1f406d92bed9",
      "en_sha256": "e472cf5de8f4aaeacbc414843d4b4783834d08cd30c81baa750aa5d535f51c7c"
    },
    "dataList[id=3].content": {
      "pl": "Jeden z nich wystąpił naprzód i zwrócił się do dziecka.",
      "kr_sha256": "851bd51c72e9d8be8d4a126f5228a48435d6d2b3c66ccf42dc44e5c28e93287f",
      "en_sha256": "9ddd41b1145a936858fbe22ce9ba1878563a30fcc393078849cdb2c9c48a56f3"
    },
    "dataList[id=4].content": {
      "pl": "W tym rejonie nie widać już cienia herezji.",
      "kr_sha256": "95a40cfb3df97e60b5a3da8b4814d361a614ef8ab204a3bb01674277425af99d",
      "en_sha256": "85700e756155da54c1c0bd516bcb55aa118abfd0e1a83bb667e1a08498d48f36"
    },
    "dataList[id=5].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=6].content": {
      "pl": "Dziecko, które nazwano Wielkim Młotem, cicho wypuściło powietrze. W tym oddechu było jakieś drżenie.",
      "kr_sha256": "0289cd8ec0b1a29cab9cf9fe5d822b924efc22d7d16310e8769d25cc1f373722",
      "en_sha256": "57bf2ed1d2730aeb3b7f87aff1f518c41da6916cf8b98a1237e84189b39a2b13"
    },
    "dataList[id=7].content": {
      "pl": "Wolno wam już wracać.",
      "kr_sha256": "886b72f6f17744a485c14d2ba4c8171332a6c047e90e565456c258d6b0311191",
      "en_sha256": "31c92d88cc9e32fb2095c6b3ad890e3c0723e33cb4f77adc5787c4f76fe87a09"
    },
    "dataList[id=8].content": {
      "pl": "Głos dziecka zawsze brzmi nisko i wyniośle.",
      "kr_sha256": "5bed0efc60142d58d8537887e135d7ba8313878bb50df59a25c971f6f57969db",
      "en_sha256": "183b5495ada8e89633ceca84fab2eb8de1878ce1032dde3e07ae524fb5da1230"
    },
    "dataList[id=9].content": {
      "pl": "A gdy odbił się od maski, którą zawsze nosiło na twarzy, rozbrzmiewał jeszcze bardziej świątobliwie.",
      "kr_sha256": "6e3d6afce49331923548645a0048e0c8968f72f0594fa8776a411734203d1774",
      "en_sha256": "a3f6ee0e50c730fda708c3f5df847547acf964fdb06bc6286b17f8140a7b6c74"
    }
  }
}
