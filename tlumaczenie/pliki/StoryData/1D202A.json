{
  "entries": {
    "dataList[id=0].content": {
      "pl": "Może zbyt wiele lat minęło, odkąd opuścił pole bitwy,",
      "kr_sha256": "db90d6dca807ab1e9268f31928e6980e6916e07091583544a2c97af5eff51334",
      "en_sha256": "f8b2a9826fa627524f327a56aef253b2d0880e80ad461dc7cf1e3a254411fcd8"
    },
    "dataList[id=10].content": {
      "pl": "Koniec końców… jesteśmy…",
      "kr_sha256": "66d5c7e4e9cd1c64ce10c372692684f97cc0df303551a598f039dbef6fbfced2",
      "en_sha256": "240ff162929db2396bbcb200184896e13e88b3c561f618a9a881b815311cc37a"
    },
    "dataList[id=11].content": {
      "pl": "tylko… obrzydliwym robactwem…",
      "kr_sha256": "76515ed69d29628ddd5e65abdc116273c92755d42dd349e4067294e43aa1c75f",
      "en_sha256": "67c63373dfdf7bc68154e0ad3272e7233f3141d563aa4c908942f4741b11700e"
    },
    "dataList[id=12].content": {
      "pl": "Potem wziął jeszcze kilka chrapliwych oddechów i znieruchomiał.",
      "kr_sha256": "1fd389062854114f17b1f2b87fbed6843ee8680e6bef946c8212e400e0b70777",
      "en_sha256": "a829151252290c4ae575e83ebaab618bab20ae3807e82697c6a84541ffce0d85"
    },
    "dataList[id=13].content": {
      "pl": "…Ej, pożyczysz papierosa?",
      "kr_sha256": "7bba4e9f2846a2ef02086f850b8700ac6cbbd12362a8cedc5d7df37239a4cf01",
      "en_sha256": "279ce5fde914fd075232fbf23b30010cc30d1b0f008d82e5484921a72dbc27b2"
    },
    "dataList[id=14].content": {
      "pl": "…Ten jeden raz.",
      "kr_sha256": "d6c2b9373b46d0101363c4a2f6b8ad0a394e5704dc82342be10060e3cadc7e5e",
      "en_sha256": "6a3d5f5a3d49d55919e24edcc98152988fa93156c0eb049022cba460c35564c9"
    },
    "dataList[id=15].content": {
      "pl": "Gregor wsunął do ust i swojego papierosa, i pożyczonego, zapalił ten pożyczony, po czym niedbale rzucił go na pierś zmarłego.",
      "kr_sha256": "bd7ffd9d095bb81f0ebde5a6049ba61e642d567bac2c4741e716ad2ab182cc6c",
      "en_sha256": "e7a8be422a86a3ecd9ee635c0c30a01bfb59825df13dd0c8fc1c3bedb2cf4478"
    },
    "dataList[id=16].content": {
      "pl": "Wybacz, ale nie chciałem dzielić się z nim własnym.",
      "kr_sha256": "9168f83f46a8e2ca6f12681bd5b53736bfab62a97acd4c43bbef8867f84b0754",
      "en_sha256": "db97e67e02c501defe8c5de61f36261208f42a0b391486fbd6bffd232dad6945"
    },
    "dataList[id=17].content": {
      "pl": "…Phi.",
      "kr_sha256": "df7fbe7bf5a2e8daa7b9198aa7b7646724cf189a072e043fe17dad63e913df2f",
      "en_sha256": "a89fee2042340f11731835fc3ae494d9dd069c076b471245901889e3e6a9c1bf"
    },
    "dataList[id=18].content": {
      "pl": "Prychnięcie Ryōshū, dym z papierosa Gregora i wszechogarniająca cisza. Tylko tyle zostało tam przez dłuższą chwilę.",
      "kr_sha256": "85ffa512e14353782efcd933aa9c3f756470700f2383322457ee8f5336969d25",
      "en_sha256": "622e3e01f0a332229225a638d9924035250d71cc713de2274aebf3148531b31f"
    },
    "dataList[id=1].content": {
      "pl": "bo dyrektor z G Corp., który w swoim czasie musiał posiekać niezliczonych wrogów, teraz dogorywał.",
      "kr_sha256": "f60fb57aecaa9f26ff4d365a64175b1eb36667db2f3fd79310c00985c5e6e92a",
      "en_sha256": "f6bdb59824fc7c9d13e7e133bb453fc612ca006d1d0acde19ef461687b49a2d2"
    },
    "dataList[id=2].content": {
      "pl": "Kiedyś niektórzy cię podziwiali, Gregor…",
      "kr_sha256": "4f2e4b7698b824d9b31244d1003b55d53edf74cf9d273263371071de23e3117c",
      "en_sha256": "781ffed867184eb1f9449a6917b2d1cd5464cecfc6df25d9429d483af6ae78d7"
    },
    "dataList[id=3].content": {
      "pl": "…Nikogo o to nie prosiłem.",
      "kr_sha256": "d97e842c456b8aec85285b875291b9c1c9416f8f59cf420d8dc085a9d0b45c55",
      "en_sha256": "39dcbc0ca649ffd9ddcf24d4fdfe74fb903536e9b732bdd266949149c049d048"
    },
    "dataList[id=4].content": {
      "pl": "Nie idź dalej… Tam jest piekło.",
      "kr_sha256": "bc482d0c77a148d91be63cf0f58f1f51cbcf7bc3b9233723996261e662bfd6f2",
      "en_sha256": "47452a510c8f3b4a765ac340c0e77d680aa4457d5a38d51afb789b77172d13d0"
    },
    "dataList[id=5].content": {
      "pl": "Przykro mi, ale to raczej odpada. Jak się nie przykładam do roboty, to mnie wyleją.",
      "kr_sha256": "57daec8e623e170d820a979ef700a121afbc56dea4a9c47ca87bc016d95eb89d",
      "en_sha256": "302929552ff95532471fea0f946ebeb8e41232c2d8eedad74c6bf4dfdce72f29"
    },
    "dataList[id=6].content": {
      "pl": "Sprzedałeś… nawet honor… za pieniądze?",
      "kr_sha256": "ac2ed6561c20911b1cfdfd081d11294edb0bd0eace9ee1b6e2e383a6af9c448d",
      "en_sha256": "7edbae0b9b05e6e438c1ef2f34747fe1b5270a35212d33c0bfd04bb128b272e7"
    },
    "dataList[id=7].content": {
      "pl": "Dawno temu, razem z medalem. Właściciel mieszkania naciskał o czynsz.",
      "kr_sha256": "6ebe17b1f6610a3d9e675649352f57d5cd1093ad6f5d4f71248739f30558e846",
      "en_sha256": "129ad56afc62c8d258e93bcfeaa29b78742c97827ed4ef5e8aba374135086efe"
    },
    "dataList[id=8].content": {
      "pl": "Na twarzy umierającego dyrektora pojawił się gorzki uśmiech.",
      "kr_sha256": "5507813b894536a3cf64df609f8a3a53401ee4561c3db91422ac5eb4769e5a73",
      "en_sha256": "1fa4641a1b54c2c1fcdcfe073fe445a473466cd659d3a967a2bbd87028283f65"
    },
    "dataList[id=9].content": {
      "pl": "Ty też… niczym się od nas nie różnisz…",
      "kr_sha256": "fecbf6872925b7ccb84194334c8e9771ac62f0207c9d7d395cd1a6ce4d0d8cf5",
      "en_sha256": "5db31aa71649d97f5baf2bd3950679d872d8fc20cfe56c0ca7897bd462c0359f"
    }
  }
}
