{
  "entries": {
    "dataList[id=0].content": {
      "pl": "Aaa!!! Nie!!!",
      "kr_sha256": "eb03261b55071f31e5ceedf50913b35add098fc99417b903664e4b0a0a08fad4",
      "en_sha256": "b954765b7d0f21bf357926b162ab5ea770d487cf69ac77d0be284f2164bd0529"
    },
    "dataList[id=10].content": {
      "pl": "…zaczął tańczyć. Wciąż szlochając…",
      "kr_sha256": "50adcc9046bbb9297b0bdc4d55399bf421c6e0789eb4664b13632a7586beabdf",
      "en_sha256": "33aec3dd5e0e0df9317932b7cc0d36ce3ae2df52d7299d7009eb9d11ae061a24"
    },
    "dataList[id=11].content": {
      "pl": "A to znowu co…?",
      "kr_sha256": "bd0c727cdc5b1634acf15850ea66df94cf43013cf1105c4590ddccc7a524517c",
      "en_sha256": "310dfb1214a6a9b6bce3e65dc7daccccaa50c0fa72d214599a6c777d0d6d01b9"
    },
    "dataList[id=12].content": {
      "pl": "Na poziomie, który trzyma nasza paczka, obowiązuje zasada, której trzeba bezwzględnie przestrzegać.",
      "kr_sha256": "54b8bf7f5f1c6439ca5ebcdb1ca64a827b13ff406c6794938baf4865a7312989",
      "en_sha256": "16307d70c982f1d02bf7f0537908acac594ae1e235637bfa448f42ee0e6ee33b"
    },
    "dataList[id=13].content": {
      "pl": "Hazard jest wyłącznie dla zabawy, dlatego każdy smutek i każdy ból trzeba wysublimować w taniec.",
      "kr_sha256": "79d79283b784c93b0a41bea279970b65d1bd822e3bf04b1cddf286581c8906fb",
      "en_sha256": "2fb884e0a4701c6e61708698ffc47d0c8da3846a0cd91f1f91d3ec88f972d0fc"
    },
    "dataList[id=14].content": {
      "pl": "Jeśli o taniec idzie, jam gotowa dać wam lekcję!",
      "kr_sha256": "195b93d94242093fe5a5d8c43499f18383544afdf84cdbd42f1c0496b21284d9",
      "en_sha256": "23420343bf14d41cf3e417e2c4631d985352e8092ac9ea2e892f7fa8967be010"
    },
    "dataList[id=15].content": {
      "pl": "Okazali się jednak surowsi, niż na to wyglądali.",
      "kr_sha256": "59a16276c6047eac23111563196cf2b13bfb86ef61b059317086ab6392229ac7",
      "en_sha256": "2d68af1e5e89d463edea626b99f828cc87ba067da7dbc68e5c3e3a01ce2d7139"
    },
    "dataList[id=16].content": {
      "pl": "Ta się nie nada.",
      "kr_sha256": "558a759c7c9d99df5ea1a2dab61f4b1e95cea69930bc6317548aaf1a1aa360a7",
      "en_sha256": "642ccb6c23b8b4be43566f967da21c570fee82c554e01ea0779ec554ed333112"
    },
    "dataList[id=17].content": {
      "pl": "W jej ruchach nie ma szczerości.",
      "kr_sha256": "1a64705cd761595e743cb779bc5e6fb3d9ce1042ae407f134f8b0cdaa8bc5421",
      "en_sha256": "ee3df9df59424ea3fada2567cae89a8dd0c93f34f98ef940404b6736b59218ea"
    },
    "dataList[id=18].content": {
      "pl": "Cóż to ma znaczyć?!",
      "kr_sha256": "f27970224dda01083076460191ec10f823b91594465c7512320178717e8c10fc",
      "en_sha256": "cbf4fe6eadb1bb0ab631e0374f8aae0e08e29f84aaef2b709819e0b3c9656b28"
    },
    "dataList[id=19].content": {
      "pl": "Taniec to okno duszy.",
      "kr_sha256": "e1fcb9729910160717b3055b50a1e1821af9c8bb5275ea10d9306c74d995757c",
      "en_sha256": "ce6bdab547a3b940821c6f4741112187d96ca493254694c784b115a2029eeb49"
    },
    "dataList[id=1].content": {
      "pl": "Znowu wszystko poszło, cholera! Który to już raz?",
      "kr_sha256": "0cadbdc3ddd0762903929b03bc209ad96f5d176a55a83c77465128175c79ea39",
      "en_sha256": "32f03a6b9f6271a2f0022d47e1796e79846e9fda80e8a8cd50e638b4cab7f69f"
    },
    "dataList[id=20].content": {
      "pl": "Bez czystego, przejrzystego serca nic nie traci sensu tak jak taniec.",
      "kr_sha256": "91cc36f8dfac58aa1feec8733ab85a62ce2e6d8f9c82e00c649953664bf8e10f",
      "en_sha256": "d8f3db43eb63a28dcab209187513b00d39f9cf17fa6dafcbcebd9236d169bfa2"
    },
    "dataList[id=21].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=22].content": {
      "pl": "…Wyście, zaiste, nieco nieokrzesani.",
      "kr_sha256": "7d68d666146e051d8265deaf9ffdf178a5fe2eafad2e0cddc73cb633e38a037a",
      "en_sha256": "a5de569482de833926282038fa916c5d9d26f714a46beece50804dc71acd506c"
    },
    "dataList[id=23].content": {
      "pl": "Coraz trudniej będzie to odkręcić… Co ty robisz, Saude?",
      "kr_sha256": "c73b73d2419c3a56597417c4552b9da6271d24a728a11052eabeffd4489a6123",
      "en_sha256": "aebb1b7f1ee0654b63f7dc45707ab0c6681063739f6bd5a6ffe196459739e4d3"
    },
    "dataList[id=24].content": {
      "pl": "Ach, piszę już zawczasu notatkę wyjaśniającą, ot co.",
      "kr_sha256": "683697761a8bfabfa18d250d6eeb0616d834d2a644733a051b40021c141eb60b",
      "en_sha256": "583c5d5b155be7f17bdf9051c25389857b670530d68a819bb25744bb49311e54"
    },
    "dataList[id=2].content": {
      "pl": "Hej, hej, chwila przerwy! Trzeba się zająć klientem!",
      "kr_sha256": "f3db299b8bdc84acfdf19ceff7fcf7bd56e9aea32336990eb17660c747cf328c",
      "en_sha256": "a169a1108a03ffb5cc67c66ca220b39c963cf60a96286e5a5f00308c5a76f376"
    },
    "dataList[id=3].content": {
      "pl": "Drogi gościu, nie zapomnieliśmy chyba o zasadach?",
      "kr_sha256": "d8d90a832ff159652253f69871a5f26c372f329173dc1ff2cf8a2d65e59af90a",
      "en_sha256": "6da3f956270300a0f665821a4034c468708bf294b44f4c93fcc3e9a00648fd61"
    },
    "dataList[id=4].content": {
      "pl": "A-ale… to były wszystkie moje oszczędności…",
      "kr_sha256": "340d080d044024275e58adb7b4cf32a36b473ce1d7e009d2b3e9d52322602213",
      "en_sha256": "af4e8430b5869b1a38669e2003070cd9ec9929347a256f3a822cd2f0b09f1025"
    },
    "dataList[id=5].content": {
      "pl": "Jeśli dalej będziemy psuć nastrój, możemy urządzić imprezę z gościem w roli piniaty.",
      "kr_sha256": "31480ecd23c079a4816288a730413b98dfbe5ed3b9f339f4055713b1f207e2bc",
      "en_sha256": "b89d15d55b38e2b78b3c8332f306e941995368b7be0c1a95b3f364cb8b0a226c"
    },
    "dataList[id=6].content": {
      "pl": "(Ej, a co to za impreza z piniatą?)",
      "kr_sha256": "0d742f94f6671db4b2be0a7727b28df5d2b04b1428121ec27eba60307d6b654a",
      "en_sha256": "07a96362b04f743ae51c8e4aaa7d8e5f05c65ef8f872a8306a4dc5621ef27b06"
    },
    "dataList[id=7].content": {
      "pl": "<Nie wiem i nie chcę wiedzieć…>",
      "kr_sha256": "20723aa4bc974881b1f832b4295e39c1b1b2981ad0bd5e12029038c44362cc0b",
      "en_sha256": "16a636587e370bdc6d5990ce867b69ef430f906b89b073f661ac252395be00af"
    },
    "dataList[id=8].content": {
      "pl": "Szlochający gość, któremu ta uprzejma groźba napędziła widać niemało strachu, wstał od stołu.",
      "kr_sha256": "8c59af7eb7cd52ae437c13d103707fa166a1f0b0d34da80385fb070b3f84474f",
      "en_sha256": "d238533b6c0cb71b4021c10f9366664e9cc76a52d74cc10c2a9a03492e456a08"
    },
    "dataList[id=9].content": {
      "pl": "Wziął od pracownika marakasy i…",
      "kr_sha256": "a46ad3eefb68fb531603c9d652d783854c990a00dd7cbd84b9d20f3ab0860693",
      "en_sha256": "55dc24253e7f49ca680c2be60c56e70a54c266f36d66d8923227b1b68d389bd8"
    }
  }
}
