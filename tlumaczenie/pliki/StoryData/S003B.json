{
  "entries": {
    "dataList[id=0].content": {
      "pl": "Już lepiej, Dante. Bardziej się pan nadaje niż przedtem.",
      "kr_sha256": "6c66814ca36a66bf9ee8b0b01cae14354a9d6b46dceb8c242e47cda9b8bf888a",
      "en_sha256": "eeeeda083f1679a979ef51bc839dbcaaac68315c05f4be5e858127de2bb657fd"
    },
    "dataList[id=1].content": {
      "pl": "<Ale wszyscy poza jednym uciekli. Nie trzeba ich gonić?>",
      "kr_sha256": "2c901aa0b050197c66aa870c9a62a08ed2c135a63d42db6a086ecbba53c1f253",
      "en_sha256": "0946c889327087027c31b1ebf76476c11e7bdc22f5b558734079f7175f782b26"
    },
    "dataList[id=2].content": {
      "pl": "Martwi się o wrogów, którzy umknęli.",
      "kr_sha256": "a64366ed00aba8b67854043a176c3719f012bc9f341c27e6b8fbfb93f2702540",
      "en_sha256": "e3f371e1f84520feca174c6d8bd2c382c56321b116ca64d04f6f6f2152b5df42"
    },
    "dataList[id=3].content": {
      "pl": "Nie ma powodu… I tak tamtędy jedziemy. Charon?",
      "kr_sha256": "9e89e7dae86c328956e5a37d15b36811557fc63a60628e92e58ca6ec194138ea",
      "en_sha256": "0864ad7c637b2e5287c6a6fa0fd93df92d39abb47c54c9300027148f92f21582"
    },
    "dataList[id=4].content": {
      "pl": "Gaz w podłogę, wcisk-wcisk. Jadę wesoło.",
      "kr_sha256": "33616feda6813da172f254b6121372ed2811e0a0630121a5ad15ff5d28923cb0",
      "en_sha256": "91dfe514fe72ddd8a1f62fcc305818d75df8f72de58432557d9e064936a78af8"
    }
  }
}
