{
  "entries": {
    "dataList[id=0].content": {
      "pl": "Kiedy się ocknąłem, byłem pośrodku uliczki rozgrzanej w samo południe palącym słońcem.",
      "kr_sha256": "4d4f3ae1d1d274bf2ac904c6b7782441397a8319e592053f9041ece2f263eb65",
      "en_sha256": "a41cf91499f748b751898736ce84ebf1d2a4057f7d6b5a6ed82a24e80e2aeb91"
    },
    "dataList[id=10].content": {
      "pl": "Tak do mnie powiedział.",
      "kr_sha256": "4040fddd1efdccc90b73a5d3e5214339c38af4e430980dc8364f0aff7d0685cd",
      "en_sha256": "0ba24049237c60a7507ebe8684aa664f8863878b2d6729d6695c779d93878aec"
    },
    "dataList[id=11].content": {
      "pl": "Jakby przenikał wzrokiem wszystko na wylot i jakby to wszystko było tylko z góry ustalonym biegiem rzeczy.",
      "kr_sha256": "47dc5ce4a7580532cb723b913b0f446aecce61a58c072da0a3faec65d2afdcee",
      "en_sha256": "bc6ab1dec5465afb8ec229f72552506e8513dc3dd948cb53ff3e76e7378d1db7"
    },
    "dataList[id=12].content": {
      "pl": "I jakby już znał odpowiedź, nie czekał, aż coś powiem.",
      "kr_sha256": "79c93f7793ae3fb592f39bcf753b640e1796b37b289fb908765797a885e01300",
      "en_sha256": "8c7c58637f09114e88072b847293f001df9b5f5f331952f5203893f48789ba0e"
    },
    "dataList[id=13].content": {
      "pl": "Kiedyś rozbijesz to wszystko i wyrwiesz się w górę.",
      "kr_sha256": "4a6d30c79fcbdd16d5a2e397a568e765d0b25c77d8924ca9a5e624808fe5781c",
      "en_sha256": "2079349a04ada4ce8ec5bea5494f65221bdbac78486aa5176d2dd9acc06f2625"
    },
    "dataList[id=14].content": {
      "pl": "Ja… chcę zobaczyć ciebie całego, wydobytego na wierzch.",
      "kr_sha256": "e4767470be7f2c82fc61cecd87fee02d0b174a9d798ba4a5c08c55ca0c59b138",
      "en_sha256": "2aabc54b22290d6a5b096ce63224ecc3fa9b137e982a66276922a84f13a7683d"
    },
    "dataList[id=15].content": {
      "pl": "Jakby już wiedział, jaka jest odpowiedź, której nie potrafiłem wypowiedzieć na głos.",
      "kr_sha256": "50e95b95a9f70e42288807d191ed64277c83f84c931e8bfbfc5463f03e12f693",
      "en_sha256": "404ea4e5632696b87c2d792420d1d6047819393398ce8f70df7dbd20a803a672"
    },
    "dataList[id=16].content": {
      "pl": "Ale choć jego słowa zdawały się pełne ciepła…",
      "kr_sha256": "053d90a5e387eab1cba4935c9b7ed3a2e342acfff6757605af2b45c7c04558b7",
      "en_sha256": "dc167151b77d74cebf4f07f0cbe09f120c670586c6082a04a022405ac4afad8f"
    },
    "dataList[id=17].content": {
      "pl": "przeszedł mnie chłód, jakbym wgryzał się w zimne wnętrze niedopieczonego indyka…",
      "kr_sha256": "d47f4416b5abb9874bd8a5e21714c79a826d7a52a59c343405783f239248695b",
      "en_sha256": "4b60917dda42f1345559e7a11e6c84e57508da799fca2e178eb10a30a3fcb5fa"
    },
    "dataList[id=18].content": {
      "pl": "aż w końcu znów straciłem przytomność.",
      "kr_sha256": "dd65ac98a5081e6d3736263676f08238aba52a86dcd90abc63bcf91e1ddc5f31",
      "en_sha256": "3228b64bddac67df4da3353e0b3018f29afd5030ea33fb1c1863d000a5f1f58e"
    },
    "dataList[id=1].content": {
      "pl": "Leżałem tam, otępiały.",
      "kr_sha256": "22ed794b5ee6b28cdcd7bf89c495fa931c061389090078149ebe4e1c53cf8499",
      "en_sha256": "230cbcc1f52f6b733e19656d58ab6f6a184597dbf7ebfe4c2f6ccc3b065e0cdd"
    },
    "dataList[id=2].content": {
      "pl": "Nad ulicą tu i ówdzie drgało rozgrzane powietrze.",
      "kr_sha256": "1bb3cedf5aa333218f667cfbf37f2db023e69bd39ee4a04befee8413f52299ff",
      "en_sha256": "16a3436e41866a871b92b66852e36ca85ef20f69ef238b442ef89929cedae3c0"
    },
    "dataList[id=3].content": {
      "pl": "Sinclair. Twój świat pękł.",
      "kr_sha256": "977b8d0e7ffb7e83a24e41aa293097728baeed359718bd04137eabdd3406d54a",
      "en_sha256": "2d3143e6e7828137b16ab08dc81b6afa633395cf9d7a1bcb77efe8babc093c4d"
    },
    "dataList[id=4].content": {
      "pl": "Chyba zaczynałem rozumieć, skąd brało się to dziwne wrażenie, które często miałem, patrząc na Demiana.",
      "kr_sha256": "bde81cd72a16d32c678c4392b7e556e6f5c323b7158f0f2bf6e760759f7f9210",
      "en_sha256": "4f49b123e94d6f858bfc3d367b0fc1522edd6bc7513dc13f2aad52ec7a218a26"
    },
    "dataList[id=5].content": {
      "pl": "Dlaczego nigdy nie słychać było jego kroków?",
      "kr_sha256": "1257f65befae440107bfb4e5ad796bab286960744270abdbd9055c19c809fae0",
      "en_sha256": "1d92c3101133503ecfeb4cdf8d2b4af9100f6c7e86c2a847bf6cedcdaa6c1c4b"
    },
    "dataList[id=6].content": {
      "pl": "Dlaczego wszystko przychodzi samotnie i bezgłośnie, w ciszy, jakby nie należało do żadnego świata?",
      "kr_sha256": "4692efc3ed2d40125be21b7b944b611cb5d502ee65180d034681dfc735520b9b",
      "en_sha256": "0f2981e00f4a88364db6745fdc5f836437ccf4b1d9e259ead6fb04b5f8fdc8fe"
    },
    "dataList[id=7].content": {
      "pl": "Śmierć rodziny, świat zła, rozpacz…",
      "kr_sha256": "ad593afd3722153874127c78355efe19626285fd24bfbd44abff5f80ed6ece7e",
      "en_sha256": "f5b4029302bec6044d0a364470862c599ef9e343b9e32cf932948421e741ba87"
    },
    "dataList[id=8].content": {
      "pl": "I ty też.",
      "kr_sha256": "ae7a23f9e8aad0e12d71f4cfd3d29448d52310f8cf7c8a991e48ad08dae4f168",
      "en_sha256": "cbd7bda57ae0354fca136675cbdb43716d2f4fc3c53d48d064b2591e7e2fb6a3"
    },
    "dataList[id=9].content": {
      "pl": "Boisz się, Sinclair?",
      "kr_sha256": "6ce9ab37182f01acccdc53c88cb88a0011383b657683dc849420405b7ace5506",
      "en_sha256": "8c938dda4e177a5335e8a34bae2bcf8420d6378e1109ebf4794611b8855e847b"
    }
  }
}
