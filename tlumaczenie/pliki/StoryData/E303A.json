      "en_sha256": "b4eff799a02718638604102fda2f0a5212506d7e667b33ae65b3935fc93ee228"
    },
    "dataList[id=21].content": {
      "pl": "Kurczak pokrojony nierówno. Kroi się równo. I wyprostuj plecy.",
      "kr_sha256": "3897104741ff37d746b4318a51bbb81f30eb164c05a4ae6088e1bd09ca02390e",
      "en_sha256": "9526c8563d5d02041408fc2c875d5f4ab2be8575a414199521805811fc3949ac"
    },
    "dataList[id=22].content": {
      "pl": "T-tak… tak…!",
      "kr_sha256": "2f7a6b6436d899bb9328dc0b2d3dfb00af713f0b82d13b7629d56276dd3922c5",
      "en_sha256": "b88ef217afa9f3b7d241509cbec28ef4e89b59a4230539d3217bdab391b1ada3"
    },
    "dataList[id=23].content": {
      "pl": "Młody~ czy to nie jest trochę mdłe? Wolałabym, żeby było słodsze.",
      "kr_sha256": "6ae8244d24cee40249cb460a005afec7f6b997b8972932a1608c292185af6ef1",
      "en_sha256": "1fa075760edb2f498873a951f7bbbd8e8f8fa28f157da119d5bb7c1fcde5ce03"
    },
    "dataList[id=24].content": {
      "pl": "S-słodsze? Cukier… gdzie był ten cukier…",
      "kr_sha256": "13b6d1d684e6c3ebd1909e42a51236e205a04aa8e9310f5587bff0637558d686",
      "en_sha256": "82749173a49613be9b5da2ef1306b959b74f68db7fd5d7a2ad5ed494d2d0232b"
    },
    "dataList[id=25].content": {
      "pl": "Zdaniem Faust należy zwiększyć ogień.",
