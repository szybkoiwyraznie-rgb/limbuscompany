    },
    "dataList[id=29].content": {
      "pl": "Chwila, a czemu mnie nikt nie każe gotować? Patrzcie, jajko to ja potrafię…",
      "kr_sha256": "17c42dcc4c87ebe422548a823a8cba5ca6d4c57fb5dd52e48f898921fba6f039",
      "en_sha256": "447b87c91a19ab5767afb34ddd2347c9bb5cbba5afd43135d8e5bfd0a5850a4a"
    },
    "dataList[id=2].content": {
      "pl": "Zda się, że to znaczy: z pięciu szans zużyto dwie…",
      "kr_sha256": "ffc44c4b5ae1ee6ddd8a3a0b79068c9aa1e27416e352d1ccff410dea6e883ead",
      "en_sha256": "df768a871f863e0f0e00624856a650ee744d5eced7676d3fe0b4c80f07a4792c"
    },
    "dataList[id=30].content": {
      "pl": "Cholera! Czemu ta patelnia jest rozgrzana? O mało nie zdechłem z gorąca!",
      "kr_sha256": "55e553f9cf2c8b9dde063614f9ac7977f570e2626fe708f686e783e7bce48c75",
      "en_sha256": "708359a9dcaece913dfb7a12cfd52e749e83645562174244c2f33668e1dbe86c"
    },
    "dataList[id=31].content": {
      "pl": "Wszyscy razem podziwialiśmy, jak rzucona przez Heathcliffa patelnia uderza o ścianę i rozpada się na kawałki.",
      "kr_sha256": "434ebc817f9872228ffd32132139cf488378b8ed1ffd6d45d9958ae9c6cfc3f7",
      "en_sha256": "e565bf4c10abfda40276b2e4c93db43aab1d86b4e135059a8c68c891b7c4a527"
    },
    "dataList[id=32].content": {
      "pl": "…W tej restauracji czuć pleśń i stęchliznę, jak gdyby nie sprzątano tu od co najmniej 140 dni.",
      "kr_sha256": "59cbbc6d8bd72d98121f0b44a758660775259e9fc9ea66e09b9367617b92d1e6",
      "en_sha256": "478ea5b142b3d91f93f789a20628343735198037718e762cfe67bf4989eb0978"
    },
    "dataList[id=33].content": {
      "pl": "Gotowanie na zewnątrz może być bezpieczniejsze z punktu widzenia higieny.",
      "kr_sha256": "7a68787d08f79598cd921922f17be869f898db8ecd6958bb59b4cca9ec53baeb",
      "en_sha256": "37b5b1e32e9a35f55539920b0f6ec059fc0897151f81a4ef7b4aeb6a16fe5669"
    },
    "dataList[id=34].content": {
      "pl": "I mnie dajcie gotować!!!",
      "kr_sha256": "a54d8674852e3a6a7e4f7e92ce40f1def4fffd5930e24cb7ac4e8a2f00cbd834",
      "en_sha256": "ef3fcedaf5580a246cdc99765aba08e4cd7a5771faea1d2d8efe4c3fb89b3da3"
    },
    "dataList[id=35].content": {
      "pl": "Kokokokokok!!!!",
      "kr_sha256": "28110cb84b3aeacb17fbcd8edfb75283daf3c9c412b7b47b9e10aca7d3362103",
      "en_sha256": "30c1dfd7729030f3fc2c98f066d943c1ef804cafd998f46857f542b57f3873eb"
    },
    "dataList[id=36].content": {
      "pl": "<“Jak śmiecie bałaganić w naszej kuchni! Popamiętacie nas, kurka wodna!”>",
      "kr_sha256": "ddd995d993b4d7fe5acfd1d5e6ac27fc8c8c9529023d368a3391804321fd9cb5",
      "en_sha256": "b29dc9129c9301b7a5f4e13ebe3eece989ad061fd08fea17f091f039ff75c7a7"
    },
    "dataList[id=37].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=38].content": {
      "pl": "<Tak mi się wydaje, że to powiedziały…>",
      "kr_sha256": "d3d453764e33821ede7dccc41eff60272b886cd97ec230f79e9e9f675b245afb",
      "en_sha256": "ed13a858acbe296ed298dd7c7a77585c0e3b61ce7d5e593a23e364972e38854b"
    },
    "dataList[id=39].content": {
      "pl": "…No, głowa do góry, Gregor.",
      "kr_sha256": "5fc959fdcee63c2fd0ad34ba0cf7e2c084a7095044da6d53a8303fcacc5a3f0a",
      "en_sha256": "3eebda0d0b3a73e62796c735d8b8b439ff1c1df897e627b88824fe5613558e84"
    },
    "dataList[id=3].content": {
      "pl": "<Skoro tak wyszło, to może każda drużyna przygotuje danie jeszcze raz?>",
      "kr_sha256": "e356c576a9a008193e2227ce6973d1d8c6fa24e014bcce1ef727d405ce59c87c",
      "en_sha256": "69d7dd248a659d8c39b20bfc6677c557c581a605150d936b50488a0f8db39adc"
    },
    "dataList[id=4].content": {
      "pl": "I tak oto…",
      "kr_sha256": "1f0c43b332e2e54de115c10536f549bd5743cdb93df36c7c39c83ae3a5946033",
      "en_sha256": "77b75fec86604cb67a54f2b66a1268993adea4ff3505c93c28243002c53a6c40"
    },
    "dataList[id=5].content": {
      "pl": "…rozpoczął się wielki pojedynek kulinarny Limbus Company…",
      "kr_sha256": "70e45e295e1c188c2a4d810653c70ed023b62b2c4c79812ef68410c1ba66e19c",
      "en_sha256": "1ce9eddd46db880e84f487a83c5e897f5f3cd3297882a96ba27d570556ab3dfa"
    },
    "dataList[id=6].content": {
      "pl": "No, no… Przydzielmy każdemu jakąś rolę. I tak wszystko pójdzie na marne, ale…",
      "kr_sha256": "ed5e3ed5aeca4004c2d535ea4ab8dbc8576fb79601951e6cde89687218795b1b",
      "en_sha256": "ee3beac6bb768e6c4d4ecb819a190f6c3ec43e4060b3f49f9aae24ae30873632"
    },
    "dataList[id=7].content": {
      "pl": "Hong Lu… byłeś ty kiedyś w kuchni?",
      "kr_sha256": "faf53defeb1bac13e55088c51698c0e83ac16450e6821aec220e0e8e583769f6",
      "en_sha256": "7741300e5df6cb149bf484f1302cd780756cd9e97c14fe06cd1f1c20d7047556"
    },
    "dataList[id=8].content": {
      "pl": "Ekhm…!",
      "kr_sha256": "16085132982abfce6ede75cef448523fdc76b133f792feae08d41a34142d360a",
      "en_sha256": "5c2d25b1eef2c8feeb9c295dd3391ef1323842e6e13338fd1d6e039d5fd8cfa2"
    },
    "dataList[id=9].content": {
      "pl": "Hm, w moim pokoju nie było osobnej kuchni. Jako dziecko zakradałem się czasem do wielkiej jadalni na drugim piętrze domu, żeby wyprosić coś słodkiego.",
      "kr_sha256": "0ea75bb33a88d9c99e7e0104e09a522fb1acb851f86dc107d8415796caac0838",
      "en_sha256": "b05ee1ae183f86c313023eb4a76906bc1cce480c80308110331cd62df36ecd0b"
    }
  }
