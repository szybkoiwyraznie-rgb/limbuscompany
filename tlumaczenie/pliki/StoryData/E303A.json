      "en_sha256": "12f2e2c36b76bc725db5f5d67c7f9ee69e7a31e3dc0941567e6903c5005dcef7"
    },
    "dataList[id=19].content": {
      "pl": "Nie jestem dzieckiem! A tamta drużyna nawet mości Sinclairowi pozwala gotować, czemuż więc tu mnie nie pozwolicie?!",
