{
  "entries": {
    "dataList[id=0].content": {
      "pl": "To była Wigilia, całe miasteczko rozbrzmiewało dzwonami i radością.",
      "kr_sha256": "6322d535ce9c0732440f29fd2d59f77545d7262ec8707ecfba206775f5d0796e",
      "en_sha256": "e24bb41c9176cb6e27e97106699cdf9bf4e34d24465cd208100446fa209e9c07"
    },
    "dataList[id=10].content": {
      "pl": "Sinclair… uciekaj…",
      "kr_sha256": "496a7895994f4a4b391a21aedd477e34269d80e49ee2f6751a40233ed59eeb07",
      "en_sha256": "840ca1abe03ad3cb277b33a22a382d0a06d4d3c4365ab442a21e979286b5379f"
    },
    "dataList[id=11].content": {
      "pl": "Sin… Sincl… Sin, Sin, Sinsinsin…",
      "kr_sha256": "7791aaa1175506cf29ec6e4e73eff673f939f0c144db8d05e738c9f4f6af65f9",
      "en_sha256": "3cb8957f6066e9eb978b36a05f04df567a1ec780635a7e24af1d9bb52be833c1"
    },
    "dataList[id=12].content": {
      "pl": "Ktoś uderza ojca w głowę.",
      "kr_sha256": "380224cbddf94211bea59d3df213f98c2609680d67e006bfdfe6fb9242affccc",
      "en_sha256": "1e4b8e02489d412d3ec3f17a0d1f33a788027c6c45f49c0dd319d45b1968c669"
    },
    "dataList[id=13].content": {
      "pl": "Dziwaczna postać w zardzewiałej srebrnej zbroi.",
      "kr_sha256": "4a0afbe6b69a75b6fd4da2d5d4c559a3a2a6cc29a453f57cafba42d5bb76ce43",
      "en_sha256": "156f89898a7fe4d3b03e1bfb5c9c247908117414c8c1629f18490308fe70277b"
    },
    "dataList[id=14].content": {
      "pl": "Że też te nieludzkie twory, zapatrzone w człowieczeństwo, szafują fałszywymi uczuciami.",
      "kr_sha256": "840829b60e5391f5d1c4cea37f4b5dcb024ae425ebc0503c4654323a9e3a8f91",
      "en_sha256": "2b7af23e0a3292a40f287b5a0faece5c030533af6a79c384c2b91f3d02e47178"
    },
    "dataList[id=15].content": {
      "pl": "Zostaw ich, Guido. To taki instynkt przetrwania nieczystości.",
      "kr_sha256": "5952f2773cafc0e6cb8b5e887313c514aff4f0ede6f2c8251f704fe6a747c128",
      "en_sha256": "894cae61b27f190d2657da6db3b9bc9a5d1d7668d9d3801440bfceb83a25d3f8"
    },
    "dataList[id=16].content": {
      "pl": "Albo nie… raczej po prostu boją się, że odetną im prąd. Ha, ha!",
      "kr_sha256": "1bc3a4ebd6148b1c4a63eb5db7b3e78ca8245f2ed3671ffb55b130c5259b4882",
      "en_sha256": "4f230e0f18b16702f50dff9780f5a5fee0afdaaf882f774c52e8fbce92924383"
    },
    "dataList[id=17].content": {
      "pl": "Odłamki maszyn, krew i strzępy ciała wylatują w powietrze i spadają z powrotem na podłogę.",
      "kr_sha256": "1abe7cc4dabe024c9c0dcadc92e896b89ec5a0809ab26e42b48ae38ea1985b91",
      "en_sha256": "2dc086082bc27ceec168fbaf9aaf45003068221b68c5e4269e9955910ecac6c1"
    },
    "dataList[id=18].content": {
      "pl": "Sinclair! Wróciłeś!!!",
      "kr_sha256": "8836813108c2587b585cc67ca87a13efae6a38e254ce37c02ff746c5103ffce5",
      "en_sha256": "6b285182122b9ce07178ddc74b182a4007e7cfc9ae2e7139b842dc13a5779cd5"
    },
    "dataList[id=19].content": {
      "pl": "A… aa…",
      "kr_sha256": "edbfdbb3b1f23d75b5107cc9134803839311f2067a4dd00dadfe5fb2efbb6dbc",
      "en_sha256": "ce70ba784761c4f744d56646483fa83794cc46de7ba9622c423105ba86576e57"
    },
    "dataList[id=1].content": {
      "pl": "Pod opieką świętej nocy zamierzałem wrócić do domu i wyspowiadać się rodzinie po swojemu.",
      "kr_sha256": "763055edda1a6bc6699962574fc0843e04782f5703b807d44a3692cc60918ae9",
      "en_sha256": "d15c8bdf383b82fd99c787bca1d842aaefb7d7ecda11d851d51ec1e8bb6fe50e"
    },
    "dataList[id=20].content": {
      "pl": "Kromer podchodzi do mnie z młotem oblepionym krwią i mięsem.",
      "kr_sha256": "237378b4e26e37d5d9adb1eaa382b5bfd77f8dcd4b28eb074ed0ebb42da5c3d2",
      "en_sha256": "def4f59ea84ac76d93cfd3de9a4d9f29195e8d1ec4696315126793041c67a968"
    },
    "dataList[id=21].content": {
      "pl": "A, chodzi ci o to?",
      "kr_sha256": "47bcbb767aed2389649aec5e6e237ce78fa9c7d0192ce6190de59bf09a9c1917",
      "en_sha256": "6595e85ba202e50a8e853d5c506356495388e24d66aac3aefaf8f7679aa4dd0a"
    },
    "dataList[id=22].content": {
      "pl": "Wiesz, od zawsze nie mogłam znieść, jak się choć trochę zadawałam z takimi brudasami. Czułam się taka nieczysta.",
      "kr_sha256": "b0757c5303be67781d594bfeca0fdd0d9d5434338f64cc99d6725918402d290c",
      "en_sha256": "fa4c67961ddda62b23bb34e74e9895b3b0caca3533e677e3cc3fd159a239ef5e"
    },
    "dataList[id=23].content": {
      "pl": "Bo jestem filantropką, która kocha ludzi!",
      "kr_sha256": "e99961f2ab92d96f89e54816aa606892c726ec271c22a693f01d3df507bfe4f8",
      "en_sha256": "15d47c4f206b733e3cba906ed7cc0912dc76f5ecc3c935d81395a641ea808657"
    },
    "dataList[id=24].content": {
      "pl": "A jak ktoś jest jeszcze dzieckiem takich nieczystych gnojków…",
      "kr_sha256": "c4e74c8b90137eecc18cf12f1cdb8ffa672346eff110fd01c6f38b9adc7522ec",
      "en_sha256": "8ac25d7b36d9479f3635300c150f1cf267d98332191b0fa1f19b713b705ce34b"
    },
    "dataList[id=25].content": {
      "pl": "To co ja mam z tobą zrobić, Sinclair? Hm?",
      "kr_sha256": "e9f6df86e061e995d9bff3f31c5052fc47b44403bdf2308be13c5636a45dd00f",
      "en_sha256": "8bd167d777c34603197eba9c0765f2805cba7cad31623e8bd3d895f50e76e41d"
    },
    "dataList[id=26].content": {
      "pl": "Nogi już dawno odmówiły mi posłuszeństwa.",
      "kr_sha256": "2689f20731aab155b41860baef2c6ff07a694732b199794d4bb0ecc0d09e2fe1",
      "en_sha256": "a73db11a135ee7f7296e7593e1f2bf970d7392e4777da9fc3671b81336bf096b"
    },
    "dataList[id=27].content": {
      "pl": "Usta tak samo. Miałem wrażenie, że każda część mojego ciała robi, co chce.",
      "kr_sha256": "867111229ad98cf9a07dad276affe1832e1a3c7ae987f31983c07d529eda96a8",
      "en_sha256": "39c24dbcdff69a5eee6b0fe396c7a7e587923900e9cb2f404880bcbd03c271aa"
    },
    "dataList[id=28].content": {
      "pl": "Przed oczami miałem stopy Kromer. Nie śmiałem podnieść głowy. Dopiero kiedy była tak blisko, ze strachu mocno zacisnąłem powieki.",
      "kr_sha256": "b5324d078e6251bac708186488aca08907ab9803e0e1f528ab74b2c23b325c8c",
      "en_sha256": "8be4ff1bc3b26426ea082622e9f41d4e08ad33bed9bd523df0e4082ef892761e"
    },
    "dataList[id=29].content": {
      "pl": "Na myśl, że ten młot, na którym zostały strzępy ojca, matki i siostry, zaraz spadnie na mnie, ogarniał mnie nieznośny strach.",
      "kr_sha256": "24aef98aa5c55666556f1908f30d5cde7dafd0ef4c06b64b2f2c6f3c4658c14f",
      "en_sha256": "9e865c70bdf16313f947f71f4df313800ee3751b01f2724917f40f144098da0c"
    },
    "dataList[id=2].content": {
      "pl": "Powiedzieć, że popełniłem głupi błąd i ukradłem klucz do piwnicy, ale że znów będę wzorowym synem.",
      "kr_sha256": "cae10955e90aabf608c0816395ef3aae2f7a6934f73cc27031d8b58cd4669980",
      "en_sha256": "02048b7e40065080118e7e71114757b6742ff53e628e9b5d5925a2fb88a1516e"
    },
    "dataList[id=30].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=31].content": {
      "pl": "Ale nic się nie dzieje.",
      "kr_sha256": "63b3dae37176dbd783fdcaf26e4a8bd8138f24710df5637c6c45cabf10a84491",
      "en_sha256": "daec37d8b51e3e95f52652119f21b5c058b4932969b14814749fa9f0e2352391"
    },
    "dataList[id=32].content": {
      "pl": "Zdziwiony, ostrożnie otworzyłem oczy i podniosłem głowę.",
      "kr_sha256": "1dd85bcecb86ae84f55ef7103da2148797fa52a3e0c7b4a372d3e91b114d9b2e",
      "en_sha256": "75b6d50d4ca3b01e8c4202f41f29587d6c04eb56ca11364073ea7a8827c69e29"
    },
    "dataList[id=33].content": {
      "pl": "Kromer patrzyła na mnie.",
      "kr_sha256": "e4e87a00558edd4201689b8c3ff48cec6e99cc56d15b43c01a2b28c0ca08195e",
      "en_sha256": "d8f2fd6bf30bbcb55570bdcb5b8d8fb032e3691ad43e72b0491daf8722d88da2"
    },
    "dataList[id=34].content": {
      "pl": "Z idealnym uśmiechem, takim samym jak wtedy, kiedy podeszła do mojej ławki, zagadnęła mnie i powiedziała, jak ma na imię.",
      "kr_sha256": "23f6f2845563a1663417828d69b92646ae4e8ef64b3c27137aa1986b662f7999",
      "en_sha256": "549ecfe18ed446dd730b0437cbaf3f32427ae0faa673ccadc809ef0c40fb264b"
    },
    "dataList[id=35].content": {
      "pl": "Ale ty jesteś moim bohaterem, Sinclair.",
      "kr_sha256": "43f10f28def354c984fee8e98749cc90e299a1155fe33f825c69cc388ce25b13",
      "en_sha256": "295ab80ce8a851d35b35c0b9e69b940e6a5fcdf08eda350235a78c197221d71d"
    },
    "dataList[id=36].content": {
      "pl": "I sięga do kieszeni mojej szkolnej koszuli, i wyjmuje z niej monetę.",
      "kr_sha256": "618b823501fd951fc1f654c07c25be2b9e411c30405473428200b16a5a4f955f",
      "en_sha256": "d532fd90785912f1970b4a263098f552819d83016aa6b769769738e4995b6600"
    },
    "dataList[id=37].content": {
      "pl": "Jedną z dwóch, które wtedy wcisnęła mi do ręki.",
      "kr_sha256": "6add29a73b2949e65082f203dfe4d4a3a1dd22653752ac86756bb7a46caa9d90",
      "en_sha256": "d6515b72a3b4e0107c0246bd075b7e6d87748a0803ca621362d3f5499cd4327f"
    },
    "dataList[id=38].content": {
      "pl": "Od teraz… masz we wszystko wątpić, wszystkiego się bać… i żyć w strachu, ciągle o mnie myśląc.",
      "kr_sha256": "01a8784d9f03fd0ec6ec7decbb33b165c359dcff27940ab519d2700f83e631b7",
      "en_sha256": "9af39505bc11d2ae8731081688fd034d089f963125f3ef55043b8d6bc2a2bc98"
    },
    "dataList[id=39].content": {
      "pl": "Y… yyy…",
      "kr_sha256": "7b72c111fa4359303baa074524f2c2949b7fedaf2965cacdae0a2c6328108cf0",
      "en_sha256": "23230e7bf5b52e664d2f97d5eb3ceb7c58f065a3ea3cbef226c0978e3d0527bf"
    },
    "dataList[id=3].content": {
      "pl": "Że przez ten czas strasznie się męczyłem. Że teraz dopiero naprawdę zrozumiałem, jak spokojny i dobry był świat, do którego należę.",
      "kr_sha256": "0624cd8a046da4cbd5038a3a66cc7dc382c00d830494c3d9dffea28d40b72ba3",
      "en_sha256": "180cee372a8bcbca9c36051f2fcfc0ba391a4d5fbaf2d795d6f4ea7ac3c8dcd5"
    },
    "dataList[id=40].content": {
      "pl": "A kiedy przyjdzie czas… zawołam cię.",
      "kr_sha256": "daa6cb7b2b36fb651be4568fdeb0c65bf37a45d9b2b6c59f7f834b76dc57d031",
      "en_sha256": "0bdc3f925d769ab66f1f80d981afdc5fd0842e7e2de6f38cd9c8f26974a744ff"
    },
    "dataList[id=41].content": {
      "pl": "Hej! Zabierzcie to dziecko w bezpieczne miejsce! Jak ktoś go tknie, to ze mną będzie miał do czynienia.",
      "kr_sha256": "4dd173db7f212be64b2c22295627135d5cc1e27e2081310545a1c73ce31cfd4d",
      "en_sha256": "0521328bd9aa422a8476de72c91a837e107ff3f7bca8bba1833f9e55ed1e4eef"
    },
    "dataList[id=42].content": {
      "pl": "Wśród dzwonienia w uszach, tupotu butów i zawrotów głowy…",
      "kr_sha256": "7ab0ab0bb2586d10fbffa44fd20b5fc553b867b1b6602dcadd730d32cb50cba9",
      "en_sha256": "b4a80bef2a2895179f3f4c4b6930a99200e662c3a0069eed03c6cb4e31f9403d"
    },
    "dataList[id=43].content": {
      "pl": "straciłem przytomność.",
      "kr_sha256": "2a88742de4d3e49e44e44cab34778f1b95b2440d13814853070579526abe77ca",
      "en_sha256": "c96adb16e5c88cc85678479bc9f6f07d56936c142d9b330ab6aad31bfd4356eb"
    },
    "dataList[id=4].content": {
      "pl": "Rodzina na początku trochę się zdziwi, ale zaraz przyjmie mnie z powrotem do swojego raju.",
      "kr_sha256": "eb2c1859cba227324856c8add6ecba71c632fa3e7fffe56c908f1bc9b56336ea",
      "en_sha256": "c38dee0aaa2546621b64acadfdb7dba34fb2672450f3b6cbedf7e08e05efac4e"
    },
    "dataList[id=5].content": {
      "pl": "Na pewno tak by było.",
      "kr_sha256": "77df6d9bd142f829a6943bfd0f9337dd001cd45fbbb6cbebdd61663af66309c4",
      "en_sha256": "81b5b5fc2ae654225461b60372b977e16decd2c77ec246f4da9d80a6e38748f3"
    },
    "dataList[id=6].content": {
      "pl": "Ale.",
      "kr_sha256": "08383eab4b26596774de467fbe4a0a433313d70ad2adfca9e72814b4278ebf46",
      "en_sha256": "e3625126d4ad5fc1084b6a2dc7f67fb05e3cf854958942f80430c1a8ec613413"
    },
    "dataList[id=7].content": {
      "pl": "Hę…?",
      "kr_sha256": "9ea23b31f4a3bc63a592e5c49dce2cdc61858b8f842a57ac4cc3dd93cb58f0b0",
      "en_sha256": "831c797888ac558a3ac2c913a8fd21246d90d2bbd069aa75b49c96af2a29a293"
    },
    "dataList[id=8].content": {
      "pl": "Zwykle już przy bramie powinienem był usłyszeć robota-psa, który zawsze witał mnie szczekaniem, ale dom tonął w cichej nocy.",
      "kr_sha256": "0e376da2ffe6a942b2ef21e259fa7b21d40f35ee4fde43675365d2a561c77e41",
      "en_sha256": "662e4b2082adc564ccfceb0d5ad7a8f76e44882192be9f587342623759fe886c"
    },
    "dataList[id=9].content": {
      "pl": "A potem zobaczyłem raj, który obrócił się w ruinę.",
      "kr_sha256": "372a950ac5a4bdda43b41ce5035792c8204deb122f99be974673f091df127cdb",
      "en_sha256": "8f6200cba57256edaa7d6599519d7f7d2a42e229bb179b8de1508bfd91b4ee13"
    }
  }
}
