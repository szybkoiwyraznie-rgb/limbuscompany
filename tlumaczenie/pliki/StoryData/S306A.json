{
  "entries": {
    "dataList[id=0].content": {
      "pl": "Osobliwość K Corp.: pociski HP.",
      "kr_sha256": "e0f5d1decd38bc65d4cef0a7024c99f09cfc1a0f3da3a9a95d4e5679d4b00a16",
      "en_sha256": "0cede08ae512234ec10e3260fad57f384943d6f8432fc55aba261ff522f8d757"
    },
    "dataList[id=10].content": {
      "pl": "Ryōshū wymachiwała pochwą miecza z kwaśną miną, najbardziej udręczoną, jaką u niej kiedykolwiek widziałem.",
      "kr_sha256": "19c213b1f90f33bbe8a253e504855a2a6a3493b9711241daeae4730c1512f68f",
      "en_sha256": "0c48ddbb1a6b388915504e36b0e70c91ef1e8694efd66757d67bba25b29d77af"
    },
    "dataList[id=11].content": {
      "pl": "Tniesz i tniesz, a rana zrasta się, zanim zdąży porządnie popłynąć krew. Dla Ryōshū nie mogło być gorszej walki.",
      "kr_sha256": "38c7b2f99deaddad59d658e7646d58047c519b0f4a9c08aa3e7c4bc72316e0c9",
      "en_sha256": "fe232598a7bd7f1cf624a1291bc186d22ed18393afe68f7dfa8ab7c8c4b6fde1"
    },
    "dataList[id=12].content": {
      "pl": "<Nic się nie da zrobić…?>",
      "kr_sha256": "904dd48fb54e8aebdbe36f92f18fe4a1f488724285f3767ba213ea187a3e7e9f",
      "en_sha256": "13c5e6a20cdcfe1dd680f385db6f2631faf151600b861fab0a535e764e8c642f"
    },
    "dataList[id=13].content": {
      "pl": "HP… helapoeza to technologia, która nieustannie uzupełnia utracone komórki ciała.",
      "kr_sha256": "6390c156ae827e2679a2a98b5ffe70eaa4bb1636e654d2e3a43975c54d210e00",
      "en_sha256": "14c33aa91f8168aa3fba7d0426102c80ddc262bd0ed727be87b2500f47be8825"
    },
    "dataList[id=14].content": {
      "pl": "Nawet jedna dawka działa bardzo długo, a oni dostają zaopatrzenie prosto z Gniazda…",
      "kr_sha256": "a4a9a0a23c12e3462053c9a110f0c6a77353a1449a558937dd2b829702e21fa9",
      "en_sha256": "383be872c0445ebb32f2970f4ca93c35c22e98e25c9e02b7681fbeb1a8de13b8"
    },
    "dataList[id=15].content": {
      "pl": "Można by powiedzieć, że w walce nie da się ich pokonać.",
      "kr_sha256": "dab5aafdcb50bb582bf7e99558fab6eedb5c4d3982955461fc8577a81bff2478",
      "en_sha256": "4b42fa3b0346f5b998668cea38c13eb2774a374ce1050e726eabad46940738bd"
    },
    "dataList[id=16].content": {
      "pl": "Kiedy nawet Faust pokręciła głową,",
      "kr_sha256": "c59d59c9cbfebde742f2da8cb28bbd9b54ad7751b12117242c11a2c428f8e9aa",
      "en_sha256": "99ab6e9ec7e64cb0cbd3571fc2f93b01905d5f50796a080cacb762969c757f70"
    },
    "dataList[id=17].content": {
      "pl": "Mua-ha-ha-ha-ha!!! Oto pośród zamętu zjawiam się ja!!",
      "kr_sha256": "b98b82c972aa848822c6465431b6e1df3d75545d27dbcbd7bc7b84ff54ae685d",
      "en_sha256": "e014ce34f255c5eec339dac80d1aa543e5df285d4ace8fb85e9cf37505a37e0e"
    },
    "dataList[id=18].content": {
      "pl": "echem poniósł się czyjś śmiech, wesoły ponad wszelką miarę.",
      "kr_sha256": "bffdda0c951d66beeaadb0bf5686dfcc41380ea40f4dae4b40475f81a59a2029",
      "en_sha256": "7129717f1c8e0b6b6c12e24a2e1ee549c70f501641fb8bed48dd3bceedd36662"
    },
    "dataList[id=1].content": {
      "pl": "Nawet jeśli z trudem zadaliśmy komuś śmiertelną ranę, jeden regenerujący pocisk K Corp. sprawiał, że cały trud szedł na marne.",
      "kr_sha256": "fc600d71c943bd3afc9de29a1b2ef07a680e0c911153ce8541c2a15259eefa41",
      "en_sha256": "f69b0f463d2e0b6eabb18365571d5e887c32c4159709af4b6f0ba8c2a786d63d"
    },
    "dataList[id=2].content": {
      "pl": "Jak można się było spodziewać, pierwsza z trzaskiem pękła cierpliwość Heathcliffa, i tak wisząca na włosku.",
      "kr_sha256": "a28b45c0a4b74c1a2029508af37f377e81893ba75d03da81e48a7c0df6c41541",
      "en_sha256": "7084ab567168966d0044b66892782a56f7fb3450ae76ea7bfc4af39d01fde55e"
    },
    "dataList[id=3].content": {
      "pl": "Mam dość! Robimy najbardziej bezsensowną rzecz na świecie! Kapujecie?!",
      "kr_sha256": "536fd8bfe86f993d430bd408e8f89f0de471a720bb171ebaa58ec25cd788a43c",
      "en_sha256": "bae44d91d53aed93bdd1d8a6392a6fa7430e024ecb2b111557f5911512b6a959"
    },
    "dataList[id=4].content": {
      "pl": "Mówiłam przecież. Zadzieranie ze Skrzydłem nie ma sensu.",
      "kr_sha256": "a7100b60f3ed89fd84eae61bcd7065e03aa553b2f6cd47b64db2322886134a9b",
      "en_sha256": "05e0f61ecc5e1c0864eb04fdd16eac5c40257403fe7a7fa6edb05c1c0b4815ba"
    },
    "dataList[id=5].content": {
      "pl": "Nie myślałam tylko, że ten bezsens będzie widać tak na bieżąco~",
      "kr_sha256": "b4a8e784b52c2ae7ad706696c53cc51820fbfca6aee2ae5d3e9e3a29b96fc87b",
      "en_sha256": "6c2e12854c0c6e7a49166884dade2fe453bb20f1be6e2744e0017958cb2e7269"
    },
    "dataList[id=6].content": {
      "pl": "Co się odetnie, to odrasta.",
      "kr_sha256": "72252d7889e04fc186c4f6494710522471b7cababe11db278157459e7e3ee587",
      "en_sha256": "e45ed3c3af33535a287ab93001a8c5c26600f531d87b7ee2c8cd741913d7ff8d"
    },
    "dataList[id=7].content": {
      "pl": "Trudno prowadzić walkę.",
      "kr_sha256": "f4d02d80dad7355f1b6aa29e1bc97ff9e1681c9897c565b1feb74ca8800e86a6",
      "en_sha256": "0e08ce55abfb91ad2c70fe821dd830e698db5753f8098814b56033674f940a9e"
    },
    "dataList[id=8].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=9].content": {
      "pl": "Taak… Bywa i taka sztuka…",
      "kr_sha256": "805273dafba513c617505ce3223d53dcb94b64d4a72d8d77d74eeccf0c4f8205",
      "en_sha256": "18168e433b2724442391b01d33dae79a23e829a72e9acb39d6d914ca9ea9bad7"
    }
  }
}
