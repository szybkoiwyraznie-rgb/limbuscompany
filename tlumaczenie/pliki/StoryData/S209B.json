{
  "entries": {
    "dataList[id=0].content": {
      "pl": "Nie mogę patrzeć na to guzdranie.",
      "kr_sha256": "0f6d68400755abf886c100448280a300ce19e0cd91deb686855fda38b8a41604",
      "en_sha256": "024c27471df0fcb5fd1bb6e443460042d2a999cb5130f4c36c01e3ae57192723"
    },
    "dataList[id=10].content": {
      "pl": "Sztylet trafił dokładnie w mocowanie żyrandola, który natychmiast zaczął się niebezpiecznie kołysać.",
      "kr_sha256": "36f437e61593e751cbe780c1a3959b0d86d48a9e523b6d0ce79ca3ce102fc937",
      "en_sha256": "15236a97d11bbf45f81f5c949932ed096a78f78e097452102bdb52158df7b6f3"
    },
    "dataList[id=11].content": {
      "pl": "Tak… Ryōshū, odkąd została Grzesznicą, utraciła część dawnej siły.",
      "kr_sha256": "a1c337a0a47800aabddc45f92e95993b1fb3339e8d524fe06abcea922db8fe62",
      "en_sha256": "c4df09a4a1962c7a698a21305b213a37c89eeba6205942eaf148469683b1238d"
    },
    "dataList[id=12].content": {
      "pl": "Mimo to wciąż była mistrzynią ostrza, która bez trudu przecinała choćby żelazo.",
      "kr_sha256": "06d9df9cac7d7abe82e6b15fdeb3a4a8e2074a4550ec759116b6920dd2bbe26b",
      "en_sha256": "6f65dfe7df15333f052872793c7d01352be1bb8ac3ae8cfb105a580d85535217"
    },
    "dataList[id=13].content": {
      "pl": "Choć moje słowa traktowała z mniejszym poważaniem niż przeżutą i wyplutą gumę, cóż, nie miało to znaczenia.",
      "kr_sha256": "e8b61e2d4208e86bfb60ad2fe8430d684e48b6b45a6f7999150541cbe9ee8289",
      "en_sha256": "a4dff0c1b80ea32adab16fdb27bbcdfd7da0694ce365f964c450ad6b8868e1e9"
    },
    "dataList[id=14].content": {
      "pl": "Wszystkie spojrzenia zwróciły się ku przekrzywionemu, kołyszącemu się żyrandolowi…",
      "kr_sha256": "7772388b663f98abdf33d019fa91ce5469cd57b83ef3ba34f35459f027dbec29",
      "en_sha256": "cbae1f3eee274c22c5ed13789c77e15056f84582bd0efe06357b8ca5ffea7673"
    },
    "dataList[id=15].content": {
      "pl": "który, nie mogąc znieść takiego wstydu, w końcu…",
      "kr_sha256": "54cf00f43d713a94bae04233daa5c7bc1cb590ab2831e69f39faf051579cefe6",
      "en_sha256": "9eb1bc273f88cb7c36bcdd66094d14497cb577a1cab3bf2cbf84bcc002dabcb2"
    },
    "dataList[id=16].content": {
      "pl": "Ulotnie… w okruchy się rozsypuje.",
      "kr_sha256": "3cc113240df453da1718fa5eae7ed1520b44e5a46bbe07359bca644c49fddc71",
      "en_sha256": "03495fc272d06116ea36322a373c8ef50b2a6563ddf28a4ede4ab91b8d19bff9"
    },
    "dataList[id=17].content": {
      "pl": "Hę?",
      "kr_sha256": "f8080e538fc080b4dc9d98d5985a20aa78682c1e1842f527e613d9260855ff49",
      "en_sha256": "c2a3b401735b3b85f1feed9301d2c48d5ed1f0e32be433fba4389c1a917894d9"
    },
    "dataList[id=18].content": {
      "pl": "U… uciekać!",
      "kr_sha256": "44d4314b48a839913a8831ab21fb88acedd5d9163336f8d45929c4f4c7622dcc",
      "en_sha256": "94c4419365f6bb0cb4e1c617e9d16f4885b2fbc5c941f5df625a78989a18802e"
    },
    "dataList[id=19].content": {
      "pl": "ŁUBUDU!",
      "kr_sha256": "ce6ef6460c6cc3bfbd9631136f29832e7cf3fa7cd01e6aec9f1cbd2f4904e250",
      "en_sha256": "67041b5d1d12d3753921bdcf6b66dbf72a30c38dead209811f45165c627809df"
    },
    "dataList[id=1].content": {
      "pl": "Jak długo jeszcze będziecie się użerać z tą zbieraniną gnojków?",
      "kr_sha256": "6ca18010374b4ce5e44009c38fd9126cb89726945875dad0adcf60d646e9820b",
      "en_sha256": "61a6971e7f2cbe53e6ea71094c4f4019dc99e37c12c7c5874fdc051528672171"
    },
    "dataList[id=20].content": {
      "pl": "Z ogłuszającym hukiem z całej siły rąbnął o podłogę.",
      "kr_sha256": "48a7f2aa9f1924d317209f6d0604f7b54b0025f2ea202f54a33c309af7ca5b84",
      "en_sha256": "d7f000ce8faec4bcf4a7448a8b77f454da4dc24988fa5417223b7620fe15fac8"
    },
    "dataList[id=21].content": {
      "pl": "…",
      "kr_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43",
      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=22].content": {
      "pl": "No i tyle. Rąbnął.",
      "kr_sha256": "bf28ce32c3b28d99c0365f20458eacc98fd532f6b7d7830e871f681e2051558b",
      "en_sha256": "fa4a97375e190d1679446d32457ed83c65fe624ccb9152b3843d9e2a77f8784b"
    },
    "dataList[id=23].content": {
      "pl": "Nic więcej się nie wydarzyło.",
      "kr_sha256": "5e8cfb8a9ee8998cbecdfd36bc06cfb962d2d4017f89b18e9258dd54fc596264",
      "en_sha256": "a42034ccda1ee3b2a051c035f690c5ca38ccaab93eac7eff32d3057d1f3c0973"
    },
    "dataList[id=24].content": {
      "pl": "My i nasi przeciwnicy przez dłuższą chwilę gapiliśmy się tępo na żyrandol, który spadł na sam środek pola bitwy.",
      "kr_sha256": "3aa033af74f61679093bd056c5bda71b60703bef2cc3b3edc3e271d079d78875",
      "en_sha256": "68d60eaed6e33d2794fa0742e87500d557029ad75c84f06d0c2cc9f85bf4b549"
    },
    "dataList[id=25].content": {
      "pl": "<Ej, co to miało być? Ryōshū?>",
      "kr_sha256": "80a079ea3fd054406b246e0888904b55a79ed1b33c5dd4936f70fcda5c2a978a",
      "en_sha256": "83c2e67de9cd33f301b4d5eaa7024a2c225664285f7b505a3ed06bbcafac9845"
    },
    "dataList[id=26].content": {
      "pl": "…Performans.",
      "kr_sha256": "27dc73ac7830c5ca2ea741e8d7e55e6281d4d0de68aab0c5f482ad7416d0a0b4",
      "en_sha256": "baa98bf9e63d4b1ded6504bf4cc05dc5aa94d36bd948b88f4bd1599cd162c3c0"
    },
    "dataList[id=27].content": {
      "pl": "Dopiero co to wymyśliłaś, co?",
      "kr_sha256": "f30a01dff0ec54580fda1f9be243bebbc7b108458521dd7a2e54a7ae78a80c8a",
      "en_sha256": "a74df4b31bb4a0af3917ac8a25f290f6e1b1781e12acb38ef087be8fc313d35d"
    },
    "dataList[id=28].content": {
      "pl": "Ale przynajmniej wszyscy są cali!",
      "kr_sha256": "79aa126da00cc6124659a1cad7d643a4bd218d8815ced981c69ee989700a5830",
      "en_sha256": "caa96f35a4aefd4081a3511936e87d9cd6c71bf47ae0bda9eb6f992c094fa4c4"
    },
    "dataList[id=29].content": {
      "pl": "…Choć nie wiadomo, jak długo jeszcze.",
      "kr_sha256": "80469843473c2d44ff7560996a4df216572f9128679d1ae89e5f435b00fba78e",
      "en_sha256": "03af5cdef8ce905f2a44651cea199a7bd647ec507970dbb4c256ced17489d199"
    },
    "dataList[id=2].content": {
      "pl": "Zwykle ci, co tak gadają, nie mają żadnego sensownego rozwiązania.",
      "kr_sha256": "c8e83bda518a4cae654ea3e7d061895d1ed4c6ebed8eaa11dd268fc85398e72b",
      "en_sha256": "666790c96b900b782ff4d03215bde2984e0627fcbd9d76fde14a60aa6a754efa"
    },
    "dataList[id=3].content": {
      "pl": "Ryōshū, usłyszawszy słowa Ishmael, pokręciła głową z miną, która mówiła: patrz i ucz się.",
      "kr_sha256": "0748453f66342f9279fab72d07cf54e6b46ba40e0039761cd114afda505562bf",
      "en_sha256": "8dfed1deb1496a4c1429653c217d00f9487488af14674e4d859fec422af54c63"
    },
    "dataList[id=4].content": {
      "pl": "…Tak wygląda sztuka.",
      "kr_sha256": "4033477d7729d528cfce25a6327f0df4b4a6a34c07fbcd969a136e05e438ae55",
      "en_sha256": "ab792b7aa4f976cf6a4685808cda925d6e6f455e3696d38ba7deae8dc78f949b"
    },
    "dataList[id=5].content": {
      "pl": "Ty. Daj no ten nóż.",
      "kr_sha256": "4b51f69507577f3e5df89f98bffc5ba835e59032c2547c1f5da1a31fa5e3ce1b",
      "en_sha256": "16461fa0f356f804dc0092d7850d4c99fa5dfd8859bc9aedc67ab169ecb60eaa"
    },
    "dataList[id=6].content": {
      "pl": "Wolno pani zabrać go na zawsze.",
      "kr_sha256": "c487e1bffe1475c26ffcd4524ae031d76495f0d5a5437bb9c3e4073a71e7bf6f",
      "en_sha256": "6ee9ff1a0aabda6ab7a915fd30120e7e776efd67849e8ce771bff03e5f22696d"
    },
    "dataList[id=7].content": {
      "pl": "Lepiej, by ostrze mnie opuściło i błądziło w przestworzach bez końca.",
      "kr_sha256": "60ff3ef31c98ac3636c2941d7262212a034740a6976b115812f3a5c4822d7967",
      "en_sha256": "813b889b33f5f0b101ffb79c134b95d25d6e98fbd7938b59dc7306278e7935b9"
    },
    "dataList[id=8].content": {
      "pl": "Dzięki.",
      "kr_sha256": "197a9ad5adccf4aa164b34a8e8648a7ac72f16a253519bf3594743fdff744bd5",
      "en_sha256": "e3704739bcaf083664743088d4afa8990991acb0ca7b3f9a19f2650044f4d8b8"
    },
    "dataList[id=9].content": {
      "pl": "Ryōshū wzięła sztylet Yi Sanga i cisnęła nim prosto w górę.",
      "kr_sha256": "4efa59db450e436c5d74c2e1222d2c76700fadd526cb3bce5e52c9c25d81bdc7",
      "en_sha256": "b1e5050a23e817070a20cb090c120c826fa33519f48062d6efe0f890eb13c2de"
    }
  }
}
