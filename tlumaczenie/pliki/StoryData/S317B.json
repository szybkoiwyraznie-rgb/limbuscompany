{
  "entries": {
    "dataList[id=0].content": {
      "pl": "Dom Sinclaira był największą rezydencją w miasteczku, położoną w samym jego sercu.",
      "kr_sha256": "aeb4735be9f7d3355a5dadfee5278a98654d56a25e260cdfe56a690c7b23d177",
      "en_sha256": "4f44bd972e952a2302ada5a5e1761c64137490121d10167c1974ac6e01c57496"
    },
    "dataList[id=10].content": {
      "pl": "Na wysokie jak tyczki gwoździe nabito najróżniejsze protezy,",
      "kr_sha256": "893714d83821c913235ecd8b5ef3bf76ff433854d15aa832126c1c5db6bf794a",
      "en_sha256": "d6ec20b13f3576325f577eb9ed1c5f01c72b11ff9076c154c446d4b719092b59"
    },
    "dataList[id=11].content": {
      "pl": "a dom płonął gwałtownie, jakby miał zaraz pochłonąć to wszystko.",
      "kr_sha256": "d325da9ea3d2b4e1741ebc25c04369479f703e14da89163e143490a1f42cef5a",
      "en_sha256": "8fd161cd3f7bbc95524a483d1347352dafd3fa8a91c8a88ee820cf2a135e66df"
    },
    "dataList[id=12].content": {
      "pl": "Kiedy wszyscy wpatrywali się w protezy,",
      "kr_sha256": "5bc0bd9540c9c42bc4bab011cfcbb043db56b84d6c87e8c16388f8a2cd21dc65",
      "en_sha256": "94f80a536fe9358aeccf18bf0f9c4948ac90391332f0cd8b46abb99ee5882798"
    },
    "dataList[id=13].content": {
      "pl": "Sinclair patrzył w kąt dziedzińca.",
      "kr_sha256": "7b425e1bb36c25a1a33426ee7b1136843d5eba8fa64bc0aeef4d970777353b94",
      "en_sha256": "4f253f37c9f4ab65840c6e76f818a8c1bbb7097492c5b56d1ddd654e9cb4b480"
    },
    "dataList[id=14].content": {
      "pl": "Groby… ktoś… rozkopał…?",
      "kr_sha256": "69400d9f3a4b8b0ddc564d15d13009bc5181b20d9b2a407063b0b0e31a76a41c",
      "en_sha256": "e87b3dcc65280ea06181c00b816c4cf6270261d4de7354904b3cdc3f871985da"
    },
    "dataList[id=15].content": {
      "pl": "Podążyłem za jego wzrokiem i zobaczyłem trzy groby, rozgrzebane byle jak.",
      "kr_sha256": "6fb4318643dc1502b8dca5608efe35416300f2581a07904cfcc6a5aa3ec13d69",
      "en_sha256": "1bb559f96a9e80cbd6ed1be0b77079c5dd2b3e7bea099c7ab0dc6e2a42bd6209"
    },
    "dataList[id=16].content": {
      "pl": "Sama twarz Sinclaira wystarczyła, żeby wszyscy Grzesznicy domyślili się, do kogo należą.",
      "kr_sha256": "f89e78ae5c5d586ef8e8fba1ef9b854512a03ec0d01f58bedc0d61b0392f8b3e",
      "en_sha256": "1d9dde2dc80325865f9ef3dd80785ad289d627275a1c7647166518ba0478a3eb"
    },
    "dataList[id=17].content": {
      "pl": "…Bezcześcić zmarłych w ich grobach… Zaiste, nie inaczej czyni szatan.",
      "kr_sha256": "581547fd3a7af6a9e07a9b546bf0865a9b262294236f174f5ecfc32aa641ad2e",
      "en_sha256": "191b2fbba88ae6bb6c19c0fe6d94bfb369194f15811fd9d854e2a4e805522f0c"
    },
    "dataList[id=18].content": {
      "pl": "Ojciec, matka, siostra.",
      "kr_sha256": "cb7b2c4d63de58c63a98fbc488bb771da0f8763e9275756dce44081f71b8a395",
      "en_sha256": "e0f8e961308362593ea881ddfb0b458921b0ee87e55952b828269bf6b4b14dbf"
    },
    "dataList[id=19].content": {
      "pl": "To groby rodziny, o której kiedyś opowiadał Sinclair.",
      "kr_sha256": "e035baad5038ded271f46c9118e4cd3a83c9c616898c4fb091eba002dacc523b",
      "en_sha256": "8b7c9d60519862598343228996d314c0b07f92a4587caa3a23ec885ef5a33728"
    },
    "dataList[id=1].content": {
      "pl": "Już z daleka było widać, że rezydencję trawi potężny pożar.",
      "kr_sha256": "1058af9f3e20107b574187b1d4818b95af3cce3d533af0237dfd91dce756f80c",
      "en_sha256": "258911a12d71abaa5ccd4c615b4d2c7d30c42028226b0e8c54825bad33cd32f3"
    },
    "dataList[id=20].content": {
      "pl": "Stać… Jeden OPZ, na wprost.",
      "kr_sha256": "b717d7c7b04d7c72b519619bf5556c767eb9801eca66b379323930e215a20566",
      "en_sha256": "bb96b547e72808812c83bd18d280bbe9587e481b1aea4f9160766508eb6b3579"
    },
    "dataList[id=21].content": {
      "pl": "Ten gwizd…",
      "kr_sha256": "691046d5fbd7286674866684700d8ff3904c87985a2078ffb3f5f4666ead1929",
      "en_sha256": "f3d9545c20e860b6b58ca04be5a9e0baac83734628b84d4ba1f13ad875cdfb96"
    },
    "dataList[id=22].content": {
      "pl": "Chi, chi, chi… Nie, no, jak się nad tym zastanowić, to przecież przezabawne.",
      "kr_sha256": "9649577edcf55b2ac467e7e1896ed1f6f8258f8b41df596f87da296436127057",
      "en_sha256": "5ca13c613136ef63e3276a4314e3e9e6ab9108d261eec31b67fcc1a70c725dff"
    },
    "dataList[id=23].content": {
      "pl": "Z płonącego domu ktoś wyszedł.",
      "kr_sha256": "1848ce66fc21ea62746ed175d4e776156815af963ff346d2c872be39192653bf",
      "en_sha256": "6f644acc38f9576f569dd9ab85d118bc842fc142a6b9cde1f80ee09c0799299c"
    },
    "dataList[id=24].content": {
      "pl": "Śmiejąc się tak, że nie dało się tego odebrać inaczej niż jako czyste zło.",
      "kr_sha256": "d7d9f05666100416c96fc3628e788957c34cd4666c72280c8d6ecd4cb2602950",
      "en_sha256": "56216efb8a0075e482171cacf813605ae963de1a0162e6f21913f057cc50ce00"
    },
    "dataList[id=25].content": {
      "pl": "Tak starannie zakopywać ciała, które nawet nie gniją… No nie?",
      "kr_sha256": "e519cdded06bc4bbc89448c72b0266c1cec8d5a81e750ab129458c311325d4b7",
      "en_sha256": "f9395fc396569c034f338c4f9f56b9c4cfeadd2728ee0c2bfdd049dc5bda73b5"
    },
    "dataList[id=26].content": {
      "pl": "Kromer…",
      "kr_sha256": "631fff88d496aab0a99d62b8b27831fc17a325d3f8bef22dcfc3853f26c00f6e",
      "en_sha256": "b9a43bb8fce339c34fe0221e4aab29ce6616c57130fc09909f24fd18ffb12d8b"
    },
    "dataList[id=27].content": {
      "pl": "Ale jak dobrze poszukasz wśród tych szpikulców, to znajdziesz. Gdzieś ich tu ponabijałam.",
      "kr_sha256": "9b48aa5b3d4093c882552984497f803b0764640de7eec495ad83b8e8e5e8da42",
      "en_sha256": "faac1d96abef5ccff5d6d2492c9082a853de26f74b1be896a6553b2efb62c284"
    },
    "dataList[id=28].content": {
      "pl": "Jak będziesz grzeczny, to może ci powiem, gdzie są…",
      "kr_sha256": "61c6cd692bd603b1f181c5e2d11d5c49b3c78b77b47d5091212a88d656694559",
      "en_sha256": "c498fabbd1a6965924fdd9736470d5a462d25274c7a28f8656f0fc57d26fb673"
    },
    "dataList[id=29].content": {
      "pl": "No i jak, Sinclair? Skoro dotarłeś aż tutaj, to chyba bardzo zmężniałeś.",
      "kr_sha256": "b03263827ca952e1ffaf65f62fc57f483ec3383304b22bb5422b4e5afa173204",
      "en_sha256": "ad85db1ea4e86f01ddfca8613dd3fc950f7362752b09b2383c3ff5b7bce885f8"
    },
    "dataList[id=2].content": {
      "pl": "Przez chwilę próbowałem sobie wyobrazić, jak wyglądało to miasteczko, kiedy jeszcze panował tu spokój.",
      "kr_sha256": "2aac984a608919d7a59e8171cc64650e7e983c9f17bd5560054d34b081b5d4f2",
      "en_sha256": "aa803320bc327923b8306685a312555c0bb431308c90142e97d7ff13d3e37562"
    },
    "dataList[id=30].content": {
      "pl": "Odwagi, żeby popatrzeć na trupy, też nabrałeś, co?",
      "kr_sha256": "02391fbb77c89383603dc48bcd233231eb9508640620319a8672220bfb8a37d7",
      "en_sha256": "dc093b5067ca225393db6ea73131bfb0284ddafb3495b6ef1f055019b856ce52"
    },
    "dataList[id=31].content": {
      "pl": "Dlaczego… czemu… tak…",
      "kr_sha256": "4e0bfbd0d58209222a0c71beff5bfb19159057a5d6271a00e8546ad493ac9c01",
      "en_sha256": "366a00f9cd261d2fd3bdca09b2bd4df37e35e1c2e200683c536804c28943e889"
    },
    "dataList[id=32].content": {
      "pl": "Sinclair nie jest w stanie wykrztusić porządnego zdania.",
      "kr_sha256": "7940804af8b6ccd05a92b399df741a8e2f856d3aeba58520c2c221a9465bb01e",
      "en_sha256": "b10abbdcf82930bc018edb2e820c914c73354a140db74b0f290c6694ae2f142f"
    },
    "dataList[id=33].content": {
      "pl": "Gdzie się podział zespół Before? Skoro doszliśmy aż tutaj, powinni się już pokazać…",
      "kr_sha256": "95a007593122fde29b981ed54e55e1c3f15637deb7a5a6a6c16703da3c74e83c",
      "en_sha256": "0570ca8b4be0a804daa64c7a25fe7a93788e6611350ae31422a6c96a82c0954b"
    },
    "dataList[id=34].content": {
      "pl": "O~ Sinclair ma kolegów!",
      "kr_sha256": "2eabd21ee5ed675dcdcddae9742e2ab5f04456e2779a6a6eaaccb7e09a05ec7d",
      "en_sha256": "120b2ef3c443d982af9166585df96580e8318dc4a6b1eb9b96eb1f51b823e929"
    },
    "dataList[id=35].content": {
      "pl": "Szukacie pewnie innych szczurków, które zakradły się tu razem z wami?",
      "kr_sha256": "3dc8feb0a7f63c1b8b51fd84ade1dfac4277f86000790d61fee56a065eaf4a1c",
      "en_sha256": "4e4c5285d074b4145ab544f9f69fb25bb00dc5582b91ee90a1095e735f7c9f2f"
    },
    "dataList[id=36].content": {
      "pl": "Dobrze, dobrze. Patrzcie uważnie. Zapalę wam światło, tylko otwórzcie szeroko oczy!",
      "kr_sha256": "c6e48ab804293284a5440aa8a23904bfb4ea9be1329ff1128ae66206448b7034",
      "en_sha256": "e73292bc4178c762e83da2dcf6e914279f73c18131fe91c292ccd1187edb588d"
    },
    "dataList[id=37].content": {
      "pl": "Ta-dam!",
      "kr_sha256": "a1fe5bd3a484468ff1b347f4b761074adb31a8863fc44602b4dcddaa15e21ae5",
      "en_sha256": "6a091f77e02a8debfeaa272afd0a896f63623f6057cda16984079eddb64ef8e3"
    },
    "dataList[id=38].content": {
      "pl": "Kh… khhh…",
      "kr_sha256": "ae40611dc2851b8d4efb40d7900644fdc90eb389168e08a229f6571480d73395",
      "en_sha256": "9105510e245d91540cd031cfb508e6b777f00d8ea2d05fc7812c096f811d0745"
    },
    "dataList[id=39].content": {
      "pl": "Effie…?",
      "kr_sha256": "3ae9a3b5777a64321f33fc86f221547456246fa471a61f06c4a80c3e00a11db9",
      "en_sha256": "557462c56aecdd12c28e92c73664bb6653eb8fc7f7c8085c40419bf900a5f6e7"
    },
    "dataList[id=3].content": {
      "pl": "To znaczy w czasach, gdy drzewa, które widzieliśmy przed wjazdem, miały jeszcze, nie tak jak teraz, zielone liście.",
      "kr_sha256": "1fb022b6e8a983f0ae459c8f405cf999bb87b30575f18519af337e1a81568192",
      "en_sha256": "52359d501be0a5e77f46f3f44c281efe59f2366a8b0be7427fb290a8b8036e72"
    },
    "dataList[id=40].content": {
      "pl": "Ledwie żywemu Effiemu odcięto ręce i nogi, a w ich miejsce wciśnięto na siłę powykręcane protezy kończyn.",
      "kr_sha256": "18084f6577d66925a7f1502c0c6d71a200bdbcb3c53106d5e29cb6cd24a15cd6",
      "en_sha256": "6f23e6f9de80155b6774b8e9326a77b084f09563c76c437dd1d4da9ebdc47c22"
    },
    "dataList[id=41].content": {
      "pl": "Panie Effie!!!",
      "kr_sha256": "8a39a908bd23986a52f809fc050e937951d025869631ae04e46ed972fc08f045",
      "en_sha256": "54f4c56d307fb796ed6832f863d0409a09ad7f3528f61178fcf7c85b1c1d311a"
    },
    "dataList[id=42].content": {
      "pl": "Effie był już tak zmasakrowany, że nie potrafił wydusić z siebie ani słowa.",
      "kr_sha256": "67bb7731103175be26f8ccaefd448a734da92a1e102acab2265f2e7b390722f2",
      "en_sha256": "3766f46ff8cb1b05eba7c0bf3681bc4e25546628e888683c033a5e1a1f3810d1"
    },
    "dataList[id=43].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=44].content": {
      "pl": "W tym stanie od chwili obecnej do zgonu upływa średnio dwa dni.",
      "kr_sha256": "fd8cc841f90e176191205ec5c81fdf6cb50a0c3fec422eb7f76205adeed36a08",
      "en_sha256": "190d71146552ee5a4001896bae43103d6175140163f8fbf87116bfa89db2664d"
    },
    "dataList[id=45].content": {
      "pl": "W miarę jak będzie się powoli osuwał na pal, ból będzie się zwielokrotniał.",
      "kr_sha256": "60325a3e57d3ac9ed353fec1b1a9dc040c22bda8e98971e0488163441d236776",
      "en_sha256": "0d8aab1d77ea1de644a3feb97b3138784f603693ba33287c71930023741b0e22"
    },
    "dataList[id=46].content": {
      "pl": "<To…>",
      "kr_sha256": "1a1bd99c8dad9358b8ed8b50311e9b994bcb045cfa0a96b0fc1d1c2ad8e16251",
      "en_sha256": "8298f1102e835a4af12a52ca3ee5cdd58a9e42ec78c497257fdf4a3126e9dc94"
    },
    "dataList[id=47].content": {
      "pl": "Kierowniku, znam sposób, by odebrać człowiekowi życie możliwie bez bólu.",
      "kr_sha256": "c5d30ede0b8c03e773c41dee76fd48d290e7c59f0f589e8f3f033ea580bb92c6",
      "en_sha256": "9795f1b602311d8129c5dc5e9f70400d43582616c35f29ceb459db1ed6defc24"
    },
    "dataList[id=48].content": {
      "pl": "Technika często stosowana, prawdę mówiąc…",
      "kr_sha256": "237cb6cd182999adb9d06838ffa2694b559ed565fc9ec93a30e09300e0f9fbd6",
      "en_sha256": "76112390320bd10db4c983b35608b0af0f8341936d40e76eba42375284564fc5"
    },
    "dataList[id=49].content": {
      "pl": "Czy mogę prosić o rozkaz?",
      "kr_sha256": "d8fa31ea38649fff26cf8f4a46cd1b688138bd2114e9cd92d040f396abd8a495",
      "en_sha256": "e754386f52c3c6e1f0d6991731955c53369be6960e27f7cf407ed8388a743c05"
    },
    "dataList[id=4].content": {
      "pl": "Jaki był wtedy Sinclair.",
      "kr_sha256": "7eb714359842490304ca5252c2505969c4c1dbbe6a199a724aa2e87d0f49b2b1",
      "en_sha256": "8b54478dae7d0373728773a303df091da7594b028d5e98ed80b1488b0c84bd05"
    },
    "dataList[id=50].content": {
      "pl": "Spojrzałem kolejno na Gregora i na Ishmael.",
      "kr_sha256": "6745234ecc01f3b2cfacd84e2cd2bd3125b5e7530e45b20e8ff064af70a0d950",
      "en_sha256": "1032bc4e43e87a53ee86aa9dbe354a310fde5422d7c6fca2a44b16157b434420"
    },
    "dataList[id=51].content": {
      "pl": "Oni też popatrzyli na mnie… po czym, jakby się umówili, spuścili głowy i mocno zagryźli wargi.",
      "kr_sha256": "57fb6e962ce0bd5d51ee798b3c9590955d1e683163469399ce88f11f33172ee4",
      "en_sha256": "017cfae2b8c17f8d5e12acf26c2b029be90862316cdccca68811ee5865713768"
    },
    "dataList[id=52].content": {
      "pl": "Wiedziałem, co to znaczy.",
      "kr_sha256": "e97362c9b84b4394ebaa098ad51e962574b1a76963e1c16cf8611824bf1d96d7",
      "en_sha256": "6be11d83a0aeb05291fb1363d032d2ca6db78a15225dcd741c717d0b7a6d170d"
    },
    "dataList[id=53].content": {
      "pl": "…Odpoczywaj w spokoju.",
      "kr_sha256": "9448820d980ebdeb9a1c63e4e72a3adba53438d29b5ded92c22069f76a68deae",
      "en_sha256": "96f2ff86922b21aef3300c03a3355cf6ab8535cc57bef39a20b4724fb9838541"
    },
    "dataList[id=54].content": {
      "pl": "Rozległ się szelest kołnierza Outis.",
      "kr_sha256": "c457f11c40393f5256aef9b85edd5d6903908eaa441d36ebcd7c8a9f7a8a2fbd",
      "en_sha256": "d8e30943a1ae6e2a921e03f9c45505955f2c840d4c35c6e25f21f8650e05694f"
    },
    "dataList[id=55].content": {
      "pl": "A po nim cisza.",
      "kr_sha256": "73df661535eb47906695adfbb6284e7c92ba974800a39b7a1f79b562d4925dd7",
      "en_sha256": "5fc2ea8ffaeed82fc63e05bf8f9890e4e061a146fd6217a70e49bcc360c06c0a"
    },
    "dataList[id=56].content": {
      "pl": "Ciszę tę w jednej chwili rozdziera gromki śmiech Kromer.",
      "kr_sha256": "c5f9f9af363c523b49bd2fa862b92ca435422dcce1929c990c981c24a74634f3",
      "en_sha256": "7d9140e7030d712ee3835760002288eff0c5e7a1d7541ada764bed2e2a1dc831"
    },
    "dataList[id=57].content": {
      "pl": "Pff… Pfu, ha, ha, ha, ha!!",
      "kr_sha256": "aaef8e91d898a35e2b61a29dce8b3b435ce4494b54cdd78fb05e448944d2c021",
      "en_sha256": "c298e1ec2e818bacf3cc87516d6c871f32975521e7a57293e9c257f0d605e7b3"
    },
    "dataList[id=58].content": {
      "pl": "Ach.",
      "kr_sha256": "df2132c55e071020e61238c28e57da03164d821b974da358cb7f6b6d12170127",
      "en_sha256": "62991c199e7fec0ffbd83281fe8a6242e522309d690b4898d85b2dfd787d995a"
    },
    "dataList[id=59].content": {
      "pl": "Jednocześnie miałem wrażenie, że słyszę, jak coś pęka.",
      "kr_sha256": "d7fba39069d865d9e735697873d185e5ab85cf5fa1ce73b90def35345c0b5419",
      "en_sha256": "ca77c4b7fc3d5823d6f0f01982273651085a68bae9815621e02402d161f02021"
    },
    "dataList[id=5].content": {
      "pl": "Albo jaki był, kiedy wszyscy zginęli.",
      "kr_sha256": "395bde74fa3d91c4e84ac78a903d4d8b88353be8cfe8746d4ad58e5fc41972c0",
      "en_sha256": "b1303f434564f88b9cac45ce06c257f5323568c692f563902061c7f0b2cccb6e"
    },
    "dataList[id=60].content": {
      "pl": "I tak wszyscy skończycie tak samo, a tak się o siebie troszczycie! Boki zrywać!",
      "kr_sha256": "20696d27c1e04952535d466cfe1e1be3d1e8011c1d7ddebdfe84d5ab70d71c2b",
      "en_sha256": "205dc825e5583230b719a20f6f992694dcada012bc957d0a825e41f65d1f2c14"
    },
    "dataList[id=61].content": {
      "pl": "Sinclair, nie przypomina ci to dawnych czasów?",
      "kr_sha256": "a54507ef7245a60fccd3104ebf2f7a0443ebbaddd979bab44de087ed9c59b35d",
      "en_sha256": "b2c08078c4dd1643ac8243434071b43d9acc201935d496ba8e82f0f73926487f"
    },
    "dataList[id=62].content": {
      "pl": "Twoja mina też była wtedy bezcenna.",
      "kr_sha256": "8316a2cd4dff68d6856c49f301071ad1f265fb9a4b5f2472466b714d106b2079",
      "en_sha256": "1eab7d06729055eda222d7ed58e3d693f532e52da37266e3a86b8fb72398d6e6"
    },
    "dataList[id=63].content": {
      "pl": "Kromer.",
      "kr_sha256": "c135a30e589059cf0acf5aa34ef9c23f90bc81029b6d3443fba7aba1575143c4",
      "en_sha256": "37dc10e55c6e4701c268b31f91904cc00608a027422900d47616c3fa80682b0b"
    },
    "dataList[id=64].content": {
      "pl": "Ty musisz zginąć.",
      "kr_sha256": "ccc6f50508db56b4ce1982c871d67bf59d054a02b5341f8d78cc5fc6f167bf19",
      "en_sha256": "fdce122a485e9b9f7257258c1113d0731c42981923ad8717200a1310f1e72956"
    },
    "dataList[id=65].content": {
      "pl": "Tak. Chyba tak będzie słusznie.",
      "kr_sha256": "804c7b1e1f067ccf4eb6c9bd494a23b132555f209b84a20ef75925c975f4d041",
      "en_sha256": "241bb227798bc24fcb73cabd5d6986c0246043c636fa23af774c3ef5d8f235d8"
    },
    "dataList[id=66].content": {
      "pl": "Zginiesz z mojej…!",
      "kr_sha256": "45393934199519d2736e8c26a493599c1d71b2c3c190cd1a35781e9cab00fcbe",
      "en_sha256": "9b3f77b784ae51b2843b3c747a0d6ba2813d8fbf627ec6906c65dfd8de1e9334"
    },
    "dataList[id=67].content": {
      "pl": "Wtedy usłyszeliśmy, jak ktoś powoli wlecze gwóźdź po ziemi.",
      "kr_sha256": "8fda55f8bc19fc516977756056595c25455c4b513b0ab74017dca47bdc1fbd69",
      "en_sha256": "81f3a88f2d56e78996f3cd3ce6019f424abe30a9132d653c40b8db1d86ee7665"
    },
    "dataList[id=68].content": {
      "pl": "…To ten cały Guido.",
      "kr_sha256": "4f02e197605bdb97a3260d07ef3f1e70fce4a04a134f67ddfe85c3d1f798afee",
      "en_sha256": "5230052ff5c610817332c267e8e5567602798afc91a9f8c19adcd37f288b1522"
    },
    "dataList[id=69].content": {
      "pl": "Myśleliśmy, że daliśmy z siebie wszystko, ale w tak krótkim czasie musiał się zregenerować, bo kiedy szedł w naszą stronę, nie było na nim śladu żadnej rany.",
      "kr_sha256": "e08f1d499df90cc69f74bf55d1bf2bd228bae15a957b84764826708dffc1e89b",
      "en_sha256": "a0c5854521c339e0d996c15fa45b00257c40c198391f6bf9cd8a0826dc02454e"
    },
    "dataList[id=6].content": {
      "pl": "Nie umiałem sobie naprawdę wyobrazić ani szczęścia, ani rozpaczy.",
      "kr_sha256": "9693d9ed94a56daa52fc5bea0c386970d1c2c0d7e88112fc964056bce36a0c0d",
      "en_sha256": "bc1128ccca664322d865bd99fb9f263527de6ad54247df5bc2c91794a017a057"
    },
    "dataList[id=70].content": {
      "pl": "Ten widok w jednej chwili odebrał Grzesznikom resztki sił…",
      "kr_sha256": "a2c5a1b0dc1ac4c4b1b5603877164a9bc6d6a905c0e6769a016714039cfa1cab",
      "en_sha256": "7598251cd31a77d97a5cb9bcdf7e3a0056ac9da098e14ea8e69003262800e89d"
    },
    "dataList[id=71].content": {
      "pl": "Nikt nie umiał znaleźć odpowiednich słów; z głębi serc wyrwało się tylko\nciężkie westchnienie.",
      "kr_sha256": "4a3757f00cb11a9b7166c4a9fb1dcc700871fd4f94f0bb2a13c429fdc41126ff",
      "en_sha256": "6f9da6bcf10f9593054f8051e453b71796f3d8ae546d9e9f2170ccbbe2e5b0cf"
    },
    "dataList[id=72].content": {
      "pl": "Guido, czemu nie załatwiłeś reszty?",
      "kr_sha256": "5fb05045636f2f1338c6f17b001a5846a2129b65340e98490df0159d59b852ff",
      "en_sha256": "4fb5f8323f44c7d8570fe76fbabb75ad9655936b1b32d21e51604407b3bd9668"
    },
    "dataList[id=73].content": {
      "pl": "Wybacz, o Dzierżąca. Albowiem sił mi zabrakło.",
      "kr_sha256": "6a0017a1107c198b383f3082421dfebda53dcd429ec7bf3a51eb8769a2a83d76",
      "en_sha256": "9340204f66f96502aed27e98ee853ecb691628d35b561e51f37337b46a6774e8"
    },
    "dataList[id=74].content": {
      "pl": "Trzeba być zawsze czujnym. Nie wiadomo, co się kryje w tych przeklętych blaszanych łbach.",
      "kr_sha256": "0dbbff9e6ef43f3fc6a628e00015d5ba6aee1b6fa1759efa06a0c568238515b7",
      "en_sha256": "c4d361bc8428aa46ef596fe4123fc86e7797c913d950d831b33863aa36044f28"
    },
    "dataList[id=75].content": {
      "pl": "Zapamiętam to sobie, o Dzierżąca.",
      "kr_sha256": "67ca7623e48c76e8c5083e4eb8c4ccd19dc1f335bc509e41a476433cabd066c6",
      "en_sha256": "70787d7b3079a61ce8104440797675e4fc8725ecc089d722a1c5c1f6ee80c4a9"
    },
    "dataList[id=76].content": {
      "pl": "Spotkanie po latach skończone, to ja wracam.",
      "kr_sha256": "b6349dfaa58f0829d54860dcb54f4eef4254ba62fb81cb733ee4cc70a2132807",
      "en_sha256": "86675c9a3f292881c8bbae0e30647de5a783a1daeb42e9b2a0995040f441bbe4"
    },
    "dataList[id=77].content": {
      "pl": "Kromer odwraca się i wchodzi do płonącego domu.",
      "kr_sha256": "da41ad59c88cf0cdb0d825a61c4f00338da067b5dd5e6a41415b34683ee92a9e",
      "en_sha256": "7fe784ead26bbf290252ce4d11368d65c7eb6d8138dba71e9a7fbd56cc7089fd"
    },
    "dataList[id=78].content": {
      "pl": "Kromer!!!",
      "kr_sha256": "09bb1946770915cf24cb345f5e7ec40e376b141d2574ef85170afa1afa16f9d1",
      "en_sha256": "8e14569d607431cae2e5fd10066967aa1d0222e47ec510761d8e476bbe22421d"
    },
    "dataList[id=79].content": {
      "pl": "Wracaj! Ja… ciebie! Ścisnę w garści i…",
      "kr_sha256": "1d269959a79f416c49ca9e9fd6c413bbd8214e91994f3c7df40a29e3bc30353a",
      "en_sha256": "4da52639ac8df35c2631f7795b3f05e11bf2c8abc7e48e242e83d78a46b8ab49"
    },
    "dataList[id=7].content": {
      "pl": "A jednak mam nadzieję, że Sinclair przyjmie trochę spokojniej nieszczęście, które zaraz wyjdzie mu na powitanie.",
      "kr_sha256": "4651a0d5fbe989cea40e038f7b5edb90b463a44f1b1c55f7164a4e586ed6ccc5",
      "en_sha256": "e3d1370077de12d43126f6fbdb9dce7b94b9a405d1f313d6c0679288f9c0949a"
    },
    "dataList[id=80].content": {
      "pl": "O nie, Sinclair.",
      "kr_sha256": "545856b36375796d92bba7d595d231841f593dce760b49b42f919f2a5bcff23d",
      "en_sha256": "8d152d2acb85a87d6716e0f1558f1ec12505c7326bee330abf7469dc01b1430e"
    },
    "dataList[id=81].content": {
      "pl": "Tak było zawsze…",
      "kr_sha256": "839c7fc6dc240bf6be5e9e7cb288a8ce33092fc428c1c36ee588b66e98646575",
      "en_sha256": "14c939b2e7f67bef8f2cd752ef638a67d9e51cda2ef4b357b013d2d756035f3b"
    },
    "dataList[id=82].content": {
      "pl": "Kromer uśmiecha się od ucha do ucha tak szeroko, że trudno rozpoznać, co tu wszystko pożera: ogień czy ona.",
      "kr_sha256": "db9e6b99d199e54642c0c899df6becb5259630ddf6e323bb0991aaf23f90b8d2",
      "en_sha256": "3fd35ff5ff87798f663d8ed869920b91238b305a2f595d6d72b5539b4fb8bc6a"
    },
    "dataList[id=83].content": {
      "pl": "A potem…",
      "kr_sha256": "4d0f12556d76169b0ce5924587756eecd0545762433e284828695c9acbf39e90",
      "en_sha256": "5fa1b60944e2fadffd54d40865b2fa0a4e46f293accd930091220929bd6101d5"
    },
    "dataList[id=84].content": {
      "pl": "To ja tu dzierżę.",
      "kr_sha256": "8a9d5c81e82ffbe1974af93d32ce0f0082aa18ad2be4ac2d2fdb62b2431277c5",
      "en_sha256": "3d71fabc37c671466e464fc6704647dd7e1270fc08419fa9ae09349487149af8"
    },
    "dataList[id=8].content": {
      "pl": "To naprawdę… straszne…",
      "kr_sha256": "ce3879156d2bd2c5bed954f60b2844c5019afef37fdf991aaedcfd1d0c72e030",
      "en_sha256": "6e26d9ec5d5b9d23c5cb4b1e5b5889970f827dbef21e5d54bb0f7d5d7b3ce958"
    },
    "dataList[id=9].content": {
      "pl": "Dziedziniec, który kiedyś mógł być rozległym ogrodem, był teraz gęsto zastawiony sterczącymi w górę gwoździami.",
      "kr_sha256": "b7842c5045fb5017b08b98fd69fd3683db73f0d4b4bce68b1f5946a76d10740c",
      "en_sha256": "6a725c9a265b85492f15810488247eaccd98c23836a2bd45f4570212239f5947"
    }
  }
}
