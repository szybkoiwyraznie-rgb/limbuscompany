{
  "entries": {
    "dataList[id=0].content": {
      "pl": "Niedaleko rozległ się znajomy, złowróżbny dźwięk wleczonego po ziemi gwoździa.",
      "kr_sha256": "db009c723bfa7c98839eb5de2ba236b775099089b36584df33bcc0cde87334ad",
      "en_sha256": "8140c47c8afcac191157eccd09d0a3aa162221b9afb190b21a045eadcee9570e"
    },
    "dataList[id=10].content": {
      "pl": "Proszę przestać…",
      "kr_sha256": "c09013f15cbb3aa1b88f762881ed24bf80748a78040a256dc33d588b1b61b74d",
      "en_sha256": "c4f61ee224cc8b98a049440e094148b0c3a28b5eb794db566fa6174396805155"
    },
    "dataList[id=11].content": {
      "pl": "Wtedy Saude wyjęła zza pazuchy pistolet.",
      "kr_sha256": "0998f3bc7a90d1b749d9f716eb43fe56b1070740acc25ce580f3964030e09d70",
      "en_sha256": "100e8f332f3bbccbc0e2fe5e31a417a82729dade7fb410930e0ae1526900b102"
    },
    "dataList[id=12].content": {
      "pl": "I wycelowała w moją głowę.",
      "kr_sha256": "bec96861e8f4fff26a64b7af7875f693af6b8104d953e6afc75b2d345df4ef01",
      "en_sha256": "f6daabc4b8d789ade01e2b5fbefd78f9abff3986a4df24319733cf7824b99858"
    },
    "dataList[id=13].content": {
      "pl": "Proszę się… nie ruszać…",
      "kr_sha256": "45078a998377554cddd93e3de4e50609196576a4900c2c52f5367ecded198477",
      "en_sha256": "17156d8d8294211c84645827b0863925672d6c954863f9e5dcec2c923b60bdf3"
    },
    "dataList[id=14].content": {
      "pl": "Jeśli pan cofnie zegar… mój pistolet przestrzeli panu… głowę…",
      "kr_sha256": "7bb0de8c00393a8f11acf7d5ec3241c2f1e5ad40fcfd2e32853d5885be0bcdee",
      "en_sha256": "0d28992e73afa12ef142fe8cadc1708286605c0482b9c742043e79051a18708b"
    },
    "dataList[id=15].content": {
      "pl": "<Saude…?>",
      "kr_sha256": "f48692ed5f5476e8bb0ebd62277485a7b091755881f67e47c4de45383cc3541b",
      "en_sha256": "1aa8fa1f8682339e1d32b4256533818cfbf7412840585432859dcb32537cb6b7"
    },
    "dataList[id=16].content": {
      "pl": "Może pan tak patrzeć… ja i tak… nie słyszę. Ale coś panu powiem.",
      "kr_sha256": "bf4c107eea38a8a0333f1246ab2f2ca513329a74055fbe9d17960c032cb30e40",
      "en_sha256": "719b37e1e63aca24c4da68997cfb02971f37f44329ac61315783e974f6d15047"
    },
    "dataList[id=17].content": {
      "pl": "Obiecali… że jeśli pomogę… się pana pozbyć… wypuszczą Effiego żywego…",
      "kr_sha256": "121c99495e3c17ad1716b65d6c8b51b923aaaabdd2d38f9570c3dce7bacdf3f5",
      "en_sha256": "b674f99f7f9da35408077004e52fd497ce9fd872c73f5af306e094cbe8adb16d"
    },
    "dataList[id=18].content": {
      "pl": "Zbyt długo to trwało.",
      "kr_sha256": "2bd8671e616d75cbf7aacbaa1199a3f3d7357a80225ab4b81b30e736535d74a3",
      "en_sha256": "1cc3b8a078ab94f1af46af3013de1a291700bf4ad7c51b6191ba0fb6207565dd"
    },
    "dataList[id=19].content": {
      "pl": "Guido podchodzi, chwyta mnie jedną ręką za szyję i unosi w górę.",
      "kr_sha256": "5cb1aef89217e688a16806be0ac1edadb95df8efe8de8d1a226425201ce2d30a",
      "en_sha256": "2eedc24e740108d2d4b7af0c9bf7fd2dc20c15c09d83c97c3bcac7c8f7c28aca"
    },
    "dataList[id=1].content": {
      "pl": "…Kierowniku. Pozwolę sobie zasugerować, by odtąd dobijanie dla pewności weszło do podstawowego planu walki.",
      "kr_sha256": "5ba04cc1a7e7103ff6698a8d9e7d062f996fc70f710e89c9d50df60c56798f85",
      "en_sha256": "eff4d51a5a6a0e58ac59b5dfcdc50f59efc4504469ffd36819455b0cbb5487fc"
    },
    "dataList[id=20].content": {
      "pl": "<Kh, khhh…>",
      "kr_sha256": "e09fb9c062cec14114a1377fb851f89d96df98436e933906348f7d32d33d3a6e",
      "en_sha256": "757754d9847733c45f6c1d9103664703a2a2e7957731bcf2a862d1a998bff54e"
    },
    "dataList[id=21].content": {
      "pl": "Drugą ręką chwyta moją głowę i ściska tak mocno, jakby chciał ją zmiażdżyć.",
      "kr_sha256": "9272a7152744ed03327ba9f674f24239f82d62a9bd66bad318f294fab633e79d",
      "en_sha256": "dbfded3f7757960a667838b22caf9819f0e180ad5bda3d8239ec5d9814c613e6"
    },
    "dataList[id=22].content": {
      "pl": "<Ugh…>",
      "kr_sha256": "7911e4ddf95ca5d33e4a354a62ac5d4c83c6929ce89f689ba22b12c5a4420a7d",
      "en_sha256": "aad51d3cbb997a7bb57b545894e427b72bd0930b2155d63ff1609821bc91cd71"
    },
    "dataList[id=23].content": {
      "pl": "Zgrzyty i brzęki raz po raz wstrząsają moją głową.",
      "kr_sha256": "793a0394372336e1b4da00235180606842bb74169385f41fbfeba084b3e68c3c",
      "en_sha256": "eb34e65de3e512eab502188159e791b05c3b61cbbecbd3f7e5a4a4edd69e9554"
    },
    "dataList[id=24].content": {
      "pl": "Ogarnia mnie strach, że jeśli jego palce wbiją się we mnie choćby odrobinę głębiej, roztrzaskam się na kawałki.",
      "kr_sha256": "95ee659996703a67d9336a06af0dc68382624b59fc00b7cddec121c02e27b162",
      "en_sha256": "797453b043f668597363b030a8d6317db2a3c20dd4e84dde8059663df9d0a812"
    },
    "dataList[id=25].content": {
      "pl": "To już koniec? Tak umrę?",
      "kr_sha256": "1917674c4d6f51574f024329a10815181c90b6fdb278d297b4cff5501a6d8484",
      "en_sha256": "126bd2c82a6bf786d8157110cf18f2a957061738699b994c11c85dbb553a5115"
    },
    "dataList[id=26].content": {
      "pl": "Czy gdybym był choć trochę… lepszym Kierownikiem, skończyłoby się inaczej?",
      "kr_sha256": "5c50b5ed20b2c1c39526e94c92bb7f45b512bf3372fd2f27a00d00814f764735",
      "en_sha256": "30e67804fce03396a856bd49c64b35029675e5a4f35ec622f89e385255793eb3"
    },
    "dataList[id=27].content": {
      "pl": "Przypomniał mi się Heathcliff, który kiedyś groźnie dopytywał, czy nie da się jakoś sprawdzić, co właściwie siedzi w tym zegarze.",
      "kr_sha256": "4d36899ea582361a0f9827bd60fb5eda2c7f1058f29366ecd7203ce706bd0d59",
      "en_sha256": "41367b64d3f5e6c96578769766d71eb0eb3cab98bf3d7446e03b4b2e91e958e8"
    },
    "dataList[id=28].content": {
      "pl": "Szkoda, Heathcliff.",
      "kr_sha256": "cda3115e6880c7ec59916459a07c170fccf185ab89ed0c1835b71e84866954f9",
      "en_sha256": "96b633f76d660ea1b58f223e5e9d51c6fed6da52ccb15a2f5bc30502323d301c"
    },
    "dataList[id=29].content": {
      "pl": "Że przegapisz taką wyjątkową chwilę…",
      "kr_sha256": "2008a1573f05c62c2a54d5b4eef5d01b1d8666bc1371256fb392de02b84334fd",
      "en_sha256": "4312200fce642d992e6d68a06d8e6d38bf8196beee36a76d689b330c28c7d18a"
    },
    "dataList[id=2].content": {
      "pl": "Jakbym się już tego nauczył, całe ciało pokrywa mi gęsia skórka.",
      "kr_sha256": "a1a9b44948454535a488ba004cf5bb3b2cf5be05f46f4b75411bf46758333ef7",
      "en_sha256": "9aa2e9e22daa77b491720df3dcb75c26c1917c48512a894251fabf9ab1619ead"
    },
    "dataList[id=30].content": {
      "pl": "Rozległ się jakiś dźwięk.",
      "kr_sha256": "2d5fd9c36caca65bd837b1878cbbcb07a4d3c8d202a1c600e50a10330bb91775",
      "en_sha256": "4e4951a386508a36e84b4e28450846a4426e2431aeaac3845ff2f11d59a360a7"
    },
    "dataList[id=31].content": {
      "pl": "Odgłos, jakby coś roztrzaskano.",
      "kr_sha256": "d54b7c3e4f3ca2f84aa6083eb96d16929b986f56f294d241ec93462d6db2ed62",
      "en_sha256": "06ee693c95b4756f4f875c597a9003f967b7a002818759da9acf55a934d4308c"
    },
    "dataList[id=32].content": {
      "pl": "I na szczęście.",
      "kr_sha256": "4f3e182209b3413d2fa472c00454523b016b9a23522cd983b2c379f490890202",
      "en_sha256": "b6e098baa5ac957e35b6eba29dba8e3e1c32413334b18bf75c953539017146ac"
    },
    "dataList[id=33].content": {
      "pl": "Ugh…",
      "kr_sha256": "2b72cf03f43852c71dbbeee106a23c7df1786039c4c682ccb6769046a90ee697",
      "en_sha256": "74876ab9ab446335a93517e1cbf64ffd062d8bb5a78ea3504ad370c26ecda5e8"
    },
    "dataList[id=34].content": {
      "pl": "Nie była to moja głowa.",
      "kr_sha256": "ca78eef8c08fa66e5b3b4c4f2e6ec110e7b245e7f6c50a76cef70babae6f97c6",
      "en_sha256": "1fb56f3332594ea5a9847de7c399362735969b34b5499ca71a0a88ffbd2be166"
    },
    "dataList[id=35].content": {
      "pl": "Ha, haaa… Ha.",
      "kr_sha256": "c98b310d222ec0decfb8cebf80acbb6fa99b172239615a78e1fb730c2e6b03eb",
      "en_sha256": "92c4a252d7cc9ad42f0c2c266c8ed07806c812280c2cc2849db715f0c56e8828"
    },
    "dataList[id=36].content": {
      "pl": "Guido zatacza się.",
      "kr_sha256": "d20e56b0c8f81bd0b9e4a9ec38ab905bd9942dbffd120181ef5e41fe3f02e912",
      "en_sha256": "5a713250b564a95789495c5834935828687f7aa563ee8f6417a10fc92e705c59"
    },
    "dataList[id=37].content": {
      "pl": "W plecach tkwił mu gwóźdź, a za nim Sinclair z trudem łapał oddech.",
      "kr_sha256": "4bae09decdfb23ae1ad3ca77647fabaa21680c423ee75edf6cf027542b0db499",
      "en_sha256": "c8e242fe0712cafb7d606a2278569c08447ab3a68953df344dfa261643d3f361"
    },
    "dataList[id=38].content": {
      "pl": "Jeszcze przed chwilą leżał na ziemi, ledwie przytomny; nie wiadomo, skąd wziął tyle siły.",
      "kr_sha256": "593f45a92c7acb133019c57320460356021ab8f557bf0e447b0874d3b4f9918e",
      "en_sha256": "1532ace3b3ef3355291d982d205780f9a719b1c803ae34342c48a36b880068c9"
    },
    "dataList[id=39].content": {
      "pl": "Dzięki niemu wyrwałem się z rąk Guida, ale…",
      "kr_sha256": "9303d01edbfb0a8175ef08346c24201fc55dc99b4dda6b3a4691216ce5fa8cf0",
      "en_sha256": "e42fd726b3b5d87cf24f1bf342b44f29351d94bea6e17661bce4ba588ee88df4"
    },
    "dataList[id=3].content": {
      "pl": "Heretycy… muszą zostać wytępieni.",
      "kr_sha256": "76ef87d3eb7ef6b84b8a72feeb94d03895fd158e27195461efbbca3303d84a3b",
      "en_sha256": "31247b18471b2e97489e41d3546d51f95baeaae1f490ffcb9d007bcfb1754087"
    },
    "dataList[id=40].content": {
      "pl": "mimo ataku Sinclaira Guido wyrównał oddech i powoli się odwrócił.",
      "kr_sha256": "663ec48926744f1294f1c1ee4a2bd4040aa8dbba034b9f934cd20c9460ab9a59",
      "en_sha256": "77ddb840923ec372c12b0a882dce5c95e2a727572139df750b372047e5f6eb52"
    },
    "dataList[id=41].content": {
      "pl": "…Oto jak.",
      "kr_sha256": "b557a5f2bc967b8c14cf5a8e8b41767d710d3040264401de718b3d24410fc422",
      "en_sha256": "0224b354b47acb1c800f601ec51cf6396d0fb6808b384f562d0dc39f22a78b6c"
    },
    "dataList[id=42].content": {
      "pl": "Więc i ty jesteś heretykiem…",
      "kr_sha256": "0fa7c33794288e70f937ba3800394693188cfe8b6af602471fd6e82a5341709c",
      "en_sha256": "c7318fd4c3d38ab31038e5d1a58090317fd8a8d3b5b0f8f71ac9d654fea76ed8"
    },
    "dataList[id=43].content": {
      "pl": "Wy… wszyscy jesteście szaleni… Nienormalni…",
      "kr_sha256": "c3dc1f4f06a90e336b09a91c29ba172b0a5f637aaeda3ee4c7db87e64769fd87",
      "en_sha256": "a3ecadd98646413699a30a66db8a74da5a4ddaa53869e5a1e2584293434ee3ad"
    },
    "dataList[id=44].content": {
      "pl": "Dzierżąca rzekła niegdyś…",
      "kr_sha256": "b10a2669820dabfe90f47c0c350239008f9c0067107ef16c5a93ad2cacc2d1af",
      "en_sha256": "bea74146404920033d92a475c91e96415776c8ded839781e1285428e99e4e5b0"
    },
    "dataList[id=45].content": {
      "pl": "że i ty mógłbyś być tym, który dzierży.",
      "kr_sha256": "58186af6d5fb1eaa5825534bab6b8d7474b85f7d531daa61fedb58d5ec4b2462",
      "en_sha256": "1d5b10b0a32bd92ecd9fbc9df41dd37b32a6be6e60f70b85728b09cae2440c88"
    },
    "dataList[id=46].content": {
      "pl": "Wszelako…",
      "kr_sha256": "f8f7171e81ee55227099bfbd7f3e7318d32f4b304a3aa80bee0aaee5e4dce974",
      "en_sha256": "6f9020adc87747b2368e1e6f733e80b3574d99575f0d670200cc1c9e4921445a"
    },
    "dataList[id=47].content": {
      "pl": "dzierżysz nie w tę stronę.",
      "kr_sha256": "789175eb7775f7b9e884265f1dd8f2a072664d41e5f34e986184b540bb837fe0",
      "en_sha256": "61a12e519d0baacb7e31f845997f3dcbe045202eca5fec9ddf3d8c336cdd65ab"
    },
    "dataList[id=48].content": {
      "pl": "<Sinclair… uciekaj… ja… nie mogę ci pomóc…>",
      "kr_sha256": "c3b1e38a78947b1b433c48b2b53964dac703f8772161fe2253dd985c87dc4413",
      "en_sha256": "2cfcd8a78caf7e3a07f6074a8f5e1bd5357f8f73b26ce27b316d0dee93f0b5bb"
    },
    "dataList[id=49].content": {
      "pl": "Nie… Już nie będę uciekał.",
      "kr_sha256": "63f93b56017553820489024981b7889fcbaf5fe083c0624b732f4e810d557178",
      "en_sha256": "d7abaef8620ac5efd42c00eaf707e01a4f0394d71ec960640228e48c27d663df"
    },
    "dataList[id=4].content": {
      "pl": "<Od kiedy on tu…>",
      "kr_sha256": "661c5bc8e9774b54a8e3a6dad951bd00a4e7ccc01d4747c5b37dfe5cf61436c9",
      "en_sha256": "52f72a75854897d884ab10e2f8c983b54c810c36d07e2dd9c452a914b3bc1e6f"
    },
    "dataList[id=50].content": {
      "pl": "…Dobra odpowiedź, panie Sinclairze.",
      "kr_sha256": "fc05154117fcba352fb6a6dbb796a6a183ab154be37098ebefed76fde5b354ce",
      "en_sha256": "a7e087418b79515feeb0728765ca3542a29be579081f29ef688255f2905a1354"
    },
    "dataList[id=51].content": {
      "pl": "Huknął strzał.",
      "kr_sha256": "a36091908677d2314ab0f336db298a128fcac2c1e74c324ce803e0e01c9396ca",
      "en_sha256": "1ef5e3fc24658830263c0cf3301132af70b0b1ea9b45988b2256758507607337"
    },
    "dataList[id=52].content": {
      "pl": "A kula przebiła głowę Guida.",
      "kr_sha256": "93e66cd096b23bde8418434119385cae9e2264ad80f1768573b7573100d6a045",
      "en_sha256": "37585ad87d71da57113f35551b804dc4bb787c818e8e67608e286636fa72c4b9"
    },
    "dataList[id=53].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=54].content": {
      "pl": "Wy, którzy sami ściągacie na się zgubę…",
      "kr_sha256": "479ea73c1751d3315e8b379fda4b3a96e551b5ff61a2da2992c0be53f1d927d9",
      "en_sha256": "89f7205dbae636c3a392b3afb3e15af726b65fee7b90c48741864995b18feb50"
    },
    "dataList[id=55].content": {
      "pl": "Młot nie przestanie was ścigać…",
      "kr_sha256": "1bd9b2d68aa2095da55ede8ba1494f142ab281d53ed7ae3090dfa03bc0f15b48",
      "en_sha256": "2785d562e4b6fd663bbac5ac9170eddb606231c80df772fd2d8587ebf54a36e3"
    },
    "dataList[id=56].content": {
      "pl": "Na tych słowach skończył.",
      "kr_sha256": "e3017508f6b86ab301118fb0b4a5d3d387bc4a04628ad0833c1a02a7f5016ccd",
      "en_sha256": "28ee9ce62afdae84723af11321926ad9dbb6a6b48d8d25a8b58e9056bab9f4a5"
    },
    "dataList[id=57].content": {
      "pl": "Guido upadł i już się nie poruszył.",
      "kr_sha256": "c89eaf8d400a8703c8679cf85bee1fa547d8b81f18d4e0ae30c21aff7786d5e0",
      "en_sha256": "52aff6599493efcb1d3420b6fe85789d44b5916b021c2747fe9e2c3617c046d6"
    },
    "dataList[id=58].content": {
      "pl": "Nagle.",
      "kr_sha256": "14a334dd10b0165c58dff2b2f94d20c38e9ffd79e7439ae6d4a920a3ea202f4d",
      "en_sha256": "4ab161a407a881a5b48eab42f142067e1847f39742ac294d37fde2e67a33b790"
    },
    "dataList[id=59].content": {
      "pl": "Rozległ się stuk pistoletu, który upadł na podłogę.",
      "kr_sha256": "dd841908518390d871b1c42d79a01ac2e6acadd30b460f0e573071dac1bfedaf",
      "en_sha256": "e8b9c11ad43d274b65b3d5f1e7169c674ba859662f2b7c602581a42606d02baa"
    },
    "dataList[id=5].content": {
      "pl": "Guido zbliża się wolniej niż poprzednio, ale nie spuszcza ze mnie wzroku.",
      "kr_sha256": "214edb7a1e8d8768857982240004944ff8f9da9a5f3bfeb0335b8441d0a1e5b2",
      "en_sha256": "90afea860220e4c50fba06f784cfe4487e68beaf92e6130ac21bcf8a3df73f59"
    },
    "dataList[id=60].content": {
      "pl": "<…Saude.>",
      "kr_sha256": "f10f881151113e6e78f0b0fdab313da3cb3cce3afde107ad8032ada0d2088f87",
      "en_sha256": "a738850a1c652d12bcf4a18ae473ef98d79deb8f975268cac6e2672124879c39"
    },
    "dataList[id=61].content": {
      "pl": "Effie jednak… nie żyje, prawda?",
      "kr_sha256": "3c3b05295deb8101f5895f1765f8604ab8162a2d35083a6b78da2dda9fefd716",
      "en_sha256": "719ad50cd234c36326911431dbf0cdefa4385dbaf36c563644c4a9910c47e1e7"
    },
    "dataList[id=62].content": {
      "pl": "Kiepsko państwu idzie kłamanie. Jak już kłamać, to chociaż z przekonującą miną.",
      "kr_sha256": "ed2b23508fa341df42040f0e1ea36944e284aad3c09643aca52f7d83a0a6e3dc",
      "en_sha256": "25f4158eeb81982c364b7ead065d1418a4188f7abf88e47f0c116d7c87cfe606"
    },
    "dataList[id=63].content": {
      "pl": "…Saude, chodźmy stąd szybko. Zatamujemy krwawienie… i… będzie dobrze.",
      "kr_sha256": "534976a558b3731e11d0c7593d55ed2b1959492198c5a023ec93bde097dcd4eb",
      "en_sha256": "ca3d363ec08b892875a6bd507eaaf1d3402786726ec58a26d8d5307487db9308"
    },
    "dataList[id=64].content": {
      "pl": "Właśnie. Wezmę opaskę uciskową…",
      "kr_sha256": "cbf18095f00013a0c358735f26c9c672e9e7438ff876edaa033c56d39d75392c",
      "en_sha256": "09136252fd2ea700ede83c652e357f5cf1b170af0c3f5ed6529e5742913c15a6"
    },
    "dataList[id=65].content": {
      "pl": "Co państwo opowiadają? Ja się ledwie ruszam.",
      "kr_sha256": "afbc6a21c740c8e63138ad7122a10f0a4542784a2340401fc59d0309f80bdf3f",
      "en_sha256": "8e67f04ea0932cbd244b37e125743d171413608aac0f51a5025e4e84b23e99ac"
    },
    "dataList[id=66].content": {
      "pl": "Poza tym ci Inkwizytorzy będą tu ciągle przyłazić, prawda? A państwo muszą schodzić dalej.",
      "kr_sha256": "80285d89f2cd3ee35afbcc8ae050d02a55a78b607601754cce4e2df215e70b0c",
      "en_sha256": "2533fbd1bae99ae056e6148e54e5f7c6c7df8031c4953902ea9888e2fcec51b3"
    },
    "dataList[id=67].content": {
      "pl": "Zostanę tutaj i ich zatrzymam. Proszę iść.",
      "kr_sha256": "257a86ec9a1dc7d19637e1005d12a8fe1b4d4438d4e82edb9742a5db1596f132",
      "en_sha256": "0912d9e47033eaf4e6e5397d024a484875f72f59505f0a028e7a4b435933a447"
    },
    "dataList[id=68].content": {
      "pl": "Jak… jak pani może…",
      "kr_sha256": "d53a51e812918537c08767a87c72141970e7544f8e8ed97cf22a83a771862cd6",
      "en_sha256": "582545e4f0d897c457a86138528693f511f8c37fe8eaa236519868847bf6e4d9"
    },
    "dataList[id=69].content": {
      "pl": "Sama pani mówi, że ledwie się pani rusza. Jak mamy pani powierzyć osłanianie tyłów… no jak?",
      "kr_sha256": "babc7cb547cde135c93aacade9ea1951fa29630be13227fb9a9c8581b0e7224f",
      "en_sha256": "7c40e02f3f744a3895e240a030f4a40862bf01c8d96cf4bae0f5d768f6cb420e"
    },
    "dataList[id=6].content": {
      "pl": "A reszta… zostanie… oczyszczona.",
      "kr_sha256": "8bb2bda2cef9566792e45eadd998dcaf1aa997a2228cdc8a53e433e93502ccf6",
      "en_sha256": "50535b587c0838404ef6e71f172ef8b7176f7ef7834d91d727688e02c2904257"
    },
    "dataList[id=70].content": {
      "pl": "Słuchajcie… w takiej chwili… wystarczy kiwnąć głową i szybko zostawić temat, o tak.",
      "kr_sha256": "7e409cba0c0f913b79d9e092abe8cc114976f04af528e741845a57dd2a9cf0db",
      "en_sha256": "8835dfc5d036001f00aa136cbc26ffa48b9dcfd43ba5748bfebf2958ce0ed115"
    },
    "dataList[id=71].content": {
      "pl": "Co za brak klasy, martwić się o kogoś, kto zostaje.",
      "kr_sha256": "621033a74c80e8e443aa3cc00e3e3a1d623331d233abd12d765608efab8842a7",
      "en_sha256": "67ad50946315653159305547714549df42adaa9c234ddbae06bbb32eb81d3d92"
    },
    "dataList[id=72].content": {
      "pl": "Ale… ale przecież…",
      "kr_sha256": "c2fc8fc1b5a71d8d4c3c0277daf940af10b48b5b9260b69764f15d47396efc7a",
      "en_sha256": "dd0aec4778dc326cf253e06b754125d359b5185781898949a5db36dbe5d4003f"
    },
    "dataList[id=73].content": {
      "pl": "Ach… wiedzą państwo, jaka to żałosna scena? A tak ładnie mi się wszystko ułożyło.",
      "kr_sha256": "3868447f1abd94d2580fd13dc128a87a95e6fc0d9862dec5f9447c925004e850",
      "en_sha256": "74d2450351e47c8fe2585a9321ff8037e4e8f4abfe517071a30c960315f92456"
    },
    "dataList[id=74].content": {
      "pl": "Faust, niech pani szybko zabierze stąd te głąby.",
      "kr_sha256": "bde2cd66a4a3bc5ceeb5fe4303567c9772c30092b6d70a08cedca3562f19a771",
      "en_sha256": "409b22782cab4b535469ea9d59850959234ff8834da9b124557e8d5229b5da52"
    },
    "dataList[id=75].content": {
      "pl": "Przekażę panu Vergiliusowi pozdrowienia.",
      "kr_sha256": "a42231d0f120fab1d6d6689c0c279479de16dda55bcaafc4b59a9b14a8fedea5",
      "en_sha256": "a2ac6a5d7f30554f232789f59514d792b6e061ba2706a8348c56f3cc0ae0826a"
    },
    "dataList[id=76].content": {
      "pl": "Jakie tam pozdrowienia.",
      "kr_sha256": "efe3ca4a112efe59598eb097a6524aeb84314e6c9631e2152abf601fc73b8a11",
      "en_sha256": "692645bf5742aeb6cfc4475f79f93d4f47bf3af162a41c7cc119f6273691fdfc"
    },
    "dataList[id=77].content": {
      "pl": "…Proszę mu przekazać, żeby kiedyś wpadł się przywitać. Wie pani, co mam na myśli?",
      "kr_sha256": "93ed9f0af8087679198c8f82da9e3002f35fe660f871b564f05a60afc994cfb6",
      "en_sha256": "f407b51e209a3110c5790fba49762442bd88c0886fb69fe6908e510800c24d95"
    },
    "dataList[id=78].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=79].content": {
      "pl": "Tak.",
      "kr_sha256": "8445741d7d6a831276e8794b874cebee94940ba0e963d4f109bf72f437426789",
      "en_sha256": "404cba15a4acdcfea85caa97d009b1042d20f0967c26f9a1abf59aecbeddf9bd"
    },
    "dataList[id=7].content": {
      "pl": "Musiałem cofnąć zegar.",
      "kr_sha256": "fd2b3a365f78ea510de9af7dc57f2a6aa75f51a27467ed1d25301feec6cfd7aa",
      "en_sha256": "b09de79d8ec667b1d8cbc011dfa775b87cc68651b8314b2a29f41fb4b8984bfc"
    },
    "dataList[id=80].content": {
      "pl": "Zostawiliśmy umierającą Saude i ruszyliśmy dalej.",
      "kr_sha256": "e3027dc3998801a6f506531d935c25f48845409397510a79553c7b28071c127a",
      "en_sha256": "ad914c6fe49208fabd38f1de30a2562e426f281cd2387d66517d6210cae33346"
    },
    "dataList[id=81].content": {
      "pl": "Przez długi czas nikt się nie odzywał.",
      "kr_sha256": "b220b74507616b0200f3de6750d18f20387c3f5e32467707c4ba420f8db7fdd1",
      "en_sha256": "65e6e9960fa18ddfa95bb89953529519496cef21881b6b9c58dcf19c6a3e3279"
    },
    "dataList[id=8].content": {
      "pl": "Większość Grzeszników była ciężko ranna albo martwa.",
      "kr_sha256": "f8c8c8939aa964321191d598eb578acba456603888602fc99151af6664f289cb",
      "en_sha256": "137133d95ca73b34412ca0c2fa01ad39c7b5542cbc6370197d6877480045617d"
    },
    "dataList[id=9].content": {
      "pl": "A ja, praktycznie niezdolny do walki, i Saude, która ledwie oddychała, nie mieliśmy z nim szans.",
      "kr_sha256": "e77f34cde0bc1c66f0c22c4ffd2f4f3aefc56860d48c2a32e042005ae0779755",
      "en_sha256": "4f694da628c2d02209e07040e8575c194866b9d2823ea1e15467224544728f67"
    }
  }
}
