{
  "entries": {
    "dataList[id=0].content": {
      "pl": "Ukradłem po kryjomu klucz do piwnicy, tak żeby rodzice nie widzieli, i zgodnie z umową zszedłem z Kromer na dół.",
      "kr_sha256": "32e8f2ef62ee422c33090e2c1f6d62b1336c507b4c05d2c5f266b89d8c880f0f",
      "en_sha256": "55cca0b25518f9b679f01da5aae7c6adc436d240b2bfec63824d1bee4800b400"
    },
    "dataList[id=10].content": {
      "pl": "Choć wiedziałem, że na nią takie słodkie gadki nie działają.",
      "kr_sha256": "80200d238442ce91eb883cabd66c7b194a4c6b9b935df82b933cf44a3a68f8cd",
      "en_sha256": "7b98b959b8c6a384247036d51b8d7963811fffc2dd65b29e84068c08cc28f18e"
    },
    "dataList[id=11].content": {
      "pl": "Ale nagle ogarnęła mnie zła ciekawość.",
      "kr_sha256": "c6f1535e80fd6b4d6b837bfccad0457bf479f34cfa18e7a6a8c99b04c10a734f",
      "en_sha256": "85beaa2c61c39033ed6ac550c878517ee247f34cf12af77ea6932b406088f26c"
    },
    "dataList[id=12].content": {
      "pl": "Po raz pierwszy poczułem, że wkraczam do tego samego świata, w którym żyją złoczyńcy.",
      "kr_sha256": "f8714b07cefbd11fbd5a1d9974e9067e8d7b248348bc76214e76c82821462736",
      "en_sha256": "aaacb1c0abd98854c493fdd96aed62f8d3b92670d2407c80dd96097cb296e046"
    },
    "dataList[id=13].content": {
      "pl": "Dlaczego?",
      "kr_sha256": "303a49a0f6b65f1f9a438fa94d25cd9d2d676fb09bc3c90049a48b6586282828",
      "en_sha256": "b1f4eb91d54940209f6ede2d8fc27c267a630b10ec6700b4ae8389cf048943a6"
    },
    "dataList[id=14].content": {
      "pl": "Zrezygnowałem z powrotu.",
      "kr_sha256": "e1a0d2f76f61be97863977dd1ddcb92b70f082306804d534c9ab1082272d468e",
      "en_sha256": "c80617f13e86ffe4bcd4671b97ed8678837af35a8a17342fe651810eaf5796a0"
    },
    "dataList[id=15].content": {
      "pl": "Choć wiedziałem, niejasno, ale na pewno, że to ostatnia szansa.",
      "kr_sha256": "51ec1959fe1be24d32815e69cd3daa8baa056d6a0ff0992202c0ef48dc2624ef",
      "en_sha256": "aa8e637c71239e839e5672004d349ed1fd3e124815da65819c82423d829d2d87"
    },
    "dataList[id=16].content": {
      "pl": "Ach, ten widok był tak potworny, że drugi raz nie zniósłbym go za nic.",
      "kr_sha256": "f49274091512d41547371cff9bede44496ea859e65ee692d02f9ae92bd80ae16",
      "en_sha256": "50ee53726967f93be8498aa0118507e2ab7419d82abbb7c9d802fca30f85a96e"
    },
    "dataList[id=17].content": {
      "pl": "Czy można to nazwać po prostu potworem?",
      "kr_sha256": "5c1f2aea983078f7c0e8a236a4c3d5fe2f2a736d0cbb8e304482ad27fb232347",
      "en_sha256": "b7ede65893fc275ea4ca34b7f594a4cf380a81b41fe32b255685c5708e376090"
    },
    "dataList[id=18].content": {
      "pl": "Na to wydawało się zbyt rozumne, a na człowieka było w nim coś głęboko, okropnie nie tak.",
      "kr_sha256": "80d4918d84468ae17069a774bf7b0e4d06e08a96744c96d02f7204a023594f93",
      "en_sha256": "b64328e07bb905b7fc9c538ea907adc7fefbeccd255d09c3d45f9ab4879a9207"
    },
    "dataList[id=19].content": {
      "pl": "U… ugh…",
      "kr_sha256": "c2a2f43bb6ca62505774998481309e6f8c80c5bb9c0b7b80b4802a5f22f4da24",
      "en_sha256": "0677d0d9defe575a41c211a765f5d32f59f70f42090d3c4512166f655ddaf35d"
    },
    "dataList[id=1].content": {
      "pl": "Kromer zaprowadziła mnie do wąskiego szybu wentylacyjnego w piwnicy.",
      "kr_sha256": "3823b9b2c48cfafc4d62f876907210edbce269ac6a6499326c468697aaf7381b",
      "en_sha256": "c600b8c6bae55e9af0461266838c4cc1708a4ba7907a30f2f363ee3f72618fb6"
    },
    "dataList[id=20].content": {
      "pl": "Trzęsąc się ze strachu, zacząłem żałować, że postawiłem stopę w tym świecie.",
      "kr_sha256": "c2f675a7ee20abf577b747dbdc62d19125a0f91489b16c28e584bc646f8bc2d1",
      "en_sha256": "126c865f535002389f88bb69fb10e8b10b22a455e52403a47335bb3ddefaea4e"
    },
    "dataList[id=21].content": {
      "pl": "Dlaczego zawsze najpierw odtrącam szansę, a potem żałośnie modlę się, żeby jeszcze raz się trafiła?",
      "kr_sha256": "9f6c7ef7e4576251d3f54122074a171ba7c60154ffcc672f85031620c0206419",
      "en_sha256": "ca22d96874f596501446117ff40e1aa1f26467b892095aa40de189620ae5118a"
    },
    "dataList[id=22].content": {
      "pl": "A razem z tym żalem wwierciła mi się w głowę pewność, że tego widoku nie zapomnę do śmierci.",
      "kr_sha256": "6c64a4b658caa3bd41da736fd859128733a2d711076a8225d528a24617a2a299",
      "en_sha256": "4ac3f7ca0c20774b11915d957a8d8c5190c7b17c1ff17eb92668a28478c7b8fa"
    },
    "dataList[id=23].content": {
      "pl": "K… Kromer… ja… muszę wracać…",
      "kr_sha256": "bb9200db5dfa5e706c03f6517d928e3f635bfe0e4a7a9fad0c363a9f4d9c25ca",
      "en_sha256": "f640e3132098a1359a5dea92c6ee6fbf7dce76d2b0836efd664a1d83e7cf6cd8"
    },
    "dataList[id=24].content": {
      "pl": "Ale Kromer była inna.",
      "kr_sha256": "bfb420f661394990aee70dfb4b587b1cbb219bef548176f07efaa884aeff99e2",
      "en_sha256": "a118deb321911153f5ebc1b73c6a7ab5efcd9826d7c004d6230ed3510a420e81"
    },
    "dataList[id=25].content": {
      "pl": "Patrzyła na ten widok bez końca, upojona, jak ktoś, kto w zachwycie stanął przed czymś wielkim, czymś na całe życie.",
      "kr_sha256": "b0fdf9e9e0822a533d5348fe8f31372fa8b272cfe5b6dab5ccc5e4b56cd09175",
      "en_sha256": "633fb484815340e04aa47a3fc32147c1505f85e4f845a5c63ae379d02edca79d"
    },
    "dataList[id=26].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=27].content": {
      "pl": "Zostawiłem Kromer, która chyba nie słyszała już żadnych słów, i zacząłem się wycofywać na czworakach.",
      "kr_sha256": "d4843f49555d2ba7e1cd27e721925ac23f723821a703c8c8781b32574d049737",
      "en_sha256": "239ecdb26f65eb6971d1c329e2a8211583849bf58b0a39e638faa66056ca74cf"
    },
    "dataList[id=28].content": {
      "pl": "Dlaczego coś tak strasznego łączy się z naszym domem?",
      "kr_sha256": "110326a5d39a912f97403460fdf2bfcd620ef7e610eefa6371868c6f5fffdf0f",
      "en_sha256": "dd4d9fbbd763a133c45d228d553cf7fac6beab6406b53785580222d4e9341d45"
    },
    "dataList[id=29].content": {
      "pl": "Skąd Kromer o tym wie?",
      "kr_sha256": "57822c32e787d9facf1123954088981d101526d131c9abc7cee0b38c6e17f048",
      "en_sha256": "edaeb75da28d6953c4b0f1a624bf7e5db2a6d06e11b55f63f0466e76dc79f486"
    },
    "dataList[id=2].content": {
      "pl": "Długo czołgaliśmy się szybem, aż poczuliśmy ciemny, gryzący zapach, a gdzieś obok rozległy się odgłosy, jakby biegały szczury.",
      "kr_sha256": "1b825e540dc66cc828e68f3eb1b915267dcf6be7b45b4d585b58f6cc517c2fc4",
      "en_sha256": "c6db509e1eb367ea78f87c2386dc394ec46e57bd518b78111537115bfd954687"
    },
    "dataList[id=30].content": {
      "pl": "Dlaczego Kromer się nie boi?",
      "kr_sha256": "95ccd55ae9a961059bce169a35ca738a0fe1fed83600fc991882c7ea10ae9357",
      "en_sha256": "235c79c6fd533eb43b96f6f1b3146c1045a6cd669c62f7b30e53c0e85b7ccf30"
    },
    "dataList[id=31].content": {
      "pl": "Miałem wrażenie, że wiatr niesie za mną jej mrożące krew w żyłach pogwizdywanie.",
      "kr_sha256": "104218d92835df54435612b6f3c32156eb4c55a9ebfffe6fc29e8adda1eaa727",
      "en_sha256": "08c632afb4f5f315ae48bdbf10eb4467f5b00989c35cabb0db94043269c5b6ae"
    },
    "dataList[id=32].content": {
      "pl": "Następnego dnia Kromer przyszła do szkoły, jakby nic się nie stało.",
      "kr_sha256": "886235b10bfaf7167dc99d411d943c098a178cde21bfe67c05349d4dd7a6b6a5",
      "en_sha256": "5069d3e5fc9b4f6fc41f70911560aacc10aba56618b38e13fcc6c7d9707de394"
    },
    "dataList[id=33].content": {
      "pl": "Sinclair, wielkie dzięki, że pokazałeś mi coś tak cennego.",
      "kr_sha256": "0f5c77552368b6dc39bab1d65fa59f2277266ba432e2932b75c4dd2521ae0cd0",
      "en_sha256": "95ce13cd48a9d1f2df7b69daa6179614fce16b43a779a5d54072c85f8a67a0b4"
    },
    "dataList[id=34].content": {
      "pl": "To w podziękowaniu.",
      "kr_sha256": "652b6da2cdb2bf31da21d988cdfdf6b73d8a850dc17e8b7bc8b4cac63fb5b4cf",
      "en_sha256": "6cfa2c9f81010290af6f9918afacb5887cc1a4d7f54493540c66dd3fc57d58fa"
    },
    "dataList[id=35].content": {
      "pl": "I wcisnęła mi do ręki dwie dziwne monety.",
      "kr_sha256": "c561b67a8bfa53bfc9a29f604b9d7431d55620c6565c0ceb455a4df42c5e7b95",
      "en_sha256": "d44bf7a33f05233eb33241171e4c8e712238c89c1e4474065df4137a7ede81f3"
    },
    "dataList[id=36].content": {
      "pl": "Noś je zawsze przy sobie. Dobra?",
      "kr_sha256": "194dc8eb783cecfc3b0ac309bcbe7fbc7c7df2910e2763f40889bec1e4861d1c",
      "en_sha256": "4aadbbdcc153e973f359201d222e3019a123116e8a2d0a24fc8ab9115662b571"
    },
    "dataList[id=37].content": {
      "pl": "Nie mogłem nie skinąć głową.",
      "kr_sha256": "6c0a23cab86b0178ffda5783efc011863eda8fd2cf65fe388d77b5934bb641c7",
      "en_sha256": "e83aaa98331ac95469f214d5d6411552c5050b4280c773658b97c0a563e66ed5"
    },
    "dataList[id=38].content": {
      "pl": "Od tamtej pory co noc widok zza szybu wentylacyjnego dręczył mnie jak koszmar,",
      "kr_sha256": "0a97a9f5720814697e03c6fe70e49645f43e62b41d1275666f043cf23ca98fd1",
      "en_sha256": "c3a6b8436e43315958d8502f4dddf4a3d24c94fb45235692e4ce21c6839555c9"
    },
    "dataList[id=39].content": {
      "pl": "a ja zacząłem odruchowo unikać Kromer.",
      "kr_sha256": "bbe77fd0b82efc21858fa822f5919e5c0ca99f5f7ab1322bc57a97872c546f93",
      "en_sha256": "83e240bd40e313d81af902dd18e88cdcdc3ce32669f1516b137ac46f798d0167"
    },
    "dataList[id=3].content": {
      "pl": "Ubranie miałem coraz brudniejsze, w gardle mi zaschło i coraz rozpaczliwiej chciałem wrócić do domu.",
      "kr_sha256": "e16eeed21884b0806f8bfe2719217f784c095bfa30c69765751608c467ba8dde",
      "en_sha256": "1b8d96493eaa6b511ff4c1015ade5f6b0c4787165fe90af6d5fd595ec723e29e"
    },
    "dataList[id=40].content": {
      "pl": "Wyobrażałem sobie, że wystarczy mi na nią spojrzeć, a zacznę się trząść, przesiąknięty strachem i tamtym wspomnieniem.",
      "kr_sha256": "fba00305393b73695ca53507749ce0c3a7d269aa99300a5d3d7869352f8a0222",
      "en_sha256": "9dbb97af3d9ddf19b7e28c33b19199d59a6d8fbba605b4cca25db490a5fc01ed"
    },
    "dataList[id=41].content": {
      "pl": "Ale musiałem jeszcze coś od niej odzyskać.",
      "kr_sha256": "e4b46fd85b71df7f9acbc032942dee0da05a4d3700d43cd5eb3a7aef43d2a577",
      "en_sha256": "1281a6eef9f463001daaf39487dfea50f65507c2482e4053798220253666277f"
    },
    "dataList[id=42].content": {
      "pl": "Klucz do piwnicy.",
      "kr_sha256": "5fef4384e1d672730b6d09dea5a7c679cd7e19d1135a8041659b20030e346b6e",
      "en_sha256": "667330689c252f8434907875435417376b98005caee798b5bb96bbf6cf7b80c1"
    },
    "dataList[id=43].content": {
      "pl": "Wystarczyło, żeby rodzice choćby przypadkiem zaczęli przeglądać klucze, a wszystko mogło wyjść na jaw.",
      "kr_sha256": "27b33727343ce8b194b2febf1b3bb8b9a4e7a198b65d46b9f7d5a15de975a4a5",
      "en_sha256": "0248a607e272720a5831255beaeb35025731c114344857a45bd68c92bc360cf2"
    },
    "dataList[id=44].content": {
      "pl": "Po raz pierwszy zdradziłem rodziców, którzy mieszkali w ciepłym świecie…",
      "kr_sha256": "fcdc7e6edcc37a4c4ab6c6ded812e024b66a0d5a4c15f7278e77cbfb9610537b",
      "en_sha256": "4555697588c1d27bd2411269d4c90187ca23975e602c5c60a226b9788ea2f97f"
    },
    "dataList[id=45].content": {
      "pl": "i drżałem ze strachu, bo nie chciałem, żeby stało się pewne, że nie jestem już w tym samym świecie co oni.",
      "kr_sha256": "f3e00528077ed27a0e646d42c9b83ea2d8f46bbed1d878608218aa935defd449",
      "en_sha256": "c0b5a4c8d650027c343948e21a9af4ed0f9e1762b7fecceb2371d801881117d9"
    },
    "dataList[id=46].content": {
      "pl": "Kromer… oddasz mi go już?",
      "kr_sha256": "9df4011af1b5a2a9b2fae04e929bb045c853c146e2da9f805dd090784bcbbbc3",
      "en_sha256": "9923e0d725b7c9e13ad53a882cb14cd91e36b138052e699cec18b6b05e5f9ca1"
    },
    "dataList[id=47].content": {
      "pl": "Ale co?",
      "kr_sha256": "6e260eca05f543fcf74296cae0364c3a3a60d59b2ebbfc300a0408ddb5a5c491",
      "en_sha256": "483864e0b3609591f584a530bf14f4265cf74abf0aca1ef2d632c54c9f7a2866"
    },
    "dataList[id=48].content": {
      "pl": "Klucz… do piwnicy…",
      "kr_sha256": "0f6759c04447e80c7348275c128bb240dc33497dfdc538c648438308fa87ad3e",
      "en_sha256": "408c73e166f85d7440d080349506abe25f9483fc2fe6453bd35afc8b6f56ab04"
    },
    "dataList[id=49].content": {
      "pl": "…Pff.",
      "kr_sha256": "3a6808cb652ae86a2689b02d50159fe1b0cab0dabe52a35e547ecd206eab3f09",
      "en_sha256": "043358d1fdd93d65f76a42a0f8175f328da9e23e18321e205431c48934631467"
    },
    "dataList[id=4].content": {
      "pl": "Wtedy zauważyłem, że otacza nas zapach zupełnie inny niż dotąd.",
      "kr_sha256": "8b5249a6c786e97ee3b8b9b0129982941a618ff39ee1c01d1b6a4b098d3cb95e",
      "en_sha256": "cf61b67b781c4a0c806c6d8acc2191a4952a3cb5d73199ac034d5d34b870a78e"
    },
    "dataList[id=50].content": {
      "pl": "Pewnego dnia zebrałem całą odwagę.",
      "kr_sha256": "5b38730c10167bd2d1b4864ed3c14820a7bbca90a5b89c749d07974a54028c17",
      "en_sha256": "a850d943d3a7bb3b78051d33029a3e90576335a52c70f4468f4a3af3c1046ebc"
    },
    "dataList[id=51].content": {
      "pl": "Kromer parsknęła śmiechem, jakby usłyszała coś zupełnie niespodziewanego, a ja przestraszony powoli się cofnąłem.",
      "kr_sha256": "04c31d01cb4c9261ece285ffcf1dc12e15ff1b30ac8d35afaf0ae29b8377de1f",
      "en_sha256": "c4a3022d07fc3d24c323170e13409e81c7c3341de811b393970930558031db2e"
    },
    "dataList[id=52].content": {
      "pl": "Pfu, ha, ha, ha!!! A ja myślałam, co ty tak się męczysz, żeby wydusić…",
      "kr_sha256": "61bef094f49546a4b3f0f0cda7b8504e01008d4b0e0e9b761474781dea8e9a59",
      "en_sha256": "d2410893e9672d8a055aa5646ff596fa41137af9d83f7f5d67d9f7e36243e00f"
    },
    "dataList[id=53].content": {
      "pl": "Dobra, oddam. Klucz nie jest nam już potrzebny, Sinclair.",
      "kr_sha256": "0fa321c2b741badf4a52d6e326bd471c0042d642c31a57da128a9d9e975a08e5",
      "en_sha256": "094f623317b0aeb66ba6b7c0b57b67a2dc34b26aa87a35d0b870d5054263d847"
    },
    "dataList[id=54].content": {
      "pl": "I wiesz co…",
      "kr_sha256": "202e361e5272afbe3b8b8835279a7c4c272a5f1c127a9bbee6910ef5d0b856be",
      "en_sha256": "e1668a53a7d2070da84a0658fde046d087940a5cf34f9d3b5463bdd7213b3bd7"
    },
    "dataList[id=55].content": {
      "pl": "Twoja uraza na pewno się spełni, Sinclair. No wiesz, to, że nie chcesz zabiegu.",
      "kr_sha256": "ee751b946ed3989cd6756391eaece61b7435ee918aeede395db97b9d63373761",
      "en_sha256": "05e80d8a005113f0b4980af66523d7249e5960429181596209d8a5ad95154933"
    },
    "dataList[id=56].content": {
      "pl": "Pamiętasz naszą umowę? Ty spełniłeś moją urazę. To w podziękowaniu.",
      "kr_sha256": "44b281a6b2c7bc643695e674015ce4082b84d354613341105bd47abae2045599",
      "en_sha256": "1c571710f8696a8cf540a2cf8be5bf56b7d44f2fdbada0e8c2e431a0c2abe04f"
    },
    "dataList[id=57].content": {
      "pl": "Przeklinam swoją niewiedzę: tak mi ulżyło, że odzyskałem klucz, że nie zrozumiałem, o czym właściwie mówi Kromer.",
      "kr_sha256": "506a62d69aa5b0116a21ff4c789f39f90e07b41527ad640808694cb85d412c60",
      "en_sha256": "761df822354d7e5b070f7d4ea8d5fc3775412aebe68c5d5e47dad4818eca16bb"
    },
    "dataList[id=58].content": {
      "pl": "Kim byli ci jej “my”.",
      "kr_sha256": "ff204619c088bfaebdff30c468c14d6ac3a7cfc43eb1af07fc3cc07a9d6b1faa",
      "en_sha256": "92f3c641e911432691b238adbb969b88781c844b2c14e1994989543ece93295c"
    },
    "dataList[id=59].content": {
      "pl": "Dlaczego powiedziała, że klucz nie jest już potrzebny, jak zamierza spełnić moją urazę…",
      "kr_sha256": "d2346ea4a058d37a3a51bb2bdca0c975b0f010bc742d9ea1ee256b331eb8ba2d",
      "en_sha256": "5e950fc383debbd5b1f53fb6335698d8322cce29e2735c3bfbb48ef5f6dea380"
    },
    "dataList[id=5].content": {
      "pl": "Też to czujesz?",
      "kr_sha256": "30705be02f6d2315b6ba36070d82c0f1c33c251d54fb3165324d74694ffaada1",
      "en_sha256": "e00eb36f692f454dcc0f585c35495d02956194f6a3bac8818f37dc608e552923"
    },
    "dataList[id=60].content": {
      "pl": "Żałuję i przeklinam swoją głupotę,",
      "kr_sha256": "1e8a216ea684ba68a92421f7ac01301d152694c4944cc478310f59801c3f9314",
      "en_sha256": "204f82479dd4b753d699b64b8a215fcca1ad01903dca4832110b66813f7ed77b"
    },
    "dataList[id=61].content": {
      "pl": "przez którą nie zapytałem ani słowem.",
      "kr_sha256": "c54dc268bf28a61ffbf1c42cecc7b74654a9a8f21ac06b7474d47b54d6b24731",
      "en_sha256": "2f521b12bb1e9c7889bf1fd359897fe0be3f186fbc9c238fd41d3c2336b6928b"
    },
    "dataList[id=6].content": {
      "pl": "Usłyszałem szept Kromer.",
      "kr_sha256": "7aa73ebbb4d16e6a2875a65b665a83597c20482c9a9657ce64b7ad9387029007",
      "en_sha256": "51860e1b641f654f473398764948a176d70fbb4fde3aa7bd75c4910aeb75f591"
    },
    "dataList[id=7].content": {
      "pl": "Tam przed nami coś jest…!",
      "kr_sha256": "e64e2b46c72a3a2574935587c428e7696b58324ab15c0148f236553eb6758242",
      "en_sha256": "f3f6aba069d030fc32b4d13773b8669e46ade3981ab75d163da05c8b1b77354b"
    },
    "dataList[id=8].content": {
      "pl": "Jeśli została mi ostatnia szansa, żeby zawrócić, to była właśnie ta chwila.",
      "kr_sha256": "f0609740e9a4eea5b0345a39f7528c846de088c8c05086f38efa6e82562b129e",
      "en_sha256": "32dbf8efe908ce44c9a95dd78bce6dbff803701aabfda62fdfab2e5499e460c8"
    },
    "dataList[id=9].content": {
      "pl": "Może lepiej byłoby ją jeszcze powstrzymać, zasypać wszelkimi słodkimi namowami i przełożyć to na następny raz.",
      "kr_sha256": "b6b785505fd6cc0ebef4851fc5fe75caae64a56c369d26fe61d4850b23a53996",
      "en_sha256": "3baef7b10b4d1527e17600eff057fc8b61cac50e46d98814f6357271bf22dc1c"
    }
  }
}
