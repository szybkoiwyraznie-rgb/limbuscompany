{
  "entries": {
    "dataList[id=0].content": {
      "pl": "Cholera, przestańcie wyłazić!",
      "kr_sha256": "04efc48313df714b48e5ba25f771ba2580f7ce5a92673f7d71079a93d99fd003",
      "en_sha256": "b82057b354028b082ade50be3965598a749491573d784d08d17e659f8e41ad63"
    },
    "dataList[id=10].content": {
      "pl": "Życie pełne jest zagadek.",
      "kr_sha256": "201b29928681376eb96c9741b201cb23197b3de0608c6057f4baadf7dbc9f0d4",
      "en_sha256": "97e2aae24af291e3dbc1dae219df398f6eb837b28f13ba6c1e5c8d86f2326bc4"
    },
    "dataList[id=11].content": {
      "pl": "Toteż można by je nazwać idealnym.",
      "kr_sha256": "3b04e128760b6b97cdc9c7aa28d1927593e5acf82938243be60dc1ce785251d9",
      "en_sha256": "4bed939b0930155931c5d5da69aa1ed9ce04838ea9e9cfde6d98bca59db910a1"
    },
    "dataList[id=12].content": {
      "pl": "Gdzie jest ten wasz łeb?! Dawać go tu, ale już!",
      "kr_sha256": "fe54da98ee9ea4791a8e309aec3db1a470a988a10034f4804683ecbffe4e5d24",
      "en_sha256": "f5f3b29580227f6a404808591e24136a633aba4baea194a9e3565f6867dd3831"
    },
    "dataList[id=13].content": {
      "pl": "Heathcliff złapał za kołnierz tingtangowca, który chyba już stracił przytomność, i trząsł nim jak szmacianą lalką.",
      "kr_sha256": "ec7689a0e6413949a6f2186500972215f798b8a51206a9ddf8d6ff05997ba88a",
      "en_sha256": "961bdf47e57ecb498eb9569bccfb465ca878b3fc681c88daf4a56ade69220838"
    },
    "dataList[id=14].content": {
      "pl": "…o ile stracił tylko przytomność.",
      "kr_sha256": "1a480c1927812977c98e753136b8e633899d1cbeff83771420c1c77b6266eff8",
      "en_sha256": "de2b991cbd4ce9be35bab4586155cc5a30702c901ba1c67d5a00643c4eb7996c"
    },
    "dataList[id=15].content": {
      "pl": "Nasz szef… jest przy wieży z aut…",
      "kr_sha256": "a274863b1393eb320aac07ea988c1ed91bf571a31ec79f336b474d38048c48b3",
      "en_sha256": "5ae710ff206cd1889ed4ac3ca86b543cec847bc8370caa81b163df75e002456a"
    },
    "dataList[id=16].content": {
      "pl": "Wieża z aut? Gdzie to jest?! Gadaj po ludzku!",
      "kr_sha256": "dc91ac742a473b2b4140654c5ee97cf8da91568ae343f86376942bcbc77a0e9f",
      "en_sha256": "33410db157f3b8eecaee8da3547a8b7e2f270931d86e8140439be4f3824db66e"
    },
    "dataList[id=17].content": {
      "pl": "Pewnie chodzi o pobliskie złomowisko.",
      "kr_sha256": "af305cd2d52eb545e28db2dd7ae142e474499984aa796af734e6735c0a1b518b",
      "en_sha256": "5884b74933ca2d250a5f59f7be0cfa84ae0ac1b0bae69ef557da0873093ab8f3"
    },
    "dataList[id=18].content": {
      "pl": "Ale wy na serio chcecie załatwić szefa gangu Tingtang?",
      "kr_sha256": "417ba72f6b2dfe4b4ef858db1d646a3b50a7c098e16fabd869b424b99d7e8c8b",
      "en_sha256": "d089b25314e2af546972fb0764606c6c6555ca703fc9b30173434ef0c9ba8b3f"
    },
    "dataList[id=19].content": {
      "pl": "Wiecie, że nie trafi to do waszej oceny okresowej?",
      "kr_sha256": "d632d7bd9da32379f0edefc0c936fb879be8744d363c60ede281808343433c34",
      "en_sha256": "1e4eb122befe7948e3ec9fa49c24265182d26a78a67f3aa91954d64b048b6273"
    },
    "dataList[id=1].content": {
      "pl": "Prędzej zdechniemy ze zmęczenia, niż w ogóle dojdziemy do tego kasyna.",
      "kr_sha256": "24e1e5825d3eb5a877b5e872e516d3eb7865b1adf9cd52cf0d7eb9de53126944",
      "en_sha256": "795951e256c74535b22e8d901bf14a698cceaea5da38a9b0f9aa430ec1c84f04"
    },
    "dataList[id=20].content": {
      "pl": "Ten tam nie jest na tyle bystry, żeby takie rzeczy brać pod uwagę.",
      "kr_sha256": "2d06c4b03478adf49d01d98b3f75cd07150d7c7fa397987d07eacf32e37b9306",
      "en_sha256": "8b3333da22d0ea76d891cef0530c8736de384fd1052854a19d2d3d8a28a9cbb9"
    },
    "dataList[id=21].content": {
      "pl": "Odpadek, któremu daleko do podstępów i kalkulacji. Za to blisko do niedorzeczności.",
      "kr_sha256": "7f8a9cfcc4629e58a252f8b7d17da207854e3a8739a09b1b9dd427093d30386a",
      "en_sha256": "a62d47028c70019b11399079afcb9cdd75f8d5925f4d4f9f7f7e9fabca156d6c"
    },
    "dataList[id=22].content": {
      "pl": "Nie… To chyba ma sens.",
      "kr_sha256": "17ec5510e4868167ee733afeecd005327d5eab82c88299b164a4b2f6333a8927",
      "en_sha256": "ada9115ded67171de90fcb0921480f378f6475b591c6c0a6840aaa9c3bd10171"
    },
    "dataList[id=23].content": {
      "pl": "Spokojnie, Effie. Zawsze mamy w zanadrzu plan B, prawda?",
      "kr_sha256": "7e384ccb33533e3280815e23227411df6212a7aeb5138cb0230ca7b2430d0207",
      "en_sha256": "6822041425b84c31592d3799b18c4cb08d34a5c94a228956eb67ec88d51b71c8"
    },
    "dataList[id=24].content": {
      "pl": "Saude mówiła dalej z łagodną miną.",
      "kr_sha256": "700793f81add055b4557655442584773707d9b51e820c3bd4f38d1917a49089d",
      "en_sha256": "c873aeb363e05bfe49099bf4da6ab25f994cac9499ba5576452e92488451c473"
    },
    "dataList[id=25].content": {
      "pl": "Ale co jakiś czas było widać, jak usilnie stara się zachować spokój, i można było pomyśleć, że ta łagodność to tylko gra.",
      "kr_sha256": "c72e96ee5bf48b63ff72d8b72a71d727fb0390b9475fe026dc4a45f4df78a623",
      "en_sha256": "0eb545b1335c4cd2253b346e6611371b9e1b33af3d76a7d17166d6168311fa3c"
    },
    "dataList[id=26].content": {
      "pl": "Skoro nie mogą się państwo przebrać, jak planowaliśmy…",
      "kr_sha256": "85778b8273af4548e0cff304681fadfb0a998543c8d1060af3ce03b5b8cbacfe",
      "en_sha256": "6041795a568e768d0f7341138d00c6adc169803cb419c269991db906160c9cd6"
    },
    "dataList[id=27].content": {
      "pl": "przebierzemy się wszyscy za tingtangowców.",
      "kr_sha256": "6e6c3480a7057fb019776c08b15505e564060d5eaf2d9da7077ae1fd950dd0b8",
      "en_sha256": "fda33199cc467dccc77a9cc3f1e28e13762ef7e7fd4a6e3731dfef2eb093c0c8"
    },
    "dataList[id=28].content": {
      "pl": "Nawet jeśli wejdziemy grupą, nie będziemy się rzucać w oczy i gładko dotrzemy na najwyższe piętro.",
      "kr_sha256": "3c7a4e8eb4cbdff19de40699909f3d2d794b04658a930b9a10f3877b1fd1e70e",
      "en_sha256": "12757356ba3d1c42d12ed9e14b77a892d393ad4eb99484a26f2d5300e49d9cc5"
    },
    "dataList[id=29].content": {
      "pl": "A przy okazji podbierzemy gangowi Tingtang trochę Mocy Życzeń.",
      "kr_sha256": "a9232888aaabc2a7ee985b30d4f71ac4a72ab8afed87e4c6eccbb5a93b018a78",
      "en_sha256": "533e9ef8fc817033dff759f153738ccd05e23521e6334097ee481cae54931ac5"
    },
    "dataList[id=2].content": {
      "pl": "Spokojnie, Heathcliff. Dopóki jest z nami Kierownik, nie umrzemy ze zmęczenia…",
      "kr_sha256": "fd7eeceb896f45bdc48dbaf72a1274b3d3c09d872c95e4b258cdc77cbc0cabba",
      "en_sha256": "9bf738fd0bdd26e1bf02ce44c97cbbb4f5954803824687fc931f56ffd62ca8f0"
    },
    "dataList[id=3].content": {
      "pl": "Myślisz, że nie wiem?! #@$@#$!!!",
      "kr_sha256": "5dd55ac912a71073b6dcd33f44553246c5be4b08960cd228a1d48856e402eda3",
      "en_sha256": "2d6e4b7b03c816e107d7bca91b8f40de9346ca2daa4a4f1722fc6b3971d08fa6"
    },
    "dataList[id=4].content": {
      "pl": "Rozwiązanie jest proste. Każdej organizacji wystarczy rozbić łeb,\na mięso, które go dźwigało, runie.",
      "kr_sha256": "7f9892e50c374082a6f6c69f7e66c20c4fbd5a29b00adb8d0adc871eac4e9a89",
      "en_sha256": "a0c210a8efe53cfb576b5d02e49022860e2723add0e9dc38f35311bacaccf41f"
    },
    "dataList[id=5].content": {
      "pl": "No, ty jeden gadasz tu coś, co mi się podoba.",
      "kr_sha256": "044e2f8af9ee7679d1ffa229db2a5f071f37c3f4e43018bfc4241d752706ee91",
      "en_sha256": "c55a4ff54c4e03b667e6731766b4b9e1e7fbbb6c651749b6c160f5d1a0c61535"
    },
    "dataList[id=6].content": {
      "pl": "Wkurza mnie to, chodźmy coś rozwalić. Łeb czy cokolwiek.",
      "kr_sha256": "e83645775298a9d32a46e31ab0f25e7439bbccc9aad7847dc727ad1969baf932",
      "en_sha256": "8fedf9a5ada314d14039f1ffbd233341fca38ac2684bfe373d1dbec96856a307"
    },
    "dataList[id=7].content": {
      "pl": "Zatem naprzód!",
      "kr_sha256": "4943dc8463b78fb4b11d76b12729564ee41cc37b0dea05bae6e7b0c9897f99b3",
      "en_sha256": "84d9edfa1ab16835128a68700085eeb67230bcae7ca2326463f4e8376fee76e9"
    },
    "dataList[id=8].content": {
      "pl": "Czekajcie! Wracać, wszyscy!",
      "kr_sha256": "1cfa1d1efe2da73951d1275a3f81be5fd869b6014d3ca7b26b620e6776639c26",
      "en_sha256": "4bb27961897349ee4ffe6d948bd3ddbb7367aea232b8809e1b263d6634bdce8f"
    },
    "dataList[id=9].content": {
      "pl": "…Faust, i ty musisz cały czas łazić z takimi?",
      "kr_sha256": "b40b85e40c5dd12c9fddc56fbf1de3d6f2899fe65b6bbb269997b1b26e2a12fe",
      "en_sha256": "def7307d1f4952830db582e6a9db67ad61d2c64b685551d0cced0e67ac09a82a"
    }
  }
}
