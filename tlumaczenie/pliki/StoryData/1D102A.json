      "en_sha256": "f4aa05630d883673c5f06b5d9d5e181bf7b9ef001740663cddc9f16bac5221a3"
    },
    "dataList[id=10].content": {
      "pl": "Oj, Hopkins, zgłodniałeś i dlatego taki nerwowy? Delikatniej~",
      "kr_sha256": "592aa91a3b3f19cf589a0a874560281ed3039b3d38bc86527289f5a773b7c890",
      "en_sha256": "7baa654fd574200a4302074ed1c68c066c2a762d9edc11f42675c7881274c558"
    },
    "dataList[id=11].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "895361ffbf88d5a8c40d47f8dd3d03df2042ca9360d08738bcbb4faa39495404"
    },
    "dataList[id=12].content": {
      "pl": "Jeśli pani Yuri rzeczywiście widzi je pierwszy raz, mogą to być istoty wywodzące się z Anomalii… a może wręcz odrębny gatunek.",
      "kr_sha256": "463676bc36a361de2016bb30c4b51ea2a6a52c7e08b46079ee195de510da3e15",
      "en_sha256": "dea22e4861601dd99e5eff258791b164254d6c1c8e73f500abcfc716c3ff7591"
    },
    "dataList[id=13].content": {
      "pl": "Być może owa Korporacja nie miała pod pieczą wszystkich Anomalii.",
      "kr_sha256": "3ae1a3a1ee31a56a06c8e4bd4602ad44a151ec4c403a022c70d6ab20898ec504",
      "en_sha256": "9ccc4a62115a52f45e2fc12ec2c324bf8870d6b25767e47a0fca0634cb9e2baa"
    },
    "dataList[id=14].content": {
      "pl": "Jeśli panna Yuri nie zaniedbywała nauki, nie ma powodu się obwiniać.",
      "kr_sha256": "e1bd1a3f7b7d59ff367411cb776369ced6e6ff182a8724deaa999df19e95cd5e",
      "en_sha256": "5268262400648a4cdb464db87826e30bc9bb369a26d7d6827c323775ae609dc7"
    },
    "dataList[id=15].content": {
      "pl": "Ekhm…",
      "kr_sha256": "88d122f3eba2884b7843b2fb8211a909e3e4f21db9162cfac9ba9cbdb006c7d0",
      "en_sha256": "84046f1d2be4df1687746f93c3bba89939b34e1599b39765c9da07358c921f4f"
    },
    "dataList[id=16].content": {
      "pl": "…Dziękuję panu.",
      "kr_sha256": "25fe53e7a1df8a9a9156f176363da89d13bdc9c90285e9b8be64e41e6fd39845",
      "en_sha256": "7b953ba613fb007682407b800d645068383fa8676b145517f2a8e94d0ff1e99e"
    },
    "dataList[id=17].content": {
      "pl": "Co się tak cackacie z gadaniem? Idzie się, tłucze i tyle.",
      "kr_sha256": "eadace3d8572942605e76d34ce58d9b3fe073b170af9043dda84d58161036ee6",
      "en_sha256": "6d852836483742abd40f54dd90fc2de5f411abae2bc9e69676412914617513cb"
    },
    "dataList[id=18].content": {
      "pl": "Jeśli będzie rozkaz, wykonam. Nic więcej.",
      "kr_sha256": "f8fc1a966f100c8135dcd800d3b9a335da70bdc13ad87ae3a249111fd9392c9e",
      "en_sha256": "a7bc68eb20123494702facc2be0e0920a90d1c57765a9bcc6dbef9a7c48dbb4b"
    },
    "dataList[id=1].content": {
      "pl": "Nie wiesz, co to?",
      "kr_sha256": "107977fa908f5fb1db24cbfad68e52813766b713516dba2469662e0b4f00508d",
      "en_sha256": "957cc4935887d37a8106007eae4b4dfd6a2912f07df7ab432185c24bad575cb7"
    },
    "dataList[id=2].content": {
      "pl": "W jednej chwili twarz Hopkinsa wykrzywiła się lodowato.",
      "kr_sha256": "46d7820034d130a9ebc71757195c2ed71ac76affb4a3443665410c1b1db70eee",
      "en_sha256": "b294daaa81b233c78874ed6d8b4e36c6b12f475ed7fe5a58e6f758494f2864e4"
    },
    "dataList[id=3].content": {
      "pl": "Była tak różna od tej, którą pokazywał przy Vergiliusie, że aż przeszły mnie ciarki.",
      "kr_sha256": "f7d2d2cfd1e4cfef102ea09b18a228847907c6eec227010d5f099a457a6bf707",
      "en_sha256": "22cca022263da566c2454365ecdf93ae433b72dca47096a6c3b15f605d0b5fc9"
    },
    "dataList[id=4].content": {
      "pl": "N-nie… to znaczy…",
      "kr_sha256": "bffbccdc9f9ac8b7490a2c4ae3dedc652cee1390d45cd80d7474e76af8c8c807",
      "en_sha256": "78d922ad9948faf99d89eeedcc75cff19e9e07f9bf4be38b4f06c946215d478a"
    },
    "dataList[id=5].content": {
      "pl": "Wiesz chyba, po co w ogóle podnieśliśmy pióro upadłego Skrzydła?",
      "kr_sha256": "8f90b17550e805661ed03e9dd32c54d13d07b01c4db5710564a10e94c3b68db4",
      "en_sha256": "512c8b708c4899cf0bfc330f98d2efdca60f4ea6fc0afca8f64c4ab292227681"
    },
    "dataList[id=6].content": {
      "pl": "Ż-żeby… żeby zlecenia w filiach L Corp. dało się załatwiać choć trochę bezpieczniej…",
      "kr_sha256": "c3f7ce68681edc0f72c269eaebde2104c8cc84d71a39358e61da7898ab7de114",
      "en_sha256": "3c1600af75d01705591fc5a47cf6eae104bb755db940923041e07b00c51dc1d6"
    },
    "dataList[id=7].content": {
      "pl": "No właśnie. Od kogoś z niższego szczebla nie oczekiwaliśmy wiele.",
      "kr_sha256": "850043eb71762bd0bdd3fc06e2149b773385db1527d539134473a9fa8b464ab5",
      "en_sha256": "807a4498a358bbddd0c152222d6dbcf9419568d39e488c6551ec8b297d8db1f3"
    },
    "dataList[id=8].content": {
      "pl": "Prowadzić. I powiedzieć, jak rozwalić te Anomalie czy Anemie, czy jak im tam.",
      "kr_sha256": "6799a2efb99a06b9ef1c1810c9daf5ece09f462efe511eb7f370c2d8f64a63cb",
      "en_sha256": "920cdb96451a6f6fa040ce81358567e553ceb70a52c7c1e6211e276e5e3d189f"
    },
    "dataList[id=9].content": {
      "pl": "A ty mi teraz mówisz, że widzisz je pierwszy raz? To co my mamy niby zrobić? Co?",
      "kr_sha256": "d41c9c42ea0220482e2637c705e455b4f1226d213e877253d1067aba728e091e",
      "en_sha256": "f3dce78df6322039792445972dbe83c8d83da2e56fba6aa3cff4e08394d48817"
    }
  }
