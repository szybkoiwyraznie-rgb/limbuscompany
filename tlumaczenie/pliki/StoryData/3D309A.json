    },
    "dataList[id=77].content": {
      "pl": "Charon, przecież do Bożego Narodzenia jeszcze kawał czasu?",
      "kr_sha256": "7d46684ec84e094e2f032a906c7900ed4875efdb19a163ea5f0f21789f82f27d",
      "en_sha256": "9698c30ebc82ed45c769ce4acd3d321fd684fbb5ccaac2c8c3612d45082ec7db"
    },
    "dataList[id=78].content": {
      "pl": "Nie psuj Charon zabawy, robaczy jegomościu.",
      "kr_sha256": "d8f1f2d5ce7336db7698a6e1c2b31f954693d0387f447412bdbea53e7442861b",
      "en_sha256": "9054c4115afb2c74f31e646a4daf2548af09bcea035bb78668943260ac6e3566"
    },
    "dataList[id=79].content": {
      "pl": "Jak Charon czuje, że są święta, to są.",
      "kr_sha256": "bea53838784b0a4cd5a37935850f60b422ebbb686539480b43eaedeac5fe817e",
      "en_sha256": "5c5dc6db11f698273d13e0f22011f4d078c92a1e510b7040150aa4120be21db9"
    },
    "dataList[id=7].content": {
      "pl": "Ten, którego nazywano Demianem, zaraz ruszył przed siebie. Lekko, jakby wybierał się w niedaleką podróż.",
      "kr_sha256": "7b8f7c40b7f40fd3b73f7be43c7d321eacfb5ba56ddcc29cb0b78768d2f7116c",
      "en_sha256": "a905245c5f4b08c7683728d7f7dbb8590a2118cb239f1b05605d0ac5d1f65abd"
    },
    "dataList[id=80].content": {
      "pl": "Robaczy… Ej, a ja raz porządnie zwróciłem się do ciebie po imieniu!",
      "kr_sha256": "2612320bbf81362e49e8f9640af0ab50d9da8db9c53baae3bb9ed896ae55fb55",
      "en_sha256": "737ee362ba6ee0eaf1669bd19ae33992936566127ca5569582a4ecf4baf558c0"
    },
    "dataList[id=81].content": {
      "pl": "No to mów do niej “pani kierowco”~ Czemu dajesz sobie tak w kaszę dmuchać?",
      "kr_sha256": "c81bd91fbf93a88cdf497157b6743576cfe0229074d197503629faf8a100a2b7",
      "en_sha256": "0c11dc5e26862368ac021b90ae1f1b497975a7ba9798e7dcbe3dc6a10d688c68"
    },
    "dataList[id=82].content": {
      "pl": "Kh…",
      "kr_sha256": "fa6dfbfab24b1bf2fb0a3df82374200d805cb40a442c44b743019cf46fcb139d",
      "en_sha256": "ce1997ed9e29c8b20dc05f94455c4a8b08b2178dd720e6f909e4e13c3c0904c9"
    },
    "dataList[id=83].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=84].content": {
      "pl": "Vergilius przyglądał się temu wszystkiemu i nawet nie tknął szaszłyka, choć sam je kupił.",
      "kr_sha256": "ae89914202ba45a99a39f22cacef46483df2b9ad90079a852cedbf263f764779",
      "en_sha256": "09b3d86422b777dd4e05b29eaa72f74ec0d5b88c31a6e0a416691be64fb10883"
    },
    "dataList[id=85].content": {
      "pl": "Czy to piosenka Charon znów kazała mu ucichnąć?",
      "kr_sha256": "9b9d05a2146974e01f44952064e4b7522016a955f5f0a4000c72c4f1a85eebd4",
      "en_sha256": "455b5985a9d6b6a890b40d16507eafa276327897c9231855372c7a727453a755"
    },
    "dataList[id=86].content": {
      "pl": "Nagle przypomniało mi się, jak mówił, że Charon jedzie przez tunel.",
      "kr_sha256": "46dd68062d898dd28e4221237e6c1ceba91eedef69fe4885e70dd25141a354d5",
      "en_sha256": "d328578333fad9c5f1629d74d294fe294bacdbe16a4fa5674f8864652b86d352"
    },
    "dataList[id=87].content": {
      "pl": "A ja",
      "kr_sha256": "5f7161b051af481a26d4700e874ca4647513faa6340ef78fb1d2415b9866afc4",
      "en_sha256": "5fa1b60944e2fadffd54d40865b2fa0a4e46f293accd930091220929bd6101d5"
    },
    "dataList[id=88].content": {
      "pl": "przyglądałem się w milczeniu Sinclairowi, który śmiał się niepewnie pośród reszty Grzeszników.",
      "kr_sha256": "4a346ac95357db24a1fd45b681932d17102e27e8153a70219802fe92c7ae1bab",
      "en_sha256": "87dd0bf6fbb910bfadbf614ce71aadd4adc83c463c8849349f70e26c792b746c"
    },
    "dataList[id=89].content": {
      "pl": "<Jeśli jedziemy przez długi tunel…>",
      "kr_sha256": "edc1ad2bb997ece293db6b5f374d61a73ccc1c42847cef6c2ad96d111a7b362a",
      "en_sha256": "630e5ea7d22bfd844111bf46340f568ccb22eb5b59b15bcb8c9d4f69eaa931da"
    },
    "dataList[id=8].content": {
      "pl": "Świat wkrótce ruszy ku nowym narodzinom. A dotrzeć tam może tylko bardzo niewielu.",
      "kr_sha256": "3dcc8b09c72bf297259981b9e9adad0b8a9d22cf84b28370c59d70a27485fbe6",
      "en_sha256": "bf1e2864c0e425ed275233be644b2170b414a1cbd2fe7365991eab6afd8c38d3"
    },
    "dataList[id=90].content": {
      "pl": "<to może wystarczy poczekać na ranek?>",
      "kr_sha256": "ea1b386a2e6848e6147d5779fd6405713d6480eedc3429d52faf7445596da087",
      "en_sha256": "e419f656e7b7c4810c4317d021a11064d4894d294f766ad302051d7898077030"
    },
    "dataList[id=91].content": {
      "pl": "…",
      "kr_sha256": "7e428bfac963e979a36c34565ac48fb5ecee5c830adfb7369fe7ce653be4c521",
      "en_sha256": "a7f878b8ced1a7957c560d573e30ddbbc1696e38c370513aacbbf4bff12e7f43"
    },
    "dataList[id=92].content": {
      "pl": "A, ha, ha, ha! Co ty gadasz, Dante? Jakieś dziwactwa. No! Dante też dostanie szaszłyczka~ Aaa~",
      "kr_sha256": "a4c36d82162e049712790740d0428ccb59fe510035af25564dd9819d48aaa373",
      "en_sha256": "77db5b1991f593cf2837a9b28995bf18ff1d92d33ffae53ad18d1103ecad75bc"
    },
    "dataList[id=93].content": {
      "pl": "Kierownik nie ma ust.",
      "kr_sha256": "f8c9d7bb125c37662d620f24446d4b30a853b9bb49d5ab5c780ab02639c1bf63",
      "en_sha256": "c9de03ef490ee94bdac75899305427ec266858701ccea1b0abe0fa7005a642fe"
    },
    "dataList[id=94].content": {
      "pl": "Kierownik nie ma ust, ponieważ jest niezwykłym talentem, który bez jednego słowa trzyma nas w ryzach. Zapamiętajcie to sobie.",
      "kr_sha256": "50b470c4f049b26b3398369b9d742f725e8ec81bcaad8d6c64622d51ab95a449",
      "en_sha256": "041f00dad7cd8cb48f01098e2bcfdf870f50eef249c9837a0487ba293e2e36f2"
    },
    "dataList[id=95].content": {
      "pl": "Rany… Nie męczy cię to ślepe podlizywanie się, Outis?",
      "kr_sha256": "41ec2f9f37e2a22804ed9e90cb5c00e1cb00d394561e98cf3f83b620cb4bf43a",
      "en_sha256": "9118e386bf5b6aa21d354b71d26a3e809762d70bf5d118e9a3a21e3b38c6230c"
    },
    "dataList[id=96].content": {
      "pl": "Ej! …Nie ma tego więcej? Dobre.",
      "kr_sha256": "532d7a84e422b81b83a9b1620ac40c926b975da6583b3aeb0a371dc92b0d10e6",
      "en_sha256": "1df3b85286fb6bb59d64322c701e17138284218ca16b2cc02841d080d9538e7f"
    },
    "dataList[id=97].content": {
      "pl": "Ej, R.J. Daj ognia.",
      "kr_sha256": "b5ec3657cb363a7404728fc453aa3439b9f256a940dbb352e4ba17c58d07dcd7",
      "en_sha256": "0c7e3f635de4952123371e7a2dfc9480138b9890ba5d0e112db83adb2d0497ba"
    },
    "dataList[id=98].content": {
      "pl": "…Myślałaś, że jak skrócisz, to nie będę wiedział, od czego to skrót?",
      "kr_sha256": "c1abc8e72627e5959f49ae055a83f97e660b32ab92e0f1f1eb196d5c145cbd62",
      "en_sha256": "c4838637815e135a1219c760da95cc7ef2d62d5806e39a7c1b1443cf92c274eb"
    },
    "dataList[id=99].content": {
      "pl": "Chciałem jeszcze wygłosić Grzesznikom mowę o tym, jak po tej udanej, a jednak przegranej operacji trochę zmieniło się moje nastawienie…",
      "kr_sha256": "00387a5330cf8244a1e200084abd58361d6de5873edb8420bda9666a17da1eb3",
      "en_sha256": "89837409d6495a2c5ec17af5506356c407e58acacc804ee35ff920832ba7d24f"
    },
    "dataList[id=9].content": {
      "pl": "Ty, Sinclair, jesteś jednym z nich.",
      "kr_sha256": "ee9206aef4d95c0130791e9624aa091b3be3a93418ce55e4e8fd5293785932bf",
