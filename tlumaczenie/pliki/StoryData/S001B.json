      "en_sha256": "71fcd9ea016d64b087a8bf8e2758e655aefcfc421171493695a600189e24b1b6"
    },
    "dataList[id=51].content": {
      "pl": "Poczułem, jak coś w mojej głowie szczęka i osuwa się w głąb.",
      "kr_sha256": "eaaf4c164b39e6e1e51e39271b0bdad93c5bdcbc5ffb880a480a648db9c67ce4",
      "en_sha256": "85896a82b814ee2ef9d1f0d02e88dbd14351e5f9493cf5743b2e758c18c55cc5"
    },
    "dataList[id=52].content": {
      "pl": "A potem wrażenie, że przeszywa mnie naraz wiele łańcuchów. Albo że to ja jestem na nie nawlekany.",
