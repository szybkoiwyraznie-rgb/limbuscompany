      "en_sha256": "c2ba88d7d4acbaa6d5ac75770b1d1688e744889b614a6be1266b52c102167f09"
    },
    "dataList[id=54].content": {
      "pl": "Proszę się nie martwić. Serce naprawdę nadal panu działa.",
