      "en_sha256": "21203dd4f10eee055e4fe9a47b09c7c24ebedf44f7de3dbec25b92188a16867c"
    },
    "dataList[id=61].content": {
      "pl": "I to naprawdę wszystko?",
      "kr_sha256": "0c65bf9ea14cbf91a97b1ff8bbf6c4a1e5cc722fa010291ada9dff861f06cc87",
      "en_sha256": "f05e143864eda5c0a942d595256cdcfc7b9cb7c7393300c8c27de74fa8bf92e5"
    },
    "dataList[id=62].content": {
      "pl": "Jabłko jedno spadło.",
      "kr_sha256": "cd52e0b6b1ea4ed347e9704f926432aa4271d3397eb426966f99c9e391f0e5a1",
      "en_sha256": "0de1a9a5b3e43b5442b39fef6e7f3caca1ce6b30e200f01ab56953c1893e6996"
    },
    "dataList[id=63].content": {
      "pl": "…Ten tu wciąż plecie same dziwactwa.",
      "kr_sha256": "423bc7a033c9da5877498ac78de853a85a989e136edb501a91e637d8f0421430",
      "en_sha256": "7fd7177e170b1232e3f516c1acb9831f20e358fcf08a5ccf0f458cd1f51ba160"
    },
    "dataList[id=64].content": {
      "pl": "Uuu~ cała zesztywniałam! Można się już ruszać?",
      "kr_sha256": "ddaf4ec59453417b30d3c38679f781f153c8473d73d620db79967d05d3d0ae94",
      "en_sha256": "9c498308fb68f6d199c7df530cec95004a8fe6bc503e2e3928d01347ad77cdd5"
    },
    "dataList[id=65].content": {
      "pl": "No, mała rozgrzewka nie zaszkodzi.",
      "kr_sha256": "e7c950b51beb40355efa596318ea5a15cc3ba98caefc4d2982e02562f41a7b0c",
      "en_sha256": "e4eda8422b5f46d3d479b0855cfd615055203e5845205d042867650e1b0d3135"
    },
    "dataList[id=66].content": {
      "pl": "Co to za żałosne coś się tam tarza? To ma być nasz ostatni rekrut?",
      "kr_sha256": "90b818585fcf202b25b48c50666313348b783c3bbf5e3787fbc46f0a5257856e",
      "en_sha256": "2bdda85f77268d529733d4b24b81b8e1c7ee4fd2c7e57cf0b8c1fa89ef833188"
    },
    "dataList[id=67].content": {
      "pl": "Ee… lepiej uważaj, co mówisz… Podobno to nasz przyszły szef…",
      "kr_sha256": "6c50a25373a9a10339b144e3866c26a7aad0b46fb5f541050231d08b5fc79a2d",
      "en_sha256": "83fd9541448ff89e85c247b38d72b6cd140643fb17476cebfadd91aa67006de5"
    },
    "dataList[id=68].content": {
      "pl": "Napaść musiała przyjść w mgnieniu oka, a jednak zdążył pan ukryć głowę.",
      "kr_sha256": "f8f7357371c188ef1c110038e5f0bf98b8e5bb456de75f52c71d5510d7500284",
      "en_sha256": "a02ab466c99bd83577549cfd9482d7c77cb872681e1efdea00cf3cb284ba79ec"
    },
    "dataList[id=69].content": {
      "pl": "<Kim wy jesteście? I co to w ogóle za autobus?>",
      "kr_sha256": "216f56fbb909d4bf286cf29d96b5fc771256461f49fda18457f6f0dbcf0f428a",
      "en_sha256": "6d57e7e9c5398ca5678fe2c6c1f2173eeb4d9a5c43137449322e7737903d1053"
    },
    "dataList[id=6].content": {
      "pl": "<Kh… Gdy tylko wyryję ■■… takie jak wy…>",
      "kr_sha256": "8e0e5a7742ba3bdf6501556869ebc3f153bf5fd86a03f02f027e1057f5456f31",
      "en_sha256": "ec0e46ad1dcff79b79bc2063d41c5d978addfcf455776af88d29300c08817458"
    },
    "dataList[id=70].content": {
      "pl": "Jesteśmy posłańcami sprawiedliwości, którzy przybyli panu z pomocą, a to magiczny autobus, który zawiezie nas, dokądkolwiek zechcemy.",
      "kr_sha256": "4d1d7ce02227ab6b8c8a0c2299f9339781320a554cd60d292e555f5d802f7893",
      "en_sha256": "6e0cee6ed4fa8a7ed85bd9fba2146e00593eb9120fef7283e4f9bbe68599b3a4"
    },
    "dataList[id=71].content": {
      "pl": "<Sprawiedliwość? Autobus? O czym ty…>",
      "kr_sha256": "714585f61989a1bcde408585f2a87ea56474f960d8765be6d38537baf0517831",
      "en_sha256": "d5e5cec881a2d0441731174d14c32cba0c0d1ddf47d827809f6d12a0fe50fee0"
    },
    "dataList[id=72].content": {
      "pl": "Czy nie takiej odpowiedzi pan oczekiwał? Tak będzie panu spokojniej.",
      "kr_sha256": "982cd091c18c94f54430486c805bee7993ba33cc923510f9f56d42663a1cf313",
      "en_sha256": "aec0a1223f42627fe0eff042e270c92ba1202568aeb3eef849d22c04dc069c27"
    },
    "dataList[id=73].content": {
      "pl": "Czasu mało, a położenie mamy niekorzystne, więc wyjaśnię powoli, ale tylko raz.",
      "kr_sha256": "f067d575b780664f57d88dfec6b9491e64ee31fd8c238c79c2451a2bb2be1cb6",
      "en_sha256": "55cf92664d7a8dc2858f53994df8925aab42ee859cdce8edf9c2371961b25588"
    },
    "dataList[id=74].content": {
      "pl": "Jakiś czas później…",
      "kr_sha256": "8b895c352d3e50f1e6caf05ef1a22c52753efb9a9d0435ecc1185003cf978490",
      "en_sha256": "613b822e63449ffa36ba255f96ce7fbec38519ae193a328badae1f40c9b67a69"
    },
    "dataList[id=75].content": {
      "pl": "<Czyli… jeśli zrobię dokładnie to, co mówisz, ci zupełnie obcy ludzie będą walczyć za mnie?>",
      "kr_sha256": "2e0ebf98d63450268787fc3fb3f432d7b5688acb88f5457d284dd3db52a67ca5",
      "en_sha256": "9f7decd5321349c4284e89ec38584f6d585d6dad9a9801db7cfb208935714d8e"
    },
    "dataList[id=76].content": {
      "pl": "Zgadza się. O ile wyda im pan właściwe rozkazy.",
      "kr_sha256": "a9bc521c5501e4a6d9c46caad3ec32f380641987860b0b11e74b89f846273f27",
      "en_sha256": "fc2a506928f85f531d9427afccef0db4aa717cc8bdb3438b94590f87a6e9a90f"
    },
    "dataList[id=77].content": {
      "pl": "<Dobra. To wybijmy te cholerne gnoje…>",
      "kr_sha256": "f6c2851242a7acf70e692f8d97f0c70213f695ac1a42bbf435886ea94d38c788",
      "en_sha256": "2fff0383d7df7404c55c5d0ba7b621134b38fdc6c22e735043c988ea7e1bb90c"
    },
    "dataList[id=78].content": {
      "pl": "<i wrócę tam, gdzie byłem…>",
      "kr_sha256": "8e22d70ad3b5a939a0458bad9d0877c84b0911551fddfb3b19d6bf0692f4f77c",
      "en_sha256": "590f681936a0367902738d370280aa4659cb9b5837828a719fb486f50a4b3022"
    },
    "dataList[id=79].content": {
      "pl": "<Wrócę i…>",
      "kr_sha256": "31e019ded4d35cd454d07af66f8fd9050f8bf1c9eea37e01bd767372778f9ac9",
      "en_sha256": "95ddaedf39517f8f725e2a8eee47b97d41009131499e71267caf978809a8f1fa"
    },
    "dataList[id=7].content": {
      "pl": "Ha, ha, wygląda na to, że ten łeb nie ma nawet ust?",
      "kr_sha256": "17b74a8112298de5ba7166edfa5081099c396a401ecb88884553365f301285a7",
      "en_sha256": "33ba7d10dc06c85bcd454e96ef825562ef0d65684a04e76ae6ec6cd0af7d5bd0"
    },
    "dataList[id=80].content": {
      "pl": "<…>",
      "kr_sha256": "4259dcf0771baa1d2c535638170ab522bac0f0be503ad4259f3f0d20651a38ea",
      "en_sha256": "67edbf55a8ee9ed08fa013c521ca911941e46de6461565aeb03d4d8895d469ae"
    },
    "dataList[id=81].content": {
      "pl": "<Co ja właściwie robiłem? Gdzie w ogóle byłem?>",
      "kr_sha256": "e3ec94e2653ca970cf3424b5a56f64a4615d3c6434d398f6db72b490ded2368c",
      "en_sha256": "24063bf35ff37db599deddbd9825ba3620e0d295c2216700892b56bad0bf652e"
    },
    "dataList[id=82].content": {
      "pl": "<Stałem u progu niezwykle ważnej chwili. Czegoś, czego za nic nie wolno mi zapomnieć…>",
      "kr_sha256": "f5c8b22553e8152c1b24c6e1e3f64daee62ae3efb240ded14d164a1b18869fb1",
      "en_sha256": "c3b501b99a7dd40e3c1ec2d29b33386d1708be5578af5d71882bdc0ea8d408cc"
    },
    "dataList[id=83].content": {
      "pl": "Proszę się uspokoić. Z taką głową pamięć nie może być w całości.",
      "kr_sha256": "03a19c589bb64c317621f45b19208beb6382d22bcf0a1669e12c51bfd6f69614",
      "en_sha256": "c310fa1106cd5ba74933bc1e3569e9d07a6c908905dc3fdba469d2ed57b8cc3d"
    },
    "dataList[id=84].content": {
      "pl": "Teraz proszę się skupić na walce, która jest przed nami, Dante.",
      "kr_sha256": "caa58974d23267334dc554f5c5196e41a2efc9c2b6eb2e5f7eb26c9f421bfab3",
      "en_sha256": "e21623a84df712ed34b5c7ed1672f5dd30a502a2bd7a5ccdec3bb9fe9e868a2f"
    },
    "dataList[id=85].content": {
      "pl": "Zega… ekhm, nie wiem, jak należy się do pana zwracać.",
      "kr_sha256": "ca143e3a0f6ef081a7f9f1780de228f296c9f36fff16b11deffd58db521e9947",
      "en_sha256": "ef1ba7c34bc09e665e73d34cfcd057e0ccaf30185f65e9a54df27f67a5c0bcef"
    },
    "dataList[id=86].content": {
      "pl": "Panie Zegarowy Dowódco…? Tak czy inaczej, proszę wydać rozkaz do walki!",
      "kr_sha256": "cec7b74bfe5aaa10973c5f2c587b7459e5ebfe3c457de5bdfa4291aa324e4d3c",
      "en_sha256": "0d9f3c6b73428bdaf148fa8497ca6a16baf40bc2872602f736691a96a8692de9"
    },
    "dataList[id=87].content": {
      "pl": "Po co zaraz rozkazy? I tak każdy musi się bić na własną rękę, nie?",
      "kr_sha256": "0779ecad2ed227368016210360b3ab5eda59dda5f774f4b13bccbb6d393d4a1b",
      "en_sha256": "61badbc6871e5cb38e9617bcd4861d38c053b0fc90e1056b02243f1ccb9c6122"
    },
    "dataList[id=88].content": {
      "pl": "Ach?! Z-zaraz!",
      "kr_sha256": "27580fb6b7461e126a8c2df2926e12c152a279d7c8a2d656102e34715cfbbeec",
      "en_sha256": "ee8459fbf0e425a991053fd97374565f42ffac0d4bc45e379653eae7ba18488e"
    },
    "dataList[id=89].content": {
      "pl": "Co tak szepczecie?! Rozwalić wszystko i po sprawie!",
      "kr_sha256": "a9ce323ddb926e2decdab0367371bdcd59624ab96a0883b2be240f06d8114aa6",
      "en_sha256": "c3142beb68cefbb9267d712680d0c33e56df6134d5c9f2f5cadee398061c8322"
    },
    "dataList[id=8].content": {
      "pl": "No. Słychać tylko tykanie. Ciekawe, czy w środku chociaż wrzeszczy?",
      "kr_sha256": "5d18663c3937dbac496904fe56e98e7b28a665980c634e205c793749daf32c7b",
      "en_sha256": "eb3087e0c31fc2b6fdd47488fb0b10ccf35afb0f3ca4f64189193a9099de6c14"
    },
    "dataList[id=90].content": {
      "pl": "…Proszę dać z siebie wszystko, Dante.",
      "kr_sha256": "0e740631828e4b7c3b1b72827384d1a79e0592f447fadcd9433ff10c08dc82a5",
      "en_sha256": "dc2a6b9ecebb6d2860e89bc55844a8217fbc0beddfa01d9073dcc9975101d6d9"
    },
    "dataList[id=91].content": {
      "pl": "<…I tak nie mam innego wyjścia.>",
      "kr_sha256": "2ba57118309a4da2836f930c35d06bde08f9f73a48c7d6a272263df74afc5087",
      "en_sha256": "107bfb0dc0827dc581746cf5cb71b2935701c544071ad53cc814e6ff8f876d8f"
    },
    "dataList[id=9].content": {
      "pl": "<Aaagh…!>",
      "kr_sha256": "8341e07a712bde62e1dfbf68d7122b82a278b1152d8cf531d9269f346dc99b53",
      "en_sha256": "ce3f476a85a33193f60f4f3992946dec6405cc64f229c3720b1c64edab39228d"
    }
  }
}
