{
  "entries": {
    "dataList[id=0].content": {
      "pl": "ŁUP!",
      "kr_sha256": "aad32bec55edb0fafd1d66fffbbe3b2282c6990340431e008f580ecba304c09c",
      "en_sha256": "d084e7679c41bdf49393425ebcb0f84a32485bc8b084128e15717e6a45621c43"
    },
    "dataList[id=10].content": {
      "pl": "Tak, bez wątpienia wstaje.",
      "kr_sha256": "e0ff065f7e1063144a34b48dde36ccc752cbbd0687a0f195490164ffcd31c5f9",
      "en_sha256": "a011015077fe69260f81b33f4bef1f6386e936d2df8a12abfeaecb50b8bcf140"
    },
    "dataList[id=11].content": {
      "pl": "Nie oglądajcie się! Biegiem!",
      "kr_sha256": "8835b5c41fa6902a3a05e3361d9203e75a6272c676075e8d6768b7ed205c81f9",
      "en_sha256": "85f0cb53a73146c4838f11f1984d9e7846fdb11e785eeb221abe89bb8edbc650"
    },
    "dataList[id=12].content": {
      "pl": "<Hhh… hhh… No, biegliśmy, ile sił w nogach, ale…>",
      "kr_sha256": "c2ec98ed6044a593e8b58fff400cf3bed504ceaab52c17f4ecf62bda84fe836a",
      "en_sha256": "1a25a050a9d4c24d31d7950455175f8a1c28d3f868bac982dd15ce795fae2b6a"
    },
    "dataList[id=13].content": {
      "pl": "Kroki. Nie ludzkie. Ciężkie, ociężałe.",
      "kr_sha256": "16248c27385c918ac38b732d30fdc05eb07e11f2fbc5a08c0c17d2a958fb25e1",
      "en_sha256": "47116b68e8246977993650430a90bca2306e5e847b92e0cab9fb566e9ec5b149"
    },
    "dataList[id=14].content": {
      "pl": "…Wystarczy powiedzieć, że goni nas coś ogromnego!",
      "kr_sha256": "15f6f573d41e9c7e3898ebea8f96addf9e1c145a6f42c81928b2f0281ee4b256",
      "en_sha256": "c8641dd5fe5efdf6fa15fb8cc9fbd821fef128b81dba4aa35118c756a9afa628"
    },
    "dataList[id=15].content": {
      "pl": "Być może tak byłoby lepiej.",
      "kr_sha256": "656e6db68e722a2a6e34cf53f66069e7ffff0a113c9c5cfce0ec30749def94fc",
      "en_sha256": "5044845d2acebf1b90e65974a34fb9cc43912e3e276e56d2ce038a95559251eb"
    },
    "dataList[id=16].content": {
      "pl": "D-Dante! Jakoś to załatwiliśmy, to zmywajmy się stąd! Co?",
      "kr_sha256": "8521880e1d8ca5736794acf62327b0aa84fced44cce5346e517fe7c397e0ecfa",
      "en_sha256": "7748d5e4f581843c970c3aa1f073f2ca7fa63bd0203ad3d113cb58d48904a217"
    },
    "dataList[id=17].content": {
      "pl": "<Z-zaraz! Myślałem tylko o tym, żeby zejść na dół, a co potem…>",
      "kr_sha256": "f47add426b0b399a1862c6df84f9b1fc9e26c4e720ddaaf36254f9109ef6d43a",
      "en_sha256": "50854d34d4258ca325209f283222c742495144c8106038bd8dcd1591ce33d920"
    },
    "dataList[id=18].content": {
      "pl": "Ach, no weź! To teraz jest problem?!",
      "kr_sha256": "e1b54fa5d500f8b024e740c40abfc68107e60a2aee52ddccca4d7703121d5a1a",
      "en_sha256": "8cae0b6febcfbc68db5681d5789531017c4d74df4a547fb1fc9c9d1f3627edfc"
    },
    "dataList[id=19].content": {
      "pl": "Autobus… gdzie jest autobus?",
      "kr_sha256": "6ae8a4533b4024f638ad4330f6303e272c14b1b2539b167db4b0331791791b12",
      "en_sha256": "759be6cd3f5e93d0c5dbac6d4cb0a868eec1b53eb3daef84b35d3c13fb8e0da1"
    },
    "dataList[id=1].content": {
      "pl": "<Co…>",
      "kr_sha256": "9469481ba0593548e8532610706f5bfd01324fabf19f9f32c55ef27cb9f559a3",
      "en_sha256": "0fc830f5779f116ef01a283b14a601afe64d9eb3283237a1a6e8b697b44caeda"
    },
    "dataList[id=20].content": {
      "pl": "Przestańcie pleść bzdury! Na razie biegiem w drugą stronę!",
      "kr_sha256": "e4370c993751a7d8fe40e23ea0cb53d318287995093997f36f63a936aff85fd3",
      "en_sha256": "853605d9ca53133f9355ba767a10e4d65e4de2b3c491f81939e8ba0095def08a"
    },
    "dataList[id=21].content": {
      "pl": "Zdaje się, że po raz pierwszy słyszę od pana coś logicznego, Heathcliff.",
      "kr_sha256": "9a85ee58abc849c166c794fb3262278a72a8e9d35b31f34a9c966db5c3e4f411",
      "en_sha256": "d82bb341554e442cab437b869281205cbc0b25acdfa678257d6930c65c91e43d"
    },
    "dataList[id=22].content": {
      "pl": "…Tobie później rozwalę łeb.",
      "kr_sha256": "4f96550d636f5f93d2a31fa2801ab71625994e4f638dfe96315b8b4360b38871",
      "en_sha256": "f5a40bdd38468c3fd22bef67a4c4fe958458b6a344d9386397b948541dad087a"
    },
    "dataList[id=2].content": {
      "pl": "Zamek zatrząsł się gwałtownie i zewsząd zaczął sypać się gruz.",
      "kr_sha256": "e62c1bbac47763adddab71eb05a5f06255f96e5147ffc0c24fb5d1b473afe93b",
      "en_sha256": "3db8dfab04ba756ed62fbcfc6435311d55325e7a647bdb9c5cc23413bb5dc9e6"
    },
    "dataList[id=3].content": {
      "pl": "<J-jeśli tak dalej pójdzie…>",
      "kr_sha256": "09a49b975e0aaf1deafa7af6b48dbe47eeda6bf946bfaaf30eae165f0863dfdd",
      "en_sha256": "31e3e9c411f631b4f23c50e840b3af867e7df7bd896811877b6aaea4ebe59c9a"
    },
    "dataList[id=4].content": {
      "pl": "Przez głowę przemyka mi złowieszcza myśl.",
      "kr_sha256": "0c17f65437d654679363d9c88e7f68139deb5b3575cd78a538ae7b30a5f843b5",
      "en_sha256": "b05682a754d525ad4da41de501e186cefa20aeb67b7e127b6a6d03a6c7ca28c3"
    },
    "dataList[id=5].content": {
      "pl": "Tykanie brzmiało tak, jakby odliczało nam pozostały czas.",
      "kr_sha256": "1d43873829b9e54b752f008adb871217bdc9bdd2966b278d68834c736d102be0",
      "en_sha256": "899368719db2be4103b1ee26b99ee16c2010932153503c85c9533ef822ebebd8"
    },
    "dataList[id=6].content": {
      "pl": "<W… wszyscy uciekać!>",
      "kr_sha256": "2e6a58526d9b3e42f1215970135da68303f84ce22d3a8fcda31024cd4ad87783",
      "en_sha256": "7f3c79bf844e8a26e94bd2893c059481aab727421322aba6522bc7a0f53cdcd1"
    },
    "dataList[id=7].content": {
      "pl": "W pośpiechu wydostaliśmy się z zamku.",
      "kr_sha256": "991233fc368a7b5618a4349713fe5a018a988b7c595be8ef11e295d20625249a",
      "en_sha256": "b6afe9545fdd9f720ed376ecbe7f8dc27ab9754bb41389500cb0758ef6d67351"
    },
    "dataList[id=8].content": {
      "pl": "…Chyba nie mam przywidzeń?",
      "kr_sha256": "e98cda85e09d023a67eeb5c394a24c00f563c5dc1b173026ed5a43ac5e91f5eb",
      "en_sha256": "12c04c0b4bc2e09c7b3e2be24162510e59a2a92cae0ab798c5cbe92dffe1b6c1"
    },
    "dataList[id=9].content": {
      "pl": "Ten zamek się nie wali, tylko jakby…",
      "kr_sha256": "7e5ec000cc4a3a627b5fde750e9ed6b4d5fe3a6edff5157c839179a9f257843c",
      "en_sha256": "750ed505ff38c6213a0365dab8398fb7fa14c646d992e6b09caeb094456fa08d"
    }
  }
}
