    },
    "dataList[id=CHAPTER_102].desc": {
      "pl": "Ktoś zagarnął Złotą Gałąź.\nPrzewodnik znów podał mi westchnienie i szansę.\nZ nadzieją, że tym razem się uda,\nruszyłem w świat uciech i lodu.",
      "kr_sha256": "e58156251157b5a480d8a0bf47e2ba98b087fa7b03107297d6049503c662cb99",
      "en_sha256": "c35035442f72b8c75f26210914cc9814a56860e130630c86f44a0c59322d49f8"
